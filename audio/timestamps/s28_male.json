{"sid": "s28", "voice": "male", "total_duration": 60.13, "segments": [{"para": 0, "start": 0.0, "duration": 1.46, "text": "临水夫人宝诰"}, {"para": 1, "start": 1.46, "duration": 1.31, "text": "志心皈命礼。"}, {"para": 2, "start": 2.77, "duration": 2.48, "text": "八閩毓秀，大士化身。"}, {"para": 3, "start": 5.25, "duration": 2.9, "text": "少悟玄极，顶礼慈航宝相；"}, {"para": 4, "start": 8.15, "duration": 2.66, "text": "长成道果，拜参法主朱门。"}, {"para": 5, "start": 10.81, "duration": 2.66, "text": "龙角轻吹，声彻九天响应；"}, {"para": 6, "start": 13.48, "duration": 2.53, "text": "风旗高展，威传十地安宁。"}, {"para": 7, "start": 16.01, "duration": 2.98, "text": "锁蛇怪于坛中，群妖扫荡；"}, {"para": 8, "start": 18.99, "duration": 2.85, "text": "保童婴于闈中，众妇蒙恩。"}, {"para": 9, "start": 21.84, "duration": 4.21, "text": "法转玄功，炼度三十六宫毓麟婆者；"}, {"para": 10, "start": 26.04, "duration": 3.63, "text": "丹生白骨，超拔七十二苑解疫女神。"}, {"para": 11, "start": 29.67, "duration": 2.66, "text": "合三奶以同心，功存社稷；"}, {"para": 12, "start": 32.34, "duration": 2.53, "text": "会九淑而崇道，泽注尘环。"}, {"para": 13, "start": 34.87, "duration": 2.61, "text": "护法随传，召遣王杨太保；"}, {"para": 14, "start": 37.48, "duration": 2.61, "text": "灵心默化，度收大圣丹霞。"}, {"para": 15, "start": 40.1, "duration": 2.98, "text": "救世拯民，祈甘露于左海；"}, {"para": 16, "start": 43.07, "duration": 2.85, "text": "勤王护国，除巨恶于三山。"}, {"para": 17, "start": 45.92, "duration": 2.66, "text": "懿德高超，玉诏荣封圣母；"}, {"para": 18, "start": 48.59, "duration": 3.03, "text": "慈云广覆，金炉拜参元君。"}, {"para": 19, "start": 51.62, "duration": 2.56, "text": "大悲大愿，大圣大慈。"}, {"para": 20, "start": 54.18, "duration": 5.96, "text": "顺天圣母，临水清宁，普化碧霞太后，保童注生，昭惠崇福救世元君。"}]}