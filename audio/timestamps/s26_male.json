{"sid": "s26", "voice": "male", "total_duration": 188.55, "segments": [{"para": 0, "start": 0.0, "duration": 3.55, "text": "太上老君说常清静经"}, {"para": 1, "start": 3.55, "duration": 1.36, "text": "老君曰："}, {"para": 2, "start": 4.91, "duration": 2.56, "text": "大道无形，生育天地；"}, {"para": 3, "start": 7.47, "duration": 3.19, "text": "大道无情，运行日月；"}, {"para": 4, "start": 10.66, "duration": 1.7, "text": "大道无名，长养万物；"}, {"para": 5, "start": 12.36, "duration": 4.52, "text": "吾不知其名，强名曰道。"}, {"para": 6, "start": 16.87, "duration": 0.94, "text": "夫道者："}, {"para": 7, "start": 17.81, "duration": 2.25, "text": "有清有浊，有动有静；"}, {"para": 8, "start": 20.06, "duration": 2.53, "text": "天清地浊，天动地静；"}, {"para": 9, "start": 22.6, "duration": 2.53, "text": "男清女浊，男动女静；"}, {"para": 10, "start": 25.13, "duration": 2.56, "text": "降本流末，而生万物。"}, {"para": 11, "start": 27.69, "duration": 1.83, "text": "清者，浊之源，"}, {"para": 12, "start": 29.52, "duration": 2.12, "text": "动者，静之基；"}, {"para": 13, "start": 31.63, "duration": 2.95, "text": "人能常清静，天地悉皆归。"}, {"para": 14, "start": 34.59, "duration": 2.56, "text": "夫人神好清，而心扰之；"}, {"para": 15, "start": 37.14, "duration": 2.48, "text": "人心好静，而欲牵之。"}, {"para": 16, "start": 39.63, "duration": 2.61, "text": "常能遣其欲，而心自静；"}, {"para": 17, "start": 42.24, "duration": 3.63, "text": "澄其心，而神自清；自然六欲不生，"}, {"para": 18, "start": 45.87, "duration": 3.63, "text": "三毒消灭。所以不能者，爲心未澄，"}, {"para": 19, "start": 49.5, "duration": 2.56, "text": "欲未遣也；能遣之者："}, {"para": 20, "start": 52.06, "duration": 3.03, "text": "内观其心，心无其心；"}, {"para": 21, "start": 55.09, "duration": 2.12, "text": "外观其形，形无其形；"}, {"para": 22, "start": 57.21, "duration": 2.38, "text": "远观其物，物无其物；"}, {"para": 23, "start": 59.58, "duration": 2.77, "text": "三者既悟，唯见于空。"}, {"para": 24, "start": 62.35, "duration": 2.53, "text": "观空亦空，空无所空；"}, {"para": 25, "start": 64.89, "duration": 2.79, "text": "所空既无，无无亦无；"}, {"para": 26, "start": 67.68, "duration": 2.9, "text": "无无既无，湛然常寂。"}, {"para": 27, "start": 70.58, "duration": 2.48, "text": "寂无所寂，欲岂能生；"}, {"para": 28, "start": 73.06, "duration": 1.96, "text": "欲既不生，即是真静。"}, {"para": 29, "start": 75.02, "duration": 2.85, "text": "真常应物，真常得性；"}, {"para": 30, "start": 77.87, "duration": 2.72, "text": "常应常静，常清静矣。"}, {"para": 31, "start": 80.59, "duration": 2.25, "text": "如此清静，渐入真道；"}, {"para": 32, "start": 82.83, "duration": 2.14, "text": "既入真道，名爲得道；"}, {"para": 33, "start": 84.97, "duration": 2.77, "text": "虽名得道，实无所得；"}, {"para": 34, "start": 87.74, "duration": 2.38, "text": "爲化众生，名爲得道；"}, {"para": 35, "start": 90.12, "duration": 2.56, "text": "能悟之者，可传圣道。"}, {"para": 36, "start": 92.68, "duration": 1.04, "text": "老君曰："}, {"para": 37, "start": 93.72, "duration": 2.61, "text": "上士无争，下士好争；"}, {"para": 38, "start": 96.34, "duration": 2.14, "text": "上德不德，下德执德；"}, {"para": 39, "start": 98.48, "duration": 2.25, "text": "执著之者，不名道德。"}, {"para": 40, "start": 100.72, "duration": 2.01, "text": "众生所以不得真道者，"}, {"para": 41, "start": 102.74, "duration": 2.77, "text": "爲有妄心；既有妄心，"}, {"para": 42, "start": 105.5, "duration": 2.95, "text": "即惊其神；既惊其神，"}, {"para": 43, "start": 108.46, "duration": 1.96, "text": "即著万物；既著万物，"}, {"para": 44, "start": 110.42, "duration": 3.32, "text": "即生贪求；既生贪求，"}, {"para": 45, "start": 113.73, "duration": 2.56, "text": "即是烦恼；烦恼妄想，"}, {"para": 46, "start": 116.29, "duration": 2.3, "text": "忧苦身心；便遭浊辱，"}, {"para": 47, "start": 118.59, "duration": 2.25, "text": "流浪生死；常沉苦海，"}, {"para": 48, "start": 120.84, "duration": 3.03, "text": "永失真道。真常之道，"}, {"para": 49, "start": 123.87, "duration": 2.56, "text": "悟者自得；得悟道者，"}, {"para": 50, "start": 126.43, "duration": 1.54, "text": "常清静矣！"}, {"para": 51, "start": 127.97, "duration": 1.36, "text": "仙人葛翁曰："}, {"para": 52, "start": 129.33, "duration": 3.13, "text": "吾得真道，曾诵此经万遍。"}, {"para": 53, "start": 132.46, "duration": 2.98, "text": "此经是天人所习，不传下士。"}, {"para": 54, "start": 135.44, "duration": 4.44, "text": "吾昔受之于东华帝君，东华帝君受之于金阙帝君，"}, {"para": 55, "start": 139.88, "duration": 4.21, "text": "金阙帝君受之于西王母。西王母皆口口相传，"}, {"para": 56, "start": 144.09, "duration": 3.81, "text": "不记文字。吾今于世，书而录之。"}, {"para": 57, "start": 147.9, "duration": 4.21, "text": "上士悟之，升爲天仙；中士修之，南宫列仙；"}, {"para": 58, "start": 152.11, "duration": 5.36, "text": "下士得之，在世长年。游行三界，升入金门。"}, {"para": 59, "start": 157.46, "duration": 1.88, "text": "左玄真人曰："}, {"para": 60, "start": 159.34, "duration": 5.3, "text": "学道之士，持诵此经者，即得十天善神，擁护其身。"}, {"para": 61, "start": 164.64, "duration": 4.57, "text": "然后玉符保神，金液炼形。形神俱妙，与道合真。"}, {"para": 62, "start": 169.22, "duration": 1.23, "text": "正一真人曰："}, {"para": 63, "start": 170.44, "duration": 1.59, "text": "人家有此经，"}, {"para": 64, "start": 172.04, "duration": 2.12, "text": "悟解之者，灾障不干，"}, {"para": 65, "start": 174.15, "duration": 2.77, "text": "众圣护门。神升上界，"}, {"para": 66, "start": 176.92, "duration": 3.81, "text": "朝拜高真。功满德就，"}, {"para": 67, "start": 180.74, "duration": 2.66, "text": "相感帝君。诵持不退，"}, {"para": 68, "start": 183.4, "duration": 1.59, "text": "身腾紫云。"}, {"para": 69, "start": 184.99, "duration": 3.55, "text": "太上老君说常清静经卷终"}]}