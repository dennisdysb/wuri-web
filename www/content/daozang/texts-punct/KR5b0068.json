   "paras": [
    "太上虚皇保生神呪經",
    "太上虚皇，",
    "開散玉庭。",
    "金房晃曜，",
    "翠臺鬱青。",
    "我設三道，",
    "滅鬼生靈。",
    "我能無死，",
    "亦能無生。",
    "長生自在，",
    "迴老返嬰。",
    "䰟𩲸受鍊，",
    "五神安寧。",
    "迴飈車輪，",
    "北謁玉清。",
    "升入太無，",
    "與日合明。",
    "遂成眞人，",
    "五帝合并。",
    "三元所告，",
    "萬神咸聽。",
    "洞玄三昧，",
    "無量眞靈。",
    "羣仙侍衛，",
    "名列玉清。",
    "洞眞玉虚，",
    "無中之無。",
    "道中之道，",
    "神化須㬰。",
    "洞神靈應，",
    "法象有爲。",
    "驅邪滅惡，",
    "運轉璇璣。",
    "東方保生，",
    "青童神靈。",
    "正一守䰟，",
    "克保昌齡。",
    "南方保生，",
    "固氣赤靈。",
    "萬神無越，",
    "使我長寧。",
    "西方保生，",
    "侍𩲸白靈。",
    "辟除妖氣，",
    "令我利亨。",
    "北方保生，",
    "通利元精。",
    "五氣眞符，",
    "使臣長榮。",
    "中央保生，",
    "主我身形。",
    "飛行自在，",
    "天地齊并。",
    "遊觀太虚，",
    "上朝玉京。",
    "下祛妖魅，",
    "福恵羣生。",
    "太上虛皇保生神呪經"
   ]
  }
 ]
