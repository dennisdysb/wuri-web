   "paras": [
    "上清金章十二篇",
    "宴盻太霞宫，",
    "金闕曜紫清。",
    "仙房宴太素，",
    "四軒皆朱瓊。",
    "擲輪空洞律，",
    "控轡舞縁軿。",
    "玉華飛雲盖，",
    "四妃運錦旌。",
    "翻然塵濁外，",
    "鯈歘佳人庭。",
    "宿感應期来，",
    "所得已在冥。",
    "乗風想九霄，",
    "共酣丹華安。",
    "顧謝世中物，",
    "安知無中靈。",
    "北登玄𡨋闕，",
    "𢹂手經髙羅。",
    "香烟散八景，",
    "玄風鼓絳波。",
    "仰超琅琅津，",
    "俯眄曲嶽阿。",
    "嘯歌雲上唱，",
    "鳳鳴九洞霞。",
    "乗炁浮太空，",
    "曷為躡山阿。",
    "金節命羽靈，",
    "徴兵摧萬魔。",
    "漱汲圎晨暉，",
    "積春方嬰牙。",
    "紛紛趣競中，",
    "不觧可柰何。",
    "北龍欝霄藹，",
    "絳𣗳結紫華。",
    "青蘂落鳳林，",
    "碧㮏秀巖阿。",
    "靈閣陵太霞，",
    "瓊房參太霞。",
    "雲興曲室内，",
    "八風飛𡨋沙。",
    "九彌弹帝墉，",
    "龍嘯唱節和。",
    "扇飊五嶽嶺，",
    "握節徴萬。",
    "顧盻須㬰頃，",
    "忽然椿已過。",
    "哀㢤朝生者，",
    "安和齡紀多。",
    "隅景希宫運，",
    "軸冲漠幽至。",
    "觀映六庭，",
    "大小盡逍遥。",
    "龍吹纒盖雲，",
    "虎吟駭萬條。",
    "三素啓髙圖，",
    "丹霞蔚晨霄。",
    "羽旂横靈津，",
    "紫軿飛華翹。",
    "控轡九天外，",
    "俯仰自寥寥。",
    "塵誅結囂穢，",
    "神䘮炁亦凋。",
    "奚不尋逺御，",
    "八千乃一朝。",
    "朝濟碧海波，",
    "飛輪辭縁房。",
    "髙唱儔友篇，",
    "盖越滄浪中。",
    "三契玉霄賔，",
    "五期東華童。",
    "羽飊昇帝晨，",
    "宴此廣寒宫。",
    "八音虚中弹，",
    "紫鳳唱靈風。",
    "絳霞遏明曜，",
    "八景飛太空。",
    "咀嚼瓊泉津，",
    "浩秀還嬰蒙。",
    "至樂歸五神，",
    "年積刼刃崇。",
    "脫屣將何難，",
    "勞憂䘮天冲。",
    "朝駕晨景暉，",
    "逸轡發紫清。",
    "浮雲騁太霞，",
    "揚盖廣寒庭。",
    "髙真禁帝室，",
    "宫墉引西靈。",
    "十絶五空洞，",
    "飛烟繞錦屏。",
    "虎扇神風慶，",
    "紫雲迴龍軿。",
    "倐歘窮八方，",
    "一顧椿已頃。",
    "簫遥玄競子，",
    "奚不㝷太生。",
    "神圃秀𨼆芝，",
    "昆池灌眄田。",
    "仰觀玉清闕，",
    "嵳峩臨絳津。",
    "紫霞映曲席，",
    "五雲曜九玄。",
    "八風起絶宇，",
    "幽藹縁軒間。",
    "三元舎西宫，",
    "東華有隹人。",
    "北𡨋唱七嘯，",
    "明姬歌南真。",
    "撫璈參朱津，",
    "玉節揚六絃。",
    "合契安非運，",
    "俱嚮廣鳳巔。",
    "同期命萬魔，",
    "宅此群黒千。",
    "超然来何難，",
    "乃啓不窮年。",
    "駕炁眄空洞，",
    "乗景愬九天。",
    "動欝廣暉羽，",
    "玄盖生旡間。",
    "八烟飊寥輪，",
    "軌滯不許年。",
    "撫璈八空響，",
    "我馬亦無津。",
    "握節入東華，",
    "夕宴玄圃巔。",
    "束帶携五靈，",
    "觧衿翹良人。",
    "𡨋感自適運，",
    "汎然亦有縁。",
    "俱載陵厲翮，",
    "一扇動億千。",
    "降景浮玄景，",
    "紫軒乗雲征。",
    "仰超金闕内，",
    "俯眄西華成。",
    "東華啓五暉，",
    "神光煥七靈。",
    "翳映三汜燭，",
    "流任自齊𡨋。",
    "風鼓空洞宇，",
    "香烟散玉庭。",
    "手𢹂織女儛，",
    "雙衿落錦青。",
    "元徊交羽旗，",
    "華盖随雲傾。",
    "宴寝九度外，",
    "是非不我營。",
    "抱空汍丸内，",
    "天姿愈日嬰。",
    "豈況洞愆穢，",
    "中惨無𦕅生。",
    "扶桑翠空峯，",
    "朱雲葩㣲明。",
    "浪䑓宥虚上，",
    "四觀映髙清。",
    "飛景控紫輪，",
    "三素轡丹軿。",
    "寢偃太帝舘，",
    "崚𡾓何母庭。",
    "濯足碧瀬波，",
    "提契玉醴甖。",
    "曲晨乗風扇，",
    "飄飄時下傾。",
    "暫適地藹中，",
    "廻駕汜良真。",
    "玄㑹自相要，",
    "流浪任幽𡨋。",
    "始知榮辱幸，",
    "方悟憂促齡。",
    "曲室可清靜，",
    "願神待日成。",
    "何為講當𡍼，",
    "百痾從是生。",
    "天庭生金華，",
    "内以彰隂邪。",
    "玉谷參玄卿，",
    "瓊炁互扶羅。",
    "天真立遐日，",
    "飛蘂吐靈沙。",
    "清晨案天馬，",
    "廻駕神玄家。",
    "仙人来入室，",
    "又以㓕百邪。",
    "道以齋為先，",
    "勤行登金闕。",
    "故設大法橋，",
    "普度諸人物。",
    "宿世恩徳報，",
    "道心超然發。",
    "六齋禮空洞，",
    "十直神感徹。",
    "五老刋仙名，",
    "雲輿相迎謁。",
    "身飛昇玄都，",
    "七祖咸觧脫。",
    "上清金章(終)"
   ]
  }
 ]
}