 "volumes": [
  {
   "h": "第一篇",
   "paras": [
    "太上洞淵三昧神呪齋十方懴儀",
    "廣成先生杜光庭刪定",
    "東方",
    "臣等謹爲齋主某甲等修建洞淵三昧神呪大齋，行道禮懴，救禳災疾，却禍祈恩。伏願太上垂慈，諸天愍育，勑下十方主者、大梵天王、殺鬼吏兵、法災力士，齊臨法席，俱到道場，爲齋主收逐魔精，驅斥鬼祟，勾盈子等徒侣所行衆災，速賜剪除，匡持齋主，百病除愈，千殃蕩消，増續年齡，超騰禄位，九玄昇度，七祖逍遥，合宅安貞，良賤康泰。得如所願，仰荷玄恩。",
    "呪曰：",
    "東方蒼老君，",
    "號曰勾芒靈，",
    "梵汝遊太空，",
    "蒼蒼拂玉京，",
    "大乗緫三天，",
    "衆眞統魔兵，",
    "八音徧十地，",
    "九龍雲輿迎，",
    "建齋立大功，",
    "長夜自光明，",
    "正道法皷振，",
    "百邪悉摧傾，",
    "魔王來稽首，",
    "敢試滅其形，",
    "善神擁門户，",
    "力士交萬靈，",
    "道氣廣流布，",
    "家親咸安寧，",
    "疫毒皆消盡，",
    "萬民悉長生，",
    "相與弘至道，",
    "俱遊紫鳯城。",
    "南方",
    "臣等謹爲齋主某甲等修建洞淵三昧神呪大齋，行道禮懴，救治災疾，請福祈恩。特願大聖弘慈，衆眞垂祐，遣天丁力士、赤殺天兵，收逐魔瘟，滅却焦氏九子等衆所行災疾，一切凶殃並願攝毒收精，各還方位，當使齋主等疾患痊愈，魂魄清安，算壽増延，禄位超進，先亡往逝，免脫幽途，合宅安康，良賤貞吉。得如所願，仰荷玄恩。",
    "呪曰：",
    "南方炎帝君，",
    "八表號閻浮，",
    "飛軒駕雲輿，",
    "十直三天遊，",
    "玉女乗霄唱，",
    "金光溢丹丘，",
    "今日轉法輪，",
    "梵響振九嵎，",
    "天魔勑魔兵，",
    "風舉自然休，",
    "晃晃三光暉，",
    "百邪殁九幽，",
    "敢有干試者，",
    "力士斬其頭，",
    "諸天帝王子，",
    "殺鬼氣不流，",
    "故有强梁者，",
    "灌湯煑其軀，",
    "千千悉斬首，",
    "萬萬不得留，",
    "興齋攝魔精，",
    "魍魉次次收，",
    "大道威嚴重，",
    "神風拂邪妖，",
    "鬼疫旣消盡，",
    "萬民無災憂。",
    "西方",
    "臣等謹爲齋主某甲等修建洞淵三昧神呪大齋，行道禮懴，救疾消厄，滅禍除凶。伏惟五帝神尊、少隂衆聖，垂慈巨澤，哀鑒懇祈，願遣九天大兵、赤殺力士，收除信陵、赤烏、魍魉、生死之神、塚墓之鬼、烏奴留子等徒，並乞截斷凶殃，辟除瘟瘴，降下靈液，灌注三田，四大輕强，更増年算，禄位遷永，速赴台衡，先亡祖曽，俱超靜域。得如所願，仰荷玄恩。",
    "呪曰：",
    "西方蓐收神，",
    "號曰爲勾尼，",
    "三光玄太虚，",
    "朗朗超四維，",
    "八音三十二，",
    "百邪氣自摧，",
    "今日建福田，",
    "神呪破鬼儕，",
    "然燈光逺照，",
    "長夜朗然開，",
    "風止雨亦休，",
    "斬妖束奸非，",
    "敢有干逆鬼，",
    "縳送地獄畿，",
    "金刀縱横截，",
    "鐵杖歷亂槌，",
    "行道除百惡，",
    "燒香滅千災，",
    "道士心精專，",
    "積善起死骸，",
    "萬邪畏眞正，",
    "伏恩無敢違，",
    "奉師尊大道，",
    "道氣自來歸，",
    "愚人不能學，",
    "智者常依依，",
    "不惜財貨身，",
    "貴教乗空飛。",
    "北方",
    "巨等謹爲齋主某甲等修建洞淵三昧神呪大齋，轉經行道，救治災疾，請福祛魔。伏願五氣神君、北方眞聖，勑下勒宋文昌等衆、風雨將軍、四天大王，齊心併力，收除青眞大魔、弗旦連子、門户井竈之鬼、丞伯阿倫、丁寧子都等爲崇之神，一切消除，清蕩内外，使齋主等疾患痊復，四大輕强，安定精神，増延福壽，先亡滯魄，各獲清昇，合宅咸康，吉無不利。得如所願，仰荷玄恩。",
    "呪曰：",
    "北方鬱單境，",
    "帝神曰玄冥，",
    "落落四運開，",
    "昭昭五氣明，",
    "豁豁邪穢除，",
    "蕩蕩天地清，",
    "太上威嚴切，",
    "凶鬼死不生，",
    "敢有違逆者，",
    "收之付天丁，",
    "千千皆截首，",
    "萬萬悉斬形，",
    "閻羅剪邪妖，",
    "北斗滅魔精，",
    "神風掃不祥，",
    "萬惡不敢停，",
    "上聖惠澤流，",
    "萬物普咸榮。",
    "中央",
    "臣等謹爲齋主某甲等修建洞淵三昧神呪大齋，行道禮懴，救治災疾，驅斥魔瘟。願勑十方天下三十六天力士，覆護齋主，滅祟消凶，收除客死雲中李子敖凶殃之鬼、六畜人形、五木百媚、蠻夷戎老羌虜、山上水中火内射公萬種等鬼，一切消滅。當願齋主千罪萬咎，悉乞赦除，厄患潜消，衰危過免，千齡保祚，禄位遷升，七祖九玄，咸登妙果。得如所願，仰荷玄恩。",
    "呪曰：",
    "中央戊己神，",
    "黃帝統萬機，",
    "三秦緫八方，",
    "勾陳耀天暉，",
    "天輝光照灼，",
    "豁然幽夜開，",
    "至道恩慈普，",
    "萬兆悉歸依，",
    "今日建大齋，",
    "萬惡不敢希，",
    "風停不動條，",
    "福徳髙巍巍，",
    "鬼疫敢不忌，",
    "億億斬無遺，",
    "百姓遭疾苦，",
    "若請神呪齋，",
    "病者即蒙差，",
    "鬼氣自崩摧，",
    "諸天攝魔靈，",
    "衆眞斬邪非，",
    "太上金口𠡠，",
    "不從死怨誰，",
    "若䏻伏道教，",
    "止惡勿行非。",
    "東北方",
    "臣等謹爲齋主某甲等修建洞淵三昧神呪大齋，轉經行道，救禳災疾，請福祈恩。願遣五方靈童，收斬五精七吹、賈元黄奴兄弟所行萬病、一切災殃，願攝鬼兵，驅除崇害，冀得疾患痊愈，體徤身康，更續年齡，遷騰禄位，闔門受慶，良賤蒙安，七祖清昇，九玄解脫。得如所願，仰荷玄恩。",
    "呪曰：",
    "東北艮之子，",
    "其神御隂節，",
    "奉承太上教，",
    "善惡令分别，",
    "邪訛不干眞，",
    "犯者宜誅殺，",
    "上聖䕶生民，",
    "侵者加大罰，",
    "洞淵理清肅，",
    "三昧法嚴切，",
    "神呪滅邪魔，",
    "邪魔並消滅，",
    "除凶凶即止，",
    "斬鬼鬼即絶，",
    "神兵闔天下，",
    "靈風掃地發，",
    "百福千方起，",
    "千災九隂没，",
    "公私無障惱，",
    "存亡蒙濟㧞。",
    "東南方",
    "臣等謹爲齋主某甲等修建洞淵三昧神呪大齋，行道禮懴。願遣赤卒小吏、太上眞騎，收除百龍王翦等所行災疾，驅遣下兵，俱蒙斷截，使齋主渚蕩六府，流潤百關，疾患蠲除，衰厄殄滅，保安禄位，增續年齡，㧞度幽魂，匡持見在。得如所願，仰荷玄恩。",
    "呪曰：",
    "東南巽之神，",
    "地户張網羅，",
    "網羅布天下，",
    "百鬼不得過，",
    "五嶽爲安靜，",
    "四海不騰波，",
    "萬邪不敢動，",
    "禁勑一切魔，",
    "魔鬼敢逆近，",
    "斬之付陁羅，",
    "頭破數千片，",
    "身形悉滅磨，",
    "䕶救生民苦，",
    "災厄自免過，",
    "三官伏威令，",
    "依如女青科。",
    "西南方",
    "臣等謹爲齋主某甲等修建洞淵三昧神呪大齋，解禳災疾，行道禮懴。願遣九天主者、三元力士，主收天下祟害妖𦍙、山林水火風土大鬼、憂連文慶子等徒，乞斥去千里，逺出他方，原赦齋主過徃之愆，蠲除見在諸疾，使魂清氣爽，厄運蕩消，四大康和，六府通潤，鬼氣蕩滌，魔精殄除，福夀增饒，禄位遐永。得如所願，仰荷玄恩。",
    "呪曰：",
    "西南坤之母，",
    "神制收邪精，",
    "禁止天地鬼，",
    "瘟毒不得行，",
    "若有不從者，",
    "金刀斬汝形，",
    "今日建大齋，",
    "㧞死而理生，",
    "三光一流照，",
    "九幽並開明，",
    "明朗徧十方，",
    "百鬼無藏形，",
    "故爲病不止，",
    "收之付七星，",
    "神風掃凶邪，",
    "邪惡自然平，",
    "老君明㫖教，",
    "急急如律令。",
    "西北方",
    "臣等謹爲齋主某甲等修建洞淵三昧神呪大齋，行道禮懴，思神念眞，祈恩請福。願遣健兵力士，驅除王鳯、白起所領災凶，應時殄滅，不得容恕，當使齋主神安魄定，靈藥灌心，疾患日痊，算壽增續，禄位惟永，早列台階，七祖九玄，俱登妙樂。得如所願，仰荷玄恩。",
    "呪曰：",
    "西北乾之父，",
    "其神通天光，",
    "聖帝愍民人，",
    "百鬼之剋傷，",
    "故結於天羅，",
    "布徧於十方，",
    "捕瘟收疫鬼，",
    "無一得隱藏，",
    "次次斬殺鬼，",
    "付之沸鑊湯，",
    "一切令滅盡，",
    "無復得逃亡，",
    "今日立功德，",
    "福流殄禍殃，",
    "病者得痊差，",
    "未則保休康，",
    "居宅悉清穩，",
    "鬼氣盡消亡，",
    "天神咸擁護，",
    "闔門永吉昌。",
    "上方",
    "臣等謹爲齋主某甲等修建洞淵三昧神呪大齋，愈病消災，功德行道。願遣黃英力士、正一使者，除遣女盆子、赤首大魔，請自攝邪精，應時蠲滅，使齋主凶殃雨散，厄障雲消，六府恬和，百關調暢，算壽增益，禄位長安，七祖遷昇，九玄蒙慶。得如所願，仰荷玄恩。",
    "呪曰：",
    "上方諸天帝，",
    "出入大羅門，",
    "廕育地上民，",
    "劫運使長年，",
    "下邪敢不亡，",
    "縱毒殺萬民，",
    "狼藉死病苦，",
    "怨聲徹上天，",
    "天上下大兵，",
    "擲火收百瘟，",
    "三五斷邪徑，",
    "七星塞鬼門，",
    "掩縳付天獄，",
    "萬民得完全。",
    "下方",
    "臣等謹爲齋主某甲等修建洞淵三昧神呪大齋，行道禮懴，歸命衆尊。願遣大明監邪、迴煞使者，各持鐵騎，收捕邪精，當使齋主疾病輕除，神安魄定，災運蕩滅，壽算增延，寵禄長承，台階速踐。得如所願，仰荷玄恩。",
    "呪曰：",
    "下方地祇靈，",
    "紀綱都九域，",
    "清澄於四海，",
    "安鎭於五嶽，",
    "制攝邪魔鬼，",
    "不得行百毒，",
    "上聖護生民，",
    "故下盟威勑，",
    "若有違逆者，",
    "收之付天獄，",
    "鐵鈎鈎鬼眼，",
    "金刀截手足，",
    "神呪殺百邪，",
    "百邪滅種族，",
    "萬民感道恩，",
    "無復哀悲哭，",
    "免度凶忌年，",
    "㑹見世安樂。",
    "太上洞淵三昧神呪齋十方懴儀"
   ]
  }
 ]
}