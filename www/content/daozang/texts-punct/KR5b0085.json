 "volumes": [
  {
   "h": "第一篇",
   "paras": [
    "黃庭內景玉經註",
    "推六",
    "神山劉長生解",
    "上淸章第一",
    "上清紫霞虛皇前，",
    "九天之上異景非常。",
    "上有三淸，中有玉皇，",
    "太上大道玉晨君。",
    "超凡入聖，身外之身，",
    "海變桑田，玉貌常新。",
    "閑君蘂珠作七言，",
    "蘂珠富内，肘後飛金，",
    "慈通顛倒，物外清吟。",
    "散化五形，變萬神，",
    "甲乙庚辛，丙丁壬癸，",
    "萬變神通，五形聚會，",
    "是爲黃庭日内篇。",
    "黄庭内景，聚會群仙，",
    "妙通法海，詩吟萬篇。",
    "琴心三叠，舞胎仙，",
    "心琴内橅，韻透青霄，",
    "胎仙舞冰，靈耀彰昭。",
    "九氣映明，出霄間，",
    "九陽還轉，七返通靈，",
    "夜明光現，鬼駭神驚。",
    "神蓋童子，生紫烟，",
    "紫霧紅光，結成華蓋，",
    "神通恍惚，無形不壞，",
    "是田玉書，可精研。",
    "萬經窮盡，玉訣精通，",
    "白然之道，聖德眞功。",
    "詠之萬過，昇三天，",
    "無中神出，萬化極機，",
    "十方三界，接引愚迷。",
    "千災以消，百病痊，",
    "一念無生，衆垢消，",
    "隂性通杳邈，占得虛無。",
    "不憚虎狼之凶殘，",
    "抱道忘形，虎狼遠避，",
    "背道著身，見獸自畏。",
    "亦以却老，年永延，",
    "外容有老，有形有終，",
    "内貌無形，仙壽無窮。",
    "上有章第二",
    "上有魂靈，下關元，",
    "地關緊閉，天門帝開。",
    "魂清氣爽，結就靈胎，",
    "左爲少陽，右太隂，",
    "左看甲龍，右看瘐虎，",
    "交媾徃来，自然眞趣。",
    "後有宻户，前生門，",
    "後户藏金，前門隱玉，",
    "無中常有，妙通一六。",
    "出日入月，呼吸存，",
    "陽降隂昇，出火入水，",
    "逆順顛側，光要達彼。",
    "元氣所合，列宿分，",
    "乾神相合，妙用冲和，",
    "天清光顯，萬象森羅。",
    "紫煙上下，三素雲，",
    "瑞雲觀步，紫煙覆頂，",
    "三台護我，虛無聖境。",
    "灌溉五華，植靈根，",
    "玉潤瓊茅，靜收白雪，",
    "五華宮内，銀蟾無缺。",
    "七液洞流，衝廬間，",
    "玄武金飯，朱雀玉漿，",
    "坎男离女，捧與天皇。",
    "廻紫抱黃，入丹田，",
    "紫煙光裊，妙慧相迎，",
    "覺花不謝，氣爽神淸。",
    "幽室内明，照陽門，",
    "要明神室，内闡陽門，",
    "東西相會，物外乾坤。",
    "口爲章弟三",
    "口爲玉池，太和官，",
    "口杯玉液，知味熙熙，",
    "咽過重樓，始遇眞人。",
    "漱咽靈液，災不干𤩞，",
    "漿頻飲，九九相交，",
    "迸出霞彩，天地難包。",
    "體生光華，氣香蘭()，",
    "靈臺軒豁，寶珠光瑩，",
    "探得鉛霜，汞通賢聖，",
    "却滅百邪，玉練顏清。",
    "靜無爲，心如霜雪，",
    "圓耀當空，十方明徹。",
    "審能修之，登廣寒，",
    "嵔崙頂上，唯占淸凉。",
    "明珠一顆，萬道霞光，",
    "晝夜不寐，乃成眞。",
    "陰盡陽純，無眠無夢，",
    "體若虛空，修成鉛汞。",
    "雷鳴電激，神泯泯，",
    "霹靂一聲，冲和交泰，",
    "顯岀至神，萬物之外。",
    "黄庭章第四",
    "黃庭内人，服錦衣，",
    "中央赤子，體掛六銖，",
    "作伴風月，為隣虛無。",
    "紫華飛帬，雲氣羅，",
    "天書紫詔，来召嬰嬌，",
    "大羅朝聖，速繫雲腰。",
    "丹靑緑條，翠靈柯，",
    "藕花薌裏，風擺金絲，",
    "寶瓶之内，别有一技。",
    "七㽔玉籥，閉兩扉，",
    "七星官内，常閉金靡，",
    "寶花臺上，無相容儀，",
    "重扉金關，宻樞機。",
    "九重玄户，玉鎖金關，",
    "妙通萬化，内結三丹。",
    "玄泉幽闕，髙崔嵬()，",
    "三峯頂上，萬派飛泉，",
    "仙宫寶所，異景相連。",
    "三田之中，精氣微，",
    "隱駕木牛，三田耕透，",
    "時兩頻潤，瓊芝靈秀，",
    "嬌女窈窕，翳霄暉月，",
    "娥抱定日，裏飛鳥，",
    "交光燦燦，結就元初。",
    "重堂煥煥，明八威，",
    "樓上月光，重堂性燭，",
    "内外俱明，八仙享福。",
    "天庭地關，列斧釿，",
    "抱一强兵，外魔闘敵，",
    "護法神人，慧斧常劈。",
    "靈䑓盤固，永不衰，",
    "絳宫赤子，捧出神珠，",
    "光生萬道，晃耀空虛。",
    "中池章第五",
    "中池内神，服赤珠，",
    "華池淸徹，上有飛鳥，",
    "不神而神，衣掛連珠，",
    "丹錦雲袍，帶虎符。",
    "五方異錦，修成六銖，",
    "巖前騎虎，遣怪飛符。",
    "横津三寸，靈所居，",
    "吸盡西江，三重焰赤，",
    "現出眞靈，太虚無極。",
    "隱芝翳鬱，自相扶，",
    "内採靈芝，磨開寶鑑，",
    "白蓮出水，淸香菡萏。",
    "天中章第六",
    "天中之嶽，精謹脩，",
    "千朶竒峯，萬株松檜，",
    "寶殿金門，中明堲帝。",
    "靈宅既清，玉帝遊，",
    "蒿嶽中天，上通玉帝，",
    "華嶽金方，巨靈神異。",
    "通利道路，無終休，",
    "巨海明珠，崑崙美玉，",
    "運入中華，無窮仙福。",
    "眉號華蓋，覆明珠，",
    "眉生瑞霞，化成寶蓋，",
    "輥出神珠，内明法海。",
    "九幽日月，洞空無，",
    "九陽宮内，鳥免交光，",
    "神機萬變，天地難量。",
    "宅中有眞，常衣丹，",
    "八境爲隣，太虛性宅，",
    "脫了雲衣，丹光赫赫。",
    "審能見之，無疾患，",
    "丹霞照耀，萬病消除，",
    "性如秋月，體若虚無。",
    "赤珠靈帬，華蒨粲，",
    "珠光迸出，焰似飛星，",
    "常餐芝草，花玉成形。",
    "舌下玄膺，生死岸，",
    "樓上仙衣，功髙體掛，",
    "换了凡軀，為調嬰姹，",
    "出淸入玄，二氣煥祥，",
    "耀無情金，飛玉走，",
    "顛倒明明，形神不朽。",
    "子若遇之，昇天漢，",
    "白然遭遇，玉性彰昭，",
    "便乘赤鳳，雲外飄飄。",
    "至道章第七",
    "至道不煩，决存眞，",
    "眞心不動，妙慧通靈，",
    "隂陽既濟，物外眞形。",
    "泥九百節，皆有神，",
    "玉骨金筋，相連關節，",
    "一點神光，應物明徹。",
    "髮神蒼華，字太元，",
    "生而皓首，内貌無衰，",
    "悟字通神，妙達無為。",
    "腦神精根，字泥丸，",
    "根固精飛，神道霞彩，",
    "透入泥丸，字明法海。",
    "眼神明上，字英玄，",
    "至神慧眼，無上觀天，",
    "一明萬化，字達英玄。",
    "鼻神玉壟，字靈堅，",
    "細鋤玉壟，勤種芝田，",
    "神書金字，上奏三天。",
    "耳神空閑，字幽田，",
    "自然響亮，神聽潺湲，",
    "既明上善，應物方圓。",
    "舌神通命，字五倫，",
    "舌湧甘津，醍醐灌頂，",
    "自覺神淸，妙道内景。",
    "齒神鍔鋒，字羅千，",
    "叩齒九九，庚甲交鋒，",
    "字傳萬古，羅錦千重。",
    "一面之神，宗泥丸，",
    "太虛之象，無影眞神，",
    "九陽宮闕，玉户道眞。",
    "泥丸九眞，皆有房，",
    "玄武二户，朱雀七門，",
    "内明開闔，唯現神尊。",
    "方圓一寸，處此中，",
    "中華神宅，瑩瑩方圓，",
    "下侵九地，上通九天。",
    "同服紫衣，飛羅裳，",
    "紫雲覆體，號曰黄人，",
    "陽純隂盡，跨鶴朝眞。",
    "但思一部，壽無窮，",
    "堲經萬卷，法有三乘，",
    "上乘一部，悟者飛昇。",
    "非各别住，居腦中，",
    "上下三官，混合一同，",
    "乾坤靈象，泥丸之中。",
    "列位次坐，向外方，",
    "三十二天，中尊玉皇，",
    "聖明物外，光徧十方。",
    "所存在心，自相當，",
    "中天玉帝，四方天主，",
    "每方八天，各有寶所。",
    "心神章第八",
    "心神丹元，字守靈，",
    "心藏於神，内明微奥，",
    "至象包含，汞鉛顛倒。",
    "肺神皓華，自虚成，",
    "肺藏於魄，神光照耀，",
    "道合三才，自然明了。",
    "肝神龍煙，字含明，",
    "肝藏於魂，神明牝户，",
    "字通慧眼，闃然無阻。",
    "翳鬱導煙，主濁清，",
    "离水上昇，坎火下降，",
    "混合清濁，神通無鞅。",
    "腎神玄冥，字育嬰，",
    "腎藏金精，神調胎息，",
    "字通聖妙，至明太極。",
    "脾神常在，字魂停，",
    "脾藏於志，抱道無離，",
    "神明樞要，用坎迎离。",
    "膽神龍曜，字威明，",
    "魂淸膽壯，神定冲和，",
    "既明大象，誰採人魔。",
    "六腑五臓，神體精，",
    "六腑精通，五臓淸澄，",
    "神丹鍊就，脫殼飛昇。",
    "皆在心内，運天經，",
    "神明天道，理合聖經，",
    "妙通萬化，無愛無憎。",
    "晝夜存之，自長生，",
    "周天十二，内顯神通，",
    "昏昏默默，了達眞空。",
    "肺部章第九",
    "肺部之宮，似華蓋，",
    "金經一部，絳宫三間，",
    "威儀法相，淸靜修丹。",
    "下有童子，坐玉闕，",
    "上清官畔，下有玉闕，",
    "大悲童子，默傳金訣。",
    "七元之子，主調氣，",
    "七竅通靈，中明赤子，",
    "如龜喘息，海枯心死。",
    "外應中嶽，鼻齊位，",
    "華胥中嶽，上闡天門，",
    "内明五帝，衆聖齊尊。",
    "素錦衣裳，黄雲帶，",
    "東西間隔，慧照中央，",
    "仙衣體掛，帶現金光。",
    "喘息呼吸，體不快，",
    "妙非口喘，眞非鼻息，",
    "赤鳳来呼，鳥龜去吸。",
    "急存白元，和液氣，",
    "白氣盈中，元神寂閑，",
    "玉液相傳，微妙無極。",
    "神仙乆視，無災害，",
    "至眞乆視，佳趣觀天，",
    "帝常清善，物外無愆，",
    "用之不巳，形不滯神。",
    "人無形，與道同體，",
    "萬物無拘，乘風而起。",
    "心部章第十",
    "心部之宮，蓮含華，",
    "大乘經内，至明道德，",
    "蓮宮蛙隱，合光無極。",
    "下有童子，丹元家，",
    "聖凡兩路，天上地下，",
    "至性天人，幻形物化。",
    "主適寒熱，榮衞和，",
    "性闡玄關，自然顛倒，",
    "三眞混合，祥煙光裊。",
    "丹錦飛裳，披玉羅，",
    "丹臺嬰姹，飛錦衣多，",
    "乘鸞跨鳳，同上大羅。",
    "金鈴朱帶，坐婆娑，",
    "金聲響亮，玉汞全眞，",
    "胎陽舞岀，物外形神。",
    "調血理命，身不枯，",
    "骨筋血肉，道氣精神，",
    "内眞外假，借假修眞。",
    "外應口舌，吐五華，",
    "口豈妄言，舌泯五味，",
    "天降神泉，不飲而醉。",
    "臨絶呼之，亦登蘇，",
    "絕廬明虛，垂光朗照，",
    "顯出靈童，眞歡眞笑。",
    "乆乆行之，飛太霞，",
    "絳宫非乆，蓬島仙家，",
    "功成歸去，永伴煙霞。",
    "肝部章第十一",
    "肝部之宫，翠重裹，",
    "甲方聖教，隱在中官，",
    "神光萬道，翠色千重。",
    "下有青童，神公子，",
    "九陽門下，物外人同，",
    "旣聞眞理，立祖明宗。",
    "主諸關鏡，聦明始，",
    "寶鑒磨開，九關明徹，",
    "法明慧眼，氣神相結。",
    "青錦披裳，佩玉鈴，",
    "太和宮内，玉性玲瓏，",
    "瓊漿金飯，青錦重重。",
    "和制魂魄，津液平虚，",
    "心清魂實，腹靜魄玉潤，",
    "金眞大丹光赫。",
    "外應眼目，日月清，",
    "降日垂光，性月圓明，",
    "坎生二八，至妙虛清。",
    "百痾所鍾，存無英，",
    "上懸金鍾，痾氣常盈，",
    "廣貪難滿，存濁無英。",
    "同用七日，自充盈，",
    "七光返照，慧日充盈，",
    "豈分晝夜，晃耀水晶。",
    "垂絕念神，死復生，",
    "垂慈念道，泯欲願神，",
    "慧生於心，至妙金眞。",
    "攝魂還魄，永無傾，",
    "鍊成魂魄，物外飛形，",
    "氣散精竭，性沉幽冥。",
    "腎部章第十二",
    "腎部之官，玄闕圓，",
    "精通法海，妙隱蟾宫，",
    "天花亂墜，徧滿虚空中，",
    "童子冥上，玄大仙，",
    "玉童恍惚，杳冥功成，",
    "蟬蜕現出眞形。",
    "主諸六府，九液源，",
    "陽和精固，神調六府，",
    "玉液旣萌，中央浄土。",
    "外應兩耳，百液津，",
    "耳聽雲雷，電閃龍降，",
    "逆順交通，性無愚憨。",
    "蒼錦雲衣，舞龍幡，",
    "襯步金蓮，法身明大，",
    "瑞氣盈盈，結成華蓋，",
    "上致明霞，日月煙致，",
    "虛極妙，兩耀交光，",
    "大丹九轉，體遍純陽。",
    "百病千災，急當存，",
    "無淸病除，至善災滅，",
    "察盡萬有，太虚明徹。",
    "兩部水王，對生門，",
    "陽道修生，隂道修死，",
    "三清九幽，明暗奥旨。",
    "使人長生，升九天，",
    "仙升九天，鬼沉九地，",
    "堲九生死，悟難迷易。",
    "脾部章第十三",
    "脾部之宫，屬戊己，",
    "黃經妙法，藏在中宮，",
    "理明一訣，慧有萬通。",
    "中有明童，黃裳裹，",
    "中仙羽衣，赤表黃裏，",
    "天圓七星，地方雲履。",
    "消穀散氣，攝牙齒，",
    "齒消百物，內外濁淸，",
    "大腸藏穢，腎海收精。",
    "是爲太倉，兩明童，",
    "運般黍米，揔入太倉，",
    "常餐金栗，玉藏清涼。",
    "坐在金䑓，城九重，",
    "金臺之上，十二層樓，",
    "重城二九，光顯瀛洲。",
    "方圓一寸，命門中，",
    "外方内圓，鶴引胎仙，",
    "命宮寶焰，上接三天。",
    "主調百榖，五味香，",
    "地産百榖，天生五味，",
    "萬物生成，隂陽之氣。",
    "辟却虚贏，無病傷殢，",
    "色形贏清，神實腹，",
    "死生兩路，明明禍福。",
    "外應尺宅，氣色芳，",
    "玄門開闡，妙通神宅，",
    "坎位淸魂，离中靜魄。",
    "光華所生，以表明，",
    "旣通賢聖，内顯眞榮，",
    "三陽照耀，八表俱明。",
    "黃錦玉衣，帶虎章，",
    "赤青黑白，戊已兼黃，",
    "中藏萬錦，應化瓊章。",
    "注念三老，子輕翔，",
    "佛老文冝，妙智難量，",
    "得一方知，體變眞陽。",
    "長生髙仙，遠死殃，",
    "超凡入聖，物外無殃，",
    "大羅之上，朝現玉皇。",
    "膽部章第十四",
    "膽部之宫，六府精，",
    "甲龍庚虎，壬男丙女，",
    "顛倒倒顛，膽神明祖。",
    "中有童子，耀威明，",
    "太虚之中，物外靈童，",
    "柔弱光生，妙用其雄。",
    "雷電八振，揚玉旌，",
    "巨靈眞異，雄振八方，",
    "玉旌唯撼，接刃交光，",
    "龍旗橫天，擲大鈴，",
    "風飐龍旗，隂魔闘敵，",
    "陽殺其隂，眞雄無極。",
    "主詣氣力，攝虎兵，",
    "神明慧力，抱一堅貞，",
    "劎揮赫赫，從有強兵。",
    "外應眼童，鼻柱間，",
    "天眼垂光，虛明玉柱，",
    "鍊汞成形，至神遭遇。",
    "腦髮相扶，亦俱鮮，",
    "上闡陽門，妙通玉腦，",
    "七竅通明，毫光一道。",
    "九色錦衣，縁華帬，",
    "體掛六銖，中繋華帬，",
    "便乘鸞鳳，雲外朝眞。",
    "佩金帯玉，龍虎文，",
    "玉佩玎璫，威儀行步，",
    "無影眞容，騎龍跨虎。",
    "能存威眀，乘慶雲，",
    "抱道忘塵，眞性超群，",
    "欲朝金闕，穩駕祥雲。",
    "役使萬神，朝三元，",
    "天元降相，中元赦罪，",
    "地元解厄，萬神朝會。",
    "脾長章第十五",
    "脾長一尺，掩太倉，",
    "五行脾祖，土榖之倉，",
    "中華上國，一者帝王。",
    "中部老君，治明堂，",
    "中華聖教，治世修眞，",
    "先天之象，明者老君。",
    "厥字靈元，名混康，",
    "忘言抱道，六三混成，",
    "德歸無上，至大強名。",
    "治人百病，消榖粮，",
    "靈樂能治，妄念百邪，",
    "竊食充飢，麤布胡遮。",
    "黃衣紫帶，龍虎章，",
    "金翁玉冠，黄婆紫帶，",
    "寶殿聖容，萬神齊拜。",
    "長精益命，賴君王，",
    "北海飛金，南山鑿玉，",
    "赤帝通明，無窮聖福。",
    "三呼我名，神自通，",
    "喝散隂魔，呼聚陽神，",
    "神通萬一，方號金眞。",
    "三老同坐，各有朋，",
    "三老各朋，左文右武，",
    "無極天中，鸞迎鳳舞。",
    "或精或胎，别執方，",
    "十方明處，一點靈明，",
    "胎仙養就，奪得眞精。",
    "桃孩合延，生華芒，",
    "桃臉嬰孩，抱道延長，",
    "深根固蒂，吐岀光芒。",
    "男女徊九，有桃康，",
    "仙男仙女，世景徘徊，",
    "風前月下，至性希夷。",
    "道父道毋，對相望，",
    "以天為父，以地為毋，",
    "太虛含象，聖人妙趣。",
    "師父師毋，丹玄郷，",
    "至聖為父，至道為毋，",
    "靈耀為子，宻妙為度。",
    "可用存思，登虛空，",
    "存思念道，絶慮泯俗，",
    "取捨俱忘，自然眞福。",
    "殊途一會，歸要終，",
    "物象窮通，靜情歸一，",
    "建德若偷，聖功了畢。",
    "閉塞三開，握固停，",
    "預塞金關，固守眞精，",
    "氣神相見，得之圓成。",
    "含漱金醴，吞玉英，",
    "會仙樓上，滿泛金漿，",
    "胎仙醉舞，回首仙鄉。",
    "遂至不飢，三蟲亡，",
    "玉漿金飯，三嚥忘飢，",
    "蟲尸旣散，性顯光輝。",
    "心意常和，致欣昌，",
    "心通意解，神氣冲和，",
    "内眞歡笑，舞神婆娑。",
    "五嶽之雲，氣彭亨，",
    "五嶽眞形，中明玉京，",
    "金光萬道，紫霧千層。",
    "保灌玉廬，以自償，",
    "天降瓊漿，盈滿玉器，",
    "酌了重生，八仙共醉。",
    "五形完堅，無災殃，",
    "五方霞彩，鍊就眞形，",
    "旣超三界，去似飛星。",
    "上覩章第十六",
    "上覩三光，如連珠，",
    "上覩三光，中明本元，",
    "玉花香滿，結就金蓮。",
    "落落明景，照九隅，",
    "天花飄落，光徧乾坤，",
    "碧虛陽耀，射透崑崙。",
    "五靈夜濁，煥八區，",
    "昇霞萬象，大極爭光，",
    "古今賢聖，位列八方。",
    "子存内皇，與我遊，",
    "子能見毋，道合其眞，",
    "胎神養就，内貌常新。",
    "身披鳯衣，衘虎符，",
    "性開金訣，體掛衣珠，",
    "妖魔侵境，天降虎符。",
    "一至不乆，升虚無，",
    "心忘意滅，我本大無，",
    "神丹鍊就，與聖問居。",
    "方寸之中，念深藏，",
    "自然眞道，妙慧深藏，",
    "夜明光耀，方寸淸凉。",
    "不方不圓，閉牖牕，",
    "耳不邪聽，口不妄言，",
    "鼻不聞香，法眼觀天。",
    "三种還精，老方壯，",
    "三陽照體，鳳引龜精，",
    "自然抱道，返老還嬰。",
    "魂魄内守，不爭競，",
    "魂居杳邈，魄靜朝元，",
    "隂變為陽，蓬島爲仙。",
    "神生腹中，銜玉璫，",
    "神生淸瑩，龜吸日光，",
    "鑿開靈竅，美玉玎璫。",
    "靈注幽闕，那得䘮，",
    "陽降神通，性朝玉闕，",
    "九霄之上，無生無滅。",
    "琳條萬尋，可蔭仗，",
    "玉條垂芳，裊浸波心，",
    "枯乾北海，瓊樹無隂。",
    "三魂自寧，帝書命，",
    "魂朝赤帝，寶光如鏡，",
    "治國安民，聖宣勑命。",
    "靈臺章第十七",
    "靈䑓鬱藹，望黄野，",
    "靈芝一段，黃野相侵，",
    "崑山隱玉，巨海藏金。",
    "三寸異室，有上下，",
    "中央三耀，聚而成形，",
    "陽逢壬癸，隂過丙丁，",
    "間關營衞，髙玄受，",
    "天人護法，聖度無執，",
    "慧能之後，無師不立。",
    "洞房紫極，霊明户，",
    "水晶龍宮，煙霞虎洞，",
    "内明九房，外明九孔。",
    "是昔太上，告我者，",
    "自然萬通，名為太上，",
    "無我知雄，法明至象。",
    "左神公子，發神語，",
    "甲位神公，蟾宮赤子，",
    "默黙相傳，無為與旨。",
    "右有白元，併立處，",
    "白氣充盈，天元一併，",
    "既悟希夷，理通賢聖。",
    "明堂金匱，玉房間，",
    "雲堂寂寂，開闡陽門，",
    "神明萬化，永永長生。",
    "上清真人，當吾前，",
    "太上西昇，悟真徐尹，",
    "入聖超凡，人人有分。",
    "黃裳紫丹，氣頻煩，",
    "中元羽衣，朱帶黄裳，",
    "神明慧眼，滿目金光。",
    "借問何在，兩眉端，",
    "借假全眞，本眞無相，",
    "眼耀如星，白毫靈象。",
    "内俠日月，列宿陳，",
    "天光燦燦，斗轉星移，",
    "虛空斡運，暗合天機。",
    "七曜九元，冠生門，",
    "七返通眞，元神吐耀，",
    "開闡九門，心香裊裊。",
    "三關章第十八",
    "三關之中，精氣深，",
    "陽關常開，隂門永閉，",
    "中明顛倒，水大旣濟。",
    "九微之中，幽且隂，",
    "九光微妙，道氣幽深，",
    "氣神清爽，水裹生金。",
    "口爲天關，精神機，",
    "口為聰辯，心為智慧，",
    "至妙忘言，崇眞無偽。",
    "足爲地關，生命棐，",
    "金蓮襯步，顯個嬰兒，",
    "蓬莱咫尺，内禮明師。",
    "乎爲人關，把盛衰，",
    "手擎宇宙，妙有雙關，",
    "真靈出世，豈羡人間。",
    "若得章第十九",
    "若得三宫，存玄丹，",
    "徃来昇降，不離三宫，",
    "靈丹一粒，服了神通。",
    "太一流珠，安崑崙，",
    "神光迸出，萬顆玄珠，",
    "冲和一點，體洽太虚。",
    "重中樓閣，十二環，",
    "重樓十二，上接雲煙，",
    "鸞迎風吹，聚會神仙。",
    "自髙自下，皆眞人，",
    "眞仙厭世，雲歩朝元，",
    "地去高天，八萬四十，",
    "玉堂綘宇，盡玄宮。",
    "大羅衆仙，各居賓所，",
    "鳳閣龍宮，祥光罩霧。",
    "璇璣玉衡，色闌玕，",
    "摘星樓上，凭玉闌玕，",
    "慧觀八極，日赴千壇。",
    "瞻望重子，坐盤桓，",
    "物外靈童，坐者雄武，",
    "滿張弓射，九重鐵鼓，",
    "問誰家子，在我身，",
    "見道明子，得永全眞，",
    "聖賢為伴，風月為鄰。",
    "此人何去，入尼丸，",
    "意辭萬慮，氣運神般，",
    "金光兩道，上至泥九。",
    "千千百百，自相連，",
    "千千百百，玉女金童，",
    "時時天樂，聒透仙翁。",
    "一一十十，似重山，",
    "一明性耀，十分皎潔，",
    "表裏俱通，重重明徹。",
    "雲儀玉華，俠耳門，",
    "無影雲儀，晝夜眞歡，",
    "玉穿靈竅，光隱泥丸。",
    "赤帝黄老，與我魂，",
    "赤宫大帝，中位天人，",
    "帝天相合，與我陽魂。",
    "三眞扶胥，共房津，",
    "無為眞性，有相假身，",
    "調和眞假，共飮香津。",
    "五斗煥明，是七元，",
    "五明霞彩，光射七元，",
    "自然聖妙，養就胎仙。",
    "日月飛行，六合間，",
    "鳥飛兔走，運轉乾坤，",
    "隂陽顛倒，蛇把龜吞。",
    "帝郷天中，地户端，",
    "大一仙宮，中明上帝，",
    "朝聖眞人，蓬萊一會。",
    "面部魂神，皆相存，",
    "魂通杳冥，神達虚無，",
    "無中明徹，賢聖之書。",
    "呼吸章第二十",
    "呼吸元氣，以求仙，",
    "養就胎神，非外呼吸，",
    "妙用抽潻，霞光出入。",
    "仙公公子，巳可前，",
    "眞明杳邈，象帝之先，",
    "無表無朽，號日神仙。",
    "朱鳥吐縮，白石源，",
    "天鳥街花，石湧飛泉，",
    "松峯之畔，吟笑忘言。",
    "結精育胞，化生身，",
    "氣和神定，性停精固，",
    "育成七寶，大羅歸去。",
    "留胎止精，可長生，",
    "恍惚護胎，清神保精，",
    "冲和交媾，鍊氣成形。",
    "三氣右徊，九道明，",
    "天之一氣，其用不勤，",
    "中超三界，宻酬四恩。",
    "正合華乃，充盈大，",
    "一明妙琼，蘂含光，",
    "神道異變，萬怪潜藏。",
    "遥望一心，如羅星，",
    "虚心慧視，内外淸澄，",
    "迴光燦燦，月上參星。",
    "金室之下，不可傾，",
    "海藏龍宮，事雄抱雌，",
    "巨海謙下，萬泒歸之。",
    "延我白首，返孩嬰，",
    "生而皓首，内貌無衰，",
    "岀有入無，至妙無為。",
    "瓊室章第二十一",
    "瓊室之中，八素集，",
    "三山宮室，八仙會集，",
    "過海乘風，各有妙術。",
    "泥九夫人，當中立，",
    "祥光萬道，慧眼頻觀，",
    "中明姹女，内性眞歡。",
    "長谷玄鄉，繞郊色，",
    "顧神至闃，物外仙鄉，",
    "放開靈耀，應物無妨。",
    "六龍散飛，難分别，",
    "龍蟠离穴，虎繞坎宮，",
    "甲庚交位，道顯神通。",
    "長生至慎，房中急，",
    "萬通眞戒，物物無為，",
    "壺天靈象，兔走島飛。",
    "何爲死作，令神泣，",
    "大乘聖教，廣度衆生，",
    "若遣天道，永墮幽冥。",
    "忽之禍鄉，三靈沒，",
    "恩中生害，性沉禍鄉，",
    "三魂難保，七魄消亡。",
    "但當吸氣，録于精，",
    "氣歸元海，密護眞精，",
    "虛無恍惚，出世通靈。",
    "寸田尺宅，可治生，",
    "上達八方，中明寸宅，",
    "夜明光耀，天寬地窄。",
    "若當决海，百瀆傾，",
    "巨海謙虚，百瀆歸之，",
    "三天内有，無上元始。",
    "葉去樹枯，失青青，",
    "寶樹一株，金枝玉葉，",
    "無影靈童，時時攀折。",
    "氣亡液漏，非己形，",
    "坎中鍊汞，离内烹鉛，",
    "丹成九轉，脱殼昇仙。",
    "專閉御景，乃長寧，",
    "中華聖境，常閉金門，",
    "民豐國泰，一者帝尊。",
    "保我泥丸，三奇靈，",
    "泥丸之内，護我三台，",
    "鍊汞成眞，雲步蓬莱。",
    "恬惔閉視，内自明，",
    "至性恬然，坎宮緊閉，",
    "開闡當中，晨光照體。",
    "物物不干，泰而平，",
    "無物之象，自然交泰，",
    "虎嘯龍吟，諕殺邪怪。",
    "慤矣匪事，老復丁，",
    "方圓曲直，上善淸澄，",
    "中明甲乙，豈問丙丁。",
    "思詠玉書，入上淸，",
    "龍篆玉書，神奏上淸，",
    "崇眞達德，天上功名。",
    "常念章第二十二",
    "常念三房，相通達，",
    "連峯宮室，内隱雲房，",
    "癸丁相見，内有炎凉。",
    "洞得視見，無内外，",
    "一顆圓珠，明照内外，",
    "洞達眞光，永永無壞。",
    "存漱五牙，不飢渇，",
    "胎仙沐浴，金漱玉芽，",
    "内無飢渇，常飮煙霞。",
    "神華執巾，六丁謁，",
    "神通毫髮，离女捧巾，",
    "六丁來謁，功奏上眞。",
    "急守精室，勿妄泄，",
    "抱元守道，精固神靈，",
    "無中生有，現出眞形。",
    "閉而保之，可長活，",
    "骨堅髓實，精竭人亡，",
    "至愼保眞，益壽年長。",
    "起自形中，初不闊，",
    "靈衢通聖，間隔不闊，",
    "乾坤内合，巨靈一撮。",
    "三宮近在，易隱括，",
    "宮塵種種，神妙頻括，",
    "七曜通靈，為爲大達。",
    "虛無寂寂，空中素，",
    "大道非空，體同太虚，",
    "自然至妙，輥出明珠。",
    "使形如是，不當汙，",
    "身如野鶴，性似閑雲，",
    "碧虛空外，飄飄任眞。",
    "九室正虛，神明舍，",
    "九宮之内，瑞氣盈盈，",
    "神明正慧，果證圓成。",
    "存思百念，視節度，",
    "物物深窮，得意忘言，",
    "性明道眼，妙用觀天。",
    "六府修治，勿令故，",
    "六府調泰，法體安然，",
    "周天烹鍊，金汞玉鉛。",
    "行自翱翔，入天路，",
    "碧霄靈外，鸞鳳翱翔，",
    "得道眞仙，朝現玉皇。",
    "治生章第二十三",
    "治生之道，了不煩，",
    "理達慧生，明徹仙經，",
    "冲和之妙，内視無形。",
    "但修洞玄，與玉篇，",
    "洞玄靈寶，能明玉篇，",
    "崇眞了達，異日昇仙。",
    "兼行形中，八景神，",
    "無爲之妙，鉛汞成形，",
    "神明八表，應物道靈。",
    "二十四眞，岀自然，",
    "八渠液轉，二八生成，",
    "自然之妙，大達超生。",
    "髙拱無爲，魂魄安，",
    "抱道守眞，魂淸魄靜，",
    "旣逹聖妙，坦然大定。",
    "清靜神見，與我言，",
    "至神護法，聖道默傳，",
    "治國修眞，太上妙言。",
    "安在紫房，幃幕間，",
    "祥光萬道，射透瓊幃，",
    "胎仙造進，常刀圭。",
    "立坐室内，三五玄，",
    "天男夭女，立侍天皇，",
    "五明宫内，日月星光。",
    "燒香接手，玉華前，",
    "禱聖焚香，道明至友，",
    "了達無為，蓬瀛携手。",
    "共入大室，璇璣門，",
    "璇璣七門，内隱天眞，",
    "妙擎宇宙，身外有身。",
    "髙研恬惔，道之園，",
    "磨開古鑒，應物明通，",
    "三陽相會，七寶園中。",
    "内視宻盻，盡覩眞天，",
    "眼明道慧，眼明眞，",
    "法眼通聖，始顯化身。",
    "眞人在己，莫問隣，",
    "大玄境内，唯道明眞，",
    "參羅光照，至闃爲隣。",
    "何處遠索，求因縁，",
    "旣離火院，棄世全眞，",
    "剔開道眼，闚妙良因。",
    "隱景章第二十四",
    "隱景藏形，與世殊，",
    "嵩陽勝景，隱在中華，",
    "旣忘世夢，髙卧煙霞。",
    "含氣養精，口如朱，",
    "太極含光，隂變純陽，",
    "神丹一粒，光徧十方。",
    "帯執性命，守虚無，",
    "執天行道，至通顛倒，",
    "鍊就重純，十洲三島，",
    "名入上淸，死録除。",
    "𣨼著物我，死墮幽冥，",
    "神超三界，玉帝知名。",
    "三神之樂，由隱居，",
    "修成七魄，鍊就三魂，",
    "至神宻隱，物外超群。",
    "倏飲遊遨，無遺憂，",
    "至趣超凡，萬縁了畢，",
    "道德無爲，始終無失。",
    "羽服一整，八風驅，",
    "一整羽衣，碧霄進貢，",
    "不夜天中，携雲跨鳳。",
    "控鴐三素，乘晨霞，",
    "青鸞前引，穩步雲軒，",
    "異香風送，昇入三天。",
    "金輦正立，從玉與，",
    "聖坐金輦，眞乘玉與，",
    "天人侍立，共赴仙都。",
    "何不登山，誦我書，",
    "火坑跳岀，三峯隱居，",
    "明今妙道，聖人之書。",
    "鬱鬱窈窈，眞人墟，",
    "深種靈芝，神泉澆溉，",
    "丁看鳥龜，癸觀翡翠。",
    "入山何難，故躊躇，",
    "對景如山，至性無疑，",
    "頓明聖理，妙逹希夷。",
    "人間紛紛，臭如帑，",
    "世事紛紛，皆造福業，",
    "不𣨼中邊，大道明徹。",
    "五行章第二十五",
    "五行相推，反歸一，",
    "金闡離宮，玉封坎户，",
    "神明霞彩，自然開悟。",
    "三五氣合，九九節，",
    "三神抱道，五彩飛光，",
    "大和眀内，體變重陽。",
    "可用隱地，廻八術，",
    "内隱泥丸，蜕形顯質，",
    "八仙會上，各有藝術。",
    "伏牛幽關，羅品列，",
    "牛駕雲車，聖歸金闕，",
    "天樂齊迎，群仙總列。",
    "三明岀華，生死際，",
    "三光朗照，菡萏淸香，",
    "自然目視，眞景非常。",
    "洞房靈象，斗日月，",
    "内鎖顛猿，法塵泯絕，",
    "妙達虗無，象擎日月。",
    "父曰泥九，母雌一，",
    "金翁抱眞，黃婆守道，",
    "行滿功圓，仙歸蓬島。",
    "三光煥照，入子室，",
    "天光照耀，仙宮深宻，",
    "護法神尊，盜賊怎敵。",
    "能存玄眞，萬事畢，",
    "至明大象，妙達玄眞，",
    "孰知壺内，別有乾坤。",
    "一身精神，不可失，",
    "清志抱一，性命無失，",
    "迸岀神光，看津如蜜。",
    "髙奔章第二十六",
    "髙奔日月，吾上道，",
    "聖達無上，鳥兔交光，",
    "妙明八極，細入毫芒。",
    "鬰儀結璘，善相保，",
    "嬰子抱眞，鬱母爲隣，",
    "毋養其子，鍊氣成神，",
    "乃見王清，虚無老，",
    "上達玉清，中明黃老。",
    "體同太虛，手擎芝草，",
    "可以廻顏，填血腦，",
    "和血固精，調氣順神，",
    "鍊眞合道，乃可全眞。",
    "口銜靈芒，携五皇，",
    "鳳銜玉蘂，獻與天皇，",
    "離宫隂返，物外之鄉。",
    "腰帶虎籙，佩金璫，",
    "星冠月帔，金玉玎璫，",
    "黙朝玉帝，性執珪璋。",
    "駕歘接生，宴東蒙，",
    "蟾宮瓊宴，癸毋丁翁，",
    "天厨造膳，仙樂東蒙。",
    "玄元章第二十七",
    "玄元上一，魂魄鍊，",
    "虚空微妙，安魂定魄，",
    "功要三千，行修八百。",
    "一之爲物，叵卒見，",
    "道象無形，隂陽有變，",
    "造化堲功，慧眼唯見。",
    "須得至眞，始顧盻，",
    "至明顛倒，木金相間，",
    "無物之眞，天眼顧盻。",
    "至忌死氣，諸穢賤，",
    "媱聲美色，䘮眞死氣，",
    "凡夫總愛，聖人見穢。",
    "六神合集，虚中宴，",
    "遠道陽神，出世眞仙，",
    "蓬萊赴宴，閑訪桃園。",
    "結珠固精，養神根，",
    "神珠光耀，固守金精，",
    "結成三寶，内現眞形。",
    "玉𥫽金籥，常完堅，",
    "虛中棄籥，價酬千金，",
    "玉吹靈竅，神鬼皆鸞。",
    "閉口屈舌，食胎津，",
    "忘言妙道，恬惔修眞，",
    "潭清龍現，下涌甘津。",
    "使我遂鍊，飛仙聖人，",
    "妙訣進火，烹鉛大丹，",
    "鍊就體化飛仙。",
    "仙人章第二十八",
    "仙人道士，非有神，",
    "知神非我，不神乃神，",
    "恐生斷見，應物明眞。",
    "積精累氣，乃成真，",
    "性通三耀，命達三田，",
    "氣結三寶，功滿三千。",
    "黄童妙音，難可聞，",
    "黄庭上有，赤宅靈明，",
    "光光相射，各聽無聲。",
    "玉書絳簡，赤丹文，",
    "神篆金簡，奏聖靈文，",
    "有功無妄，行滿騰雲。",
    "字曰眞人，巾金巾，",
    "至理金眞，華陽妙巾，",
    "六銖光顯，二八金身。",
    "負甲持符，開七門，",
    "元神護法，天降飛符，",
    "七門返照，昇入仙都。",
    "火兵符圖，備靈關，",
    "強兵善勝，常在丙壬，",
    "内雄不岀，外賊無侵。",
    "前昻後卑，髙下陳，",
    "要先必後，欲下而髙，",
    "海心萬丈，滌藏巨鱉。",
    "執劎百丈，舞靈幡，",
    "臣靈神劎，慧刃如鋒，",
    "混元海内，活捉蛟龍。",
    "十絕盤空，扇紛紜，",
    "十極之中，銀盤無缺，",
    "羽扇紛紜，晴空皎潔。",
    "火鈴冠霄，隊落煙，",
    "九天神鳯，清聲火鈴，",
    "百禽隊隊，從似飛星。",
    "安在黃闕，兩眉間，",
    "眉間毫象，應顯靈通，",
    "金客玉體，光耀中宮。",
    "此非技葉，實是根，",
    "春夏萬木，壯極則衰，",
    "深振至性，潜隱無隳。",
    "紫清章第二十九",
    "紫清上皇，大道君，",
    "中天至聖，上達三清，",
    "人天了道，真朝玉京。",
    "太玄太和，俠侍端，",
    "上帝天皇，中華帝王，",
    "侍尊近貴，萬代名揚。",
    "化生萬物，使我仙，",
    "自然妙道，無中有靈，",
    "隂陽相貫，萬化生成。",
    "飛升十天，駕玉輪，",
    "太陽之君，𩗹駕玉輪，",
    "碧虛明徹，萬里無雲。",
    "盡夜七日，思勿眠，",
    "七曜通神，晝夜崑崙，",
    "陽純無夢，號日眞人，",
    "子能行此，可長存，",
    "黙行天道，性命長存。",
    "古今興廢，豈可言，",
    "論積功成，鍊非自然，",
    "自然靈耀，空舞胎仙。",
    "抽添沐浴，全賴周天，",
    "是由精誠，亦由專，",
    "因師奥旨，道上精勤，",
    "聖功全德，物外良因。",
    "内守堅固，真之真，",
    "忘言守道，棄物全真，",
    "慧明中顯，無相眞形，",
    "虛中恬悛，自致神。",
    "至神無形，與道合眞，",
    "碧霄雲外，明耀常新。",
    "百榖章第三十",
    "百榖之實，土地精，",
    "百榖隂精，實腹通靈，",
    "九陽烹鍊，變化真形。",
    "五味外美，邪魔腥，",
    "意遠腥膻，眞通道味，",
    "天降霞漿，重棲一醉。",
    "臭亂神明，胎氣零，",
    "殺害群生，臭濁養形，",
    "昏神喪慧，業粮非輕。",
    "那從返老，却還嬰，",
    "皓然太上，玉貌如嬰，",
    "神明萬化，顯達西昇。",
    "三魂惚惚，魄糜傾，",
    "汞鉛顛倒，水火相交，",
    "丹爐陽熖，鍊成白膏。",
    "何不食氣，太和精，",
    "九陽照體，白覺神靈，",
    "夜明光照，北海龜精，",
    "故能不死，入黄寧，",
    "用慧明眞，實相無形，",
    "先天妙景，隱在黄庭。",
    "心典章第三十一",
    "心典一體，五臓王，",
    "悟一惺甦，採得蟠桃，",
    "山頭顯現，物外知交。",
    "動靜念之，道德行，",
    "眼迸萬珠，戊己千拜，",
    "六賊須歸，隂陽交泰。",
    "清潔善氣，自明光，",
    "絕利忘名，恩牢跳出，",
    "坦蕩無憂，始明悟一。",
    "坐起吾俱，共棟粱，",
    "大物謙下，欲後必先，",
    "處窪得盈，能曲道金，",
    "晝日耀景，暮閉藏，",
    "三陽照耀，内景佳祥，",
    "神通法象，百怪潛藏。",
    "通利華精，調隂陽，",
    "腎海精金，崑山美玉，",
    "盈滿中宮，真人洪福。",
    "經歷章第三十二",
    "經歷六合，隱卯酉，",
    "周天六度，隂陽相合，",
    "倒顛卯酉，逆順庚甲。",
    "兩腎之神，主延壽，",
    "命宫兩道，上接泥丸，",
    "清神爽氣，晝夜眞歎。",
    "轉降適斗，藏初九，",
    "運轉參星，照侵北斗，",
    "一陽起火，妙通九九。",
    "知雄守雌，可無老，",
    "玄門牝户，開闔明悟，",
    "既達聖機，眞師來度。",
    "知白見黑，急坐守，",
    "澄光顯黑，神明眼碧，",
    "内視通天，妙觀太極。",
    "肝氣章第三十王",
    "肝氣鬱勃，清且長，",
    "甲方寶樹，枝聳根邃，",
    "上接三天，下侵九地。",
    "羅列六腑，生三光，",
    "調和六腑，内運三光，",
    "神明霞彩，永占清涼。",
    "心精意專，内不傾，",
    "神清意泯，虛無自然，",
    "不空不色，聖妙心傳。",
    "上合三焦，下玉漿，",
    "貪嗔癡滅，至性彰昭，",
    "黄芽裊裊，玉液頻澆。",
    "玄液雲行，去臭香，",
    "洗心滌垢，垢盡光生，",
    "圓眀應物，光耀無情。",
    "治蕩髮齒，鍊五方，",
    "理髮萬通，神開金口，",
    "妙髮無衰，金齒不朽。",
    "取津玄膺，入明堂，",
    "異景堂中，内隱深淵，",
    "澄清照軀，號曰龍泉。",
    "下漑喉嚨，神明通，",
    "上涌靈泉，胎神沭浴，",
    "法體清澄，自然真福。",
    "坐侍華蓋，遊貴京，",
    "含兄咫尺，通明水晶，",
    "朱省玄武，宻護神京。",
    "飄颻三帝，席清涼，",
    "三皇之始，有道為王，",
    "無爭善勝，豈用刀鎗，",
    "五色雲氣，紛青葱，",
    "順光芝草，逆氣青葱，",
    "芝香葱臭，道俗豈同。",
    "閉目内盻，自相望，",
    "鳳眼龜睛，中華根望，",
    "离坎交宮，德明無上。",
    "使心諸神，還相崇，",
    "道妙虚心，鍊玉烹金，",
    "性通天意，神鬼皆欽。",
    "七玄英華，開命門，",
    "七珠返照，内視天眞，",
    "龜吸霞彩，走上崑崙。",
    "通利天道，存玄根，",
    "内返陽天，氣結靈鉛，",
    "大丹光頭，三島真仙。",
    "百二十年，猶可還，",
    "百二長安，蟾宮明微，",
    "七返明元，九還丹結。",
    "過此守道，誡獨難，",
    "萬景之中，心意如山，",
    "頓明開悟，獨立非難。",
    "唯待九轉，八瓊丹，",
    "八仙物外，常伴紅霞，",
    "神丹九轉，蓬島為家。",
    "要復精思，存七元，",
    "賢達精思，聖智無慮，",
    "聖賢出世，凡人遭遇。",
    "日月之華，救老殘，",
    "月滿無虧，日耀古壇，",
    "太虚之内，永結神丹。",
    "肝氣周流，終無端，",
    "東方甲乙，明朝赤帝，",
    "玉户常開，金關自閉。",
    "肺之章第三十四",
    "眼之爲氣，三焦起，",
    "三魂既清，三毒盡滅，",
    "善採黄芽，眞收白雪。",
    "視聽幽冥，候童子，",
    "慧明恍惚，内聽潺湲，",
    "玉童來報，功滿三田。",
    "調理五華，精髮齒，",
    "太和之中，玉女金童，",
    "披襟散髮，各顯神通。",
    "三十六咽，玉池裹，",
    "重明九九，九氣三通，",
    "陽神聚會，霞友雲朋。",
    "開通百脉，血液始，",
    "性通陽脉，精化爲胎，",
    "形神俱妙，永住蓬萊。",
    "顏色生光，金玉澤，",
    "豆初靈顯，内寶盈中，",
    "太極妙有，至行真功。",
    "齒堅髮黑，不知白，",
    "叩齒神通，皓髮幽冥，",
    "内容不老，無影眞形。",
    "存此眞神，勿落落，",
    "有形有盡，無物常存，",
    "既明眞道，妙慧通神。",
    "當憶此宮，有座席，",
    "上清宮畔，九夏炎炎，",
    "響梟怪竹，座席冰簟。",
    "衆神合會，轉相索，",
    "千神聚會，同赴天壇，",
    "臨風對月，自在淸閑。",
    "隱藏章第三十五",
    "隱藏羽蓋，看天舍，",
    "内隱祥輝，結成華蓋，",
    "羽化眞人，九霄之外，",
    "朝拜太陽，樂相呼，",
    "黃庭眞景，蓬島相隣，",
    "嬰兒姹女，跨鳳朝眞。",
    "明神八威，正辟邪，",
    "氣結神靈，威儀闃靜，",
    "法眼通天，辟邪歸正。",
    "脾神還歸，是胃家，",
    "土榖盈倉，脾還胃粮，",
    "神明九眼，上顯三光。",
    "耽養靈根，不復枯，",
    "至靜歸眞，保命常存，",
    "神明慧朗，照耀崐崙。",
    "開塞命門，保玉都，",
    "旣明門闔，汞鉛相合，",
    "七寶玲瓏，化成寶塔。",
    "萬神方昨，壽有餘，",
    "七寶壇上，衆聖非無，",
    "焚香酌酒，洪禧有餘。",
    "是謂脾建，在中宮，",
    "忘言妙理，黄老中明，",
    "鍊神合道，永位蓬瀛。",
    "五臓六腑，神明主，",
    "寸宅神光，五行之主，",
    "實腹存三，眞通六腑。",
    "上合天門，入明堂，",
    "天門闡開，金關鎻閉，",
    "内有神尊，仙聚會，",
    "守雌存雄，頂三光，",
    "酉上金鳥，卯中玉兔，",
    "兩耀交光，萬神光聚。",
    "外方内圓，神在中，",
    "神明一圓，妙達先天，",
    "居塵不染，火裹生蓮。",
    "通利血脉，五臓豐，",
    "三耀和冲，五臓神豐，",
    "珠如黍米，光徧虛空，",
    "骨青筋赤，髓如霜，",
    "神淸體徤，骨堅髓實，",
    "六賊難存，三尸自出。",
    "脾救七竅，去不祥，",
    "清志如山，内汞長安，",
    "大羅聖降，常赴天壇。",
    "日月列布，設隂陽，",
    "萬化生成，皆稟隂陽，",
    "照臨法界，日月之光。",
    "兩神相會，化玉漿，",
    "内神精光，外容形影，",
    "明眞悟假，六鍊頻整。",
    "淡然無咪，天人糧，",
    "恬淡靈泉，能濟飢渴，",
    "潔𧗊凡情，自然了達。",
    "子丹進饌，肴正黄，",
    "玉體金容，黄庭内看，",
    "渴飮瓊漿，飢餐珍饌。",
    "乃曰琅膏，及玉霜，",
    "鍊成玉膏，修就金汞，",
    "龜吸夜光，蛇穿七孔。",
    "太上隱環，八素瓊珠，",
    "數金聲九，九隱環，",
    "至神内繫，一撞三關，",
    "溉益八液，腎受精，",
    "八渠瓊水，澆溉靈芽，",
    "炎收白雪，可稱仙家。",
    "伏於太隂，見我形，",
    "天如秋水，夜顯圓光，",
    "眞無掛染，性月昭彰。",
    "揚風三玄，岀始青，",
    "道玄觀天，天玄明象，",
    "象玄通眞，眞无坦蕩，",
    "恍惚之間，至清靈。",
    "微妙祥明，慧視無形，",
    "用之可妙，恍惚通靈。",
    "戲於飈臺，見赤生，",
    "嬰弄鳯飈，汞結隂消，",
    "閑來赤鳳，唯上青霄。",
    "逸域熙眞，養華榮，",
    "一棹神舟，三島瀛洲，",
    "廻觀世夢，吟笑無休。",
    "内盼沉默，鍊五形，",
    "華胥異景，至性觀天，",
    "三陽相會，二氣朝元。",
    "三氣徘徊，得神明，",
    "三耀明眞，其用不勤，",
    "神仙也厭，世事紛紛。",
    "隱龍遯芝，雲琅英，",
    "仙擎寶芝，引虎調龍，",
    "行圓岀世，妙隱三峯。",
    "可以充飢，使萬靈，",
    "勤服靈芝，道養嬰兒，",
    "元神唯顯，内禮眞師。",
    "上蓋玄玄，下虎章，",
    "祥煙成蓋，至性澄觀，",
    "龍蟠元海，虎繞靈山。",
    "沭浴章第三十六",
    "沭浴盛潔，棄肥薫，",
    "洗開道眼，體掛銖衣，",
    "水雲信任，不羡輕肥。",
    "入室東向，誦玉篇，",
    "閑居宫室，至德眞一，",
    "悟徹千經，忘言了畢。",
    "約得萬徧，義自鮮，",
    "玉訣金聲，萬徧通靈，",
    "功成九轉，跨鶴飛昇。",
    "散髮無欲，以長存。",
    "眞心坦蕩，放曠林泉，",
    "玉壺之內，别有陽天。",
    "五味皆去，正氣還，",
    "意遠肥甘，自通道味，",
    "内養元神，冲和一氣。",
    "夷心寂悶，勿煩冤，",
    "絶慮忘言，自然大定，",
    "住世居山，内無動靜。",
    "過數巳畢，體神精，",
    "日徃月来，險陽有數，",
    "道顯神明，全慿開悟。",
    "黄華玉女，吿子情，",
    "黄婆匹配，嬰姹團圓，",
    "靜清祥耀，産箇胎仙。",
    "眞人旣至，使六丁，",
    "力士天丁，常護眞靈，",
    "隂魔奔散，陽耀成形。",
    "即授隱芝，大洞經，",
    "眞仙之授，太上之經，",
    "人間闡度，悟者超昇。",
    "十讀四拜，朝太上，",
    "十極誦經，四方禮拜，",
    "賢聖虛空，衆生苦海。",
    "先謁大帝，後北向，",
    "後有金眞，来朝大帝，",
    "蓬島瀛洲，群仙列位。",
    "黃庭内經，玉書暢，",
    "黄庭聖降，玉訣眞經，",
    "理明萬化，妙道無形。",
    "授者曰師，受者盟，",
    "黙傳聖道，玄祖盟約，",
    "聖達頓明，賢悟漸博。",
    "雲錦鳯羅，金鈕纏，",
    "仙裳體掛，鳳遶龍蟠，",
    "金緾九九，降闕淸歡，",
    "以代割髮，肌盧全，",
    "太上古貌，玉體冰肌，",
    "顏如童稚，皓髪眉斉，",
    "携手登山，歃液丹。",
    "鍊成七返，修就九還，",
    "形神妙逹，霞友登山。",
    "金書玉景，乃可宣，",
    "聖人金訣，妙逹眞景，",
    "雲散天青，蟾光如鏡。",
    "傳得可授，告三官，",
    "三元功畢，上達三官，",
    "眞同聖意，名列仙班。",
    "勿令七祖，受冥患，",
    "出家退道，七祖冥愆，",
    "一子了道，玄祖生天。",
    "太上微言，致神仙，",
    "神通萬法，大遠希夷，",
    "無爲德訣，暗合天機。",
    "下死之道，此其文，",
    "碧霄至聖，今古常新，",
    "母養赤子，不死之門。",
    "黄庭內景玉經註(終)"
   ]
  }
