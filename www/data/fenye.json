  "divergences": [
    {
      "id": "D1",
      "topic": "实沈国名：晋 / 魏",
      "detail": "晋书系诸表多作「晋」（《春明梦余录》、叶时说同），一本作「魏」；晋即魏之旧封（觜、参为晋星，汉志作魏地），指同一地。本数据取「晋」为主、并存「魏」。"
    },
    {
      "id": "D2",
      "topic": "实沈配州益州，与晋地不合",
      "detail": "晋在北方（今山西），益州在西南（今四川一带），国与州大相悬绝；宋叶时已指出「魏分晋地，与益州亦不相关」，后世或归咎李淳风配郡之误。此为分野体系著名疑点，现代对应以国故地为主读法、州属并录。"
    },
    {
      "id": "D3",
      "topic": "娵訾配州并州，与卫故地不合",
      "detail": "卫受封河内，故地在冀、兖之间（今豫北、冀南），与并州（今山西）不相涉；后世论者同以此为配属之误（出处同 D2）。"
    },
    {
      "id": "D4",
      "topic": "寿星国名：郑 / 陈",
      "detail": "通行作郑（兖州）；叶时《礼经会元》作「寿星，陈也」。陈、郑故地相邻（今豫中、豫东），本数据取郑、并存陈说。"
    },
    {
      "id": "D5",
      "topic": "汉志整宿制 vs 晋书度数制：女、柳、氐归属异",
      "detail": "汉志以整宿配国（女属越、柳属周、氐属韩）；晋书以度数分次，三宿皆跨界：女前七度在星纪、柳前八度在鹑首、氐前四度在寿星。主属按晋书度数过半定，汉志说逐条并录于各宿 hanshu_dilizhi。"
    },
    {
      "id": "D6",
      "topic": "汉志缺胃宿",
      "detail": "《汉书·地理志上》分野诸条遍及二十七宿，独胃无所属；胃之分野唯待晋书度数制（前六度降娄、后八度大梁）。"
    },
    {
      "id": "D7",
      "topic": "吴、越分工与后世合称异",
      "detail": "汉志分言：吴主斗、越（粤）主牵牛婺女（《初学记》引可证）；晋书星纪则合称吴越、辖斗牛女天区。后世简表多合并为「吴越·斗牛女」，与汉志分工不同。"
    },
    {
      "id": "D8",
      "topic": "郑玄《周礼》注九州配宿为另一体系",
      "detail": "郑注保章氏之分以两宿（或一组）配一州：角亢氐兖州、房心豫州、尾箕幽州、斗牛女扬州、虚危青州、室壁并州、娄胃徐州、昴毕冀州、觜参益州、井鬼雍州、柳星张翼轸荆州——与十二次体系并行而不同（如觜参在此属益州，与实沈配益州隐相呼应；娄胃属徐州则合降娄之鲁）。本数据以晋书十二次为主本，此系仅志于此备考。"
    },
    {
      "id": "D9",
      "topic": "分度诸家先后小异",
      "detail": "费直《周易》分野、班固《汉志》、蔡邕《月令章句》、陈卓、李淳风、一行诸家，郑樵总评「大同小异」；蔡邕以二十四气日躔之度立分，与宿度分次法门不同；费直说后世不施用。今行度数从晋书所载陈卓系，起讫一度之差的版本异文（如危十五/十六度交界）不另立条，遇跨界以本表为准并注。"
    }
  ],
  "inheritance_rule": {
    "rule": "星官随本宿继承分野：xingguan.json 中每座星官隶属一宿（图鉴按宿分区），其分野即该宿的分野（次＋国＋州），不逐星官另判。",
    "basis": "分野的最小配属单位在晋书体系是「次」（以宿度划界），在汉志体系是「宿」（整宿配国）；两系皆无逐星官配分野的正文。故星官一律随宿，是文献口径而非权宜。",
    "cross_ci_handling": "跨次之宿（12 宿）的星官仍随宿主属展示；在宿条 ci_span 中给出两段度数，界面可在宿页注明「本宿前段属某次」，但不下沉到单座星官逐个判度——本数据不含星官的宿内古度坐标，逐官判度即属无据，不为。",
    "primary_rule": "宿主属以《晋书》度数过半者定；尾宿两分各半，从通行整宿配次表作析木；女、柳二宿与汉志/通行整宿表异，逐条注记（见 D5）。"
  },
  "sanguan_exception": {
    "rule": "三垣（紫微垣、太微垣、天市垣）诸星官不入分野体系，不配国、州。",
    "basis": "《晋书·天文志上》分野正文专行于十二次所辖二十八宿天区；三垣为天帝宫廷与天市之象，体制属「宫垣」而非「分野」。汉志诸地条目所配亦皆二十八宿，无一语及三垣。",
    "ziwei_zhongzhou": "后世说法存录：紫微垣居天中央、为大帝之座（《晋书·天文志上》语），星占家与明清分野图有比附王畿/中州者，属象征引申——正史天文志无「紫微垣配中州」的分野明文。本数据不立条、不配属，仅在此存其说，以待考。"
  }
}