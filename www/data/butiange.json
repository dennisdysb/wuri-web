   "section": "紫微垣",
   "line_count": 54,
   "lines": [
    {
     "text": "中元北极紫微宫",
     "asterism": "北极",
     "kind": "星官句"
    },
    {
     "text": "北极五星在其中",
     "asterism": "北极",
     "kind": "星官句"
    },
    {
     "text": "大帝之座第二珠",
     "asterism": "北极",
     "kind": "星官句"
    },
    {
     "text": "第三之星庶子居",
     "asterism": "北极",
     "kind": "星官句"
    },
    {
     "text": "第一号曰为太子",
     "asterism": "北极",
     "kind": "星官句"
    },
    {
     "text": "四为后宫五天枢",
     "asterism": "北极",
     "kind": "星官句"
    },
    {
     "text": "左右四星是四辅",
     "asterism": "四辅",
     "kind": "星官句"
    },
    {
     "text": "天乙太乙当门路",
     "asterism": "天乙、太乙",
     "kind": "星官句"
    },
    {
     "text": "左枢右枢夹南门",
     "asterism": "紫微左垣",
     "kind": "星官句"
    },
    {
     "text": "两面营卫一十五",
     "asterism": "紫微左垣",
     "kind": "星官句"
    },
    {
     "text": "东藩左枢连上宰",
     "asterism": "紫微左垣",
     "kind": "星官句"
    },
    {
     "text": "少宰上辅次少辅",
     "asterism": "紫微左垣",
     "kind": "星官句"
    },
    {
     "text": "上卫少卫次上丞",
     "asterism": "紫微左垣",
     "kind": "星官句"
    },
    {
     "text": "后门东边大赞府",
     "asterism": "紫微左垣",
     "kind": "星官句"
    },
    {
     "text": "西藩右枢次少尉",
     "asterism": "紫微右垣",
     "kind": "星官句"
    },
    {
     "text": "上辅少辅四相视",
     "asterism": "紫微右垣",
     "kind": "星官句"
    },
    {
     "text": "上卫少卫七少丞",
     "asterism": "紫微右垣",
     "kind": "星官句"
    },
    {
     "text": "以次却向前门数",
     "asterism": "紫微右垣",
     "kind": "星官句"
    },
    {
     "text": "阴德门星两黄聚",
     "asterism": "阴德",
     "kind": "星官句"
    },
    {
     "text": "尚书以次其位五",
     "asterism": "尚书",
     "kind": "星官句"
    },
    {
     "text": "女史柱史各一户",
     "asterism": "女史、柱史",
     "kind": "星官句"
    },
    {
     "text": "御女四星五天柱",
     "asterism": "御女、天柱",
     "kind": "星官句"
    },
    {
     "text": "大理两星阴德边",
     "asterism": "大理",
     "kind": "星官句"
    },
    {
     "text": "勾陈尾指北极巅",
     "asterism": "勾陈",
     "kind": "星官句"
    },
    {
     "text": "六甲六星勾陈前",
     "asterism": "六甲",
     "kind": "星官句"
    },
    {
     "text": "天皇独在勾陈里",
     "asterism": "天皇大帝",
     "kind": "星官句"
    },
    {
     "text": "五帝内座后门间",
     "asterism": "五帝内座",
     "kind": "星官句"
    },
    {
     "text": "华盖并杠十六星",
     "asterism": "华盖、杠",
     "kind": "星官句"
    },
    {
     "text": "杠作柄象华盖形",
     "asterism": "华盖、杠",
     "kind": "星官句"
    },
    {
     "text": "盖上连连九个星",
     "asterism": "传舍",
     "kind": "星官句"
    },
    {
     "text": "名曰传舍如连丁",
     "asterism": "传舍",
     "kind": "星官句"
    },
    {
     "text": "垣外左右各六珠",
     "asterism": "内阶、天厨",
     "kind": "星官句"
    },
    {
     "text": "右是内阶左天厨",
     "asterism": "内阶、天厨",
     "kind": "星官句"
    },
    {
     "text": "阶前八星名八谷",
     "asterism": "八谷",
     "kind": "星官句"
    },
    {
     "text": "厨下五个天棓宿",
     "asterism": "天棓",
     "kind": "星官句"
    },
    {
     "text": "天床六星左枢右",
     "asterism": "天床",
     "kind": "星官句"
    },
    {
     "text": "内厨两星右枢对",
     "asterism": "内厨",
     "kind": "星官句"
    },
    {
     "text": "文昌斗上半月形",
     "asterism": "文昌",
     "kind": "星官句"
    },
    {
     "text": "稀疏分明六个星",
     "asterism": "文昌",
     "kind": "星官句"
    },
    {
     "text": "文昌之下曰三公",
     "asterism": "三公",
     "kind": "星官句"
    },
    {
     "text": "更有三公向西偏",
     "asterism": "三公",
     "kind": "星官句"
    },
    {
     "text": "太尊只向三公明",
     "asterism": "太尊",
     "kind": "星官句"
    },
    {
     "text": "天牢六星太尊边",
     "asterism": "天牢",
     "kind": "星官句"
    },
    {
     "text": "太阳之守四势前",
     "asterism": "势",
     "kind": "星官句"
    },
    {
     "text": "一个宰相太阳侧",
     "asterism": "宰相",
     "kind": "星官句"
    },
    {
     "text": "即是玄戈一星圆",
     "asterism": "玄戈",
     "kind": "星官句"
    },
    {
     "text": "天理四星斗里暗",
     "asterism": "天理",
     "kind": "星官句"
    },
    {
     "text": "北斗之宿七星明",
     "asterism": "北斗",
     "kind": "星官句"
    },
    {
     "text": "第一主帝名枢精",
     "asterism": "北斗",
     "kind": "星官句"
    },
    {
     "text": "第二第三璇玑是",
     "asterism": "北斗",
     "kind": "星官句"
    },
    {
     "text": "第四名权第五衡",
     "asterism": "北斗",
     "kind": "星官句"
    },
    {
     "text": "开阳摇光六七名",
     "asterism": "北斗",
     "kind": "星官句"
    },
    {
     "text": "辅星近著开阳淡",
     "asterism": "辅",
     "kind": "星官句"
    },
    {
     "text": "摇光左三天枪明",
     "asterism": "天枪",
     "kind": "星官句"
    }
   ]
  },
  {
   "section": "太微垣",
   "line_count": 24,
   "lines": [
    {
     "text": "上元天庭太微宫",
     "asterism": "太微左垣",
     "kind": "星官句"
    },
    {
     "text": "昭昭列象布苍穹",
     "asterism": "太微左垣",
     "kind": "星官句"
    },
    {
     "text": "端门只是门之中",
     "asterism": "太微左垣",
     "kind": "星官句"
    },
    {
     "text": "左右执法门西东",
     "asterism": "太微左垣、太微右垣",
     "kind": "星官句"
    },
    {
     "text": "两面宫垣十星布",
     "asterism": "太微左垣、太微右垣",
     "kind": "星官句"
    },
    {
     "text": "左右执法是其数",
     "asterism": "太微左垣、太微右垣",
     "kind": "星官句"
    },
    {
     "text": "门左皂衣一谒者",
     "asterism": "谒者",
     "kind": "星官句"
    },
    {
     "text": "以次即是乌三公",
     "asterism": "三公",
     "kind": "星官句"
    },
    {
     "text": "三黑九卿公背旁",
     "asterism": "九卿",
     "kind": "星官句"
    },
    {
     "text": "五黑诸侯卿后行",
     "asterism": "五诸侯",
     "kind": "星官句"
    },
    {
     "text": "四个门西主轩屏",
     "asterism": "内屏",
     "kind": "星官句"
    },
    {
     "text": "五帝内座于中正",
     "asterism": "五帝座",
     "kind": "星官句"
    },
    {
     "text": "幸臣太子并从官",
     "asterism": "幸臣、太子、从官",
     "kind": "星官句"
    },
    {
     "text": "乌列帝后从东定",
     "asterism": "幸臣、太子、从官",
     "kind": "星官句"
    },
    {
     "text": "郎将虎贲居左右",
     "asterism": "虎贲、郎将",
     "kind": "星官句"
    },
    {
     "text": "常陈郎位居其后",
     "asterism": "常陈、郎位",
     "kind": "星官句"
    },
    {
     "text": "常陈七星不相误",
     "asterism": "常陈",
     "kind": "星官句"
    },
    {
     "text": "郎位陈东一十五",
     "asterism": "郎位",
     "kind": "星官句"
    },
    {
     "text": "宫外明堂布政宫",
     "asterism": "明堂",
     "kind": "星官句"
    },
    {
     "text": "三个灵台候云雨",
     "asterism": "灵台",
     "kind": "星官句"
    },
    {
     "text": "少微四星西北隅",
     "asterism": "少微",
     "kind": "星官句"
    },
    {
     "text": "长垣双双微西居",
     "asterism": "长垣",
     "kind": "星官句"
    },
    {
     "text": "北门西外接三台",
     "asterism": "三台",
     "kind": "星官句"
    },
    {
     "text": "与垣相对无兵灾",
     "asterism": "三台",
     "kind": "星官句"
    }
   ]
  },
  {
   "section": "天市垣",
   "line_count": 31,
   "lines": [
    {
     "text": "下元一宫名天市",
     "asterism": "天市左垣、天市右垣",
     "kind": "星官句"
    },
    {
     "text": "两扇垣墙二十二",
     "asterism": "天市左垣、天市右垣",
     "kind": "星官句"
    },
    {
     "text": "当门六角黑市楼",
     "asterism": "市楼",
     "kind": "星官句"
    },
    {
     "text": "门左两星是车肆",
     "asterism": "车肆",
     "kind": "星官句"
    },
    {
     "text": "两个宗正四宗人",
     "asterism": "宗正、宗人",
     "kind": "星官句"
    },
    {
     "text": "宗星一双亦依次",
     "asterism": "宗",
     "kind": "星官句"
    },
    {
     "text": "帛度两星屠肆前",
     "asterism": "帛度、屠肆",
     "kind": "星官句"
    },
    {
     "text": "候星还在帝座边",
     "asterism": "候",
     "kind": "星官句"
    },
    {
     "text": "帝座一星常光明",
     "asterism": "帝座",
     "kind": "星官句"
    },
    {
     "text": "四个微茫宦者星",
     "asterism": "宦者",
     "kind": "星官句"
    },
    {
     "text": "以次两星名列肆",
     "asterism": "列肆",
     "kind": "星官句"
    },
    {
     "text": "斗斛帝前依其次",
     "asterism": "斗、斛",
     "kind": "星官句"
    },
    {
     "text": "斗是五星斛是四",
     "asterism": "斗、斛",
     "kind": "星官句"
    },
    {
     "text": "垣北九个贯索星",
     "asterism": "贯索",
     "kind": "星官句"
    },
    {
     "text": "索口横者七公成",
     "asterism": "七公",
     "kind": "星官句"
    },
    {
     "text": "天纪恰似七公形",
     "asterism": "天纪",
     "kind": "星官句"
    },
    {
     "text": "数著分明多两星",
     "asterism": "天纪",
     "kind": "星官句"
    },
    {
     "text": "纪北三星名女床",
     "asterism": "女床",
     "kind": "星官句"
    },
    {
     "text": "此坐还依织女傍",
     "asterism": "女床",
     "kind": "星官句"
    },
    {
     "text": "三元之像无相侵",
     "asterism": null,
     "kind": "结构句"
    },
    {
     "text": "二十八宿随其阴",
     "asterism": null,
     "kind": "结构句"
    },
    {
     "text": "水火木土与并金",
     "asterism": null,
     "kind": "结构句"
    },
    {
     "text": "以次别有五行吟",
     "asterism": null,
     "kind": "结构句"
    },
    {
     "text": "河中河间晋郑周",
     "asterism": "天市右垣",
     "kind": "星官句"
    },
    {
     "text": "秦连巴蜀细搜求",
     "asterism": "天市右垣",
     "kind": "星官句"
    },
    {
     "text": "十一星属十一国",
     "asterism": "天市左垣、天市右垣",
     "kind": "星官句"
    },
    {
     "text": "梁楚韩邦在尽头",
     "asterism": "天市右垣",
     "kind": "星官句"
    },
    {
     "text": "魏赵九河与中山",
     "asterism": "天市左垣",
     "kind": "星官句"
    },
    {
     "text": "齐越吴徐东海间",
     "asterism": "天市左垣",
     "kind": "星官句"
    },
    {
     "text": "燕连南海尽属宋",
     "asterism": "天市左垣",
     "kind": "星官句"
    },
    {
     "text": "请君熟记有何难",
     "asterism": null,
     "kind": "结构句"
    }
   ]
  },
  {
   "section": "角宿",
   "line_count": 13,
   "lines": [
    {
     "text": "南北两星正直悬",
     "asterism": "角",
     "kind": "星官句"
    },
    {
     "text": "中有平道上天田",
     "asterism": "平道、天田",
     "kind": "星官句"
    },
    {
     "text": "平道右畔独渊然",
     "asterism": "平道、进贤",
     "kind": "星官句"
    },
    {
     "text": "总是黑星两相连",
     "asterism": "天田",
     "kind": "星官句"
    },
    {
     "text": "别有一乌名进贤",
     "asterism": "进贤",
     "kind": "星官句"
    },
    {
     "text": "最上三星周鼎形",
     "asterism": "周鼎",
     "kind": "星官句"
    },
    {
     "text": "角下天门左平星",
     "asterism": "天门、平",
     "kind": "星官句"
    },
    {
     "text": "双双横于库楼上",
     "asterism": "天门、平",
     "kind": "星官句"
    },
    {
     "text": "库楼十星屈曲明",
     "asterism": "库楼",
     "kind": "星官句"
    },
    {
     "text": "楼中柱有十五星",
     "asterism": "库楼、柱",
     "kind": "星官句"
    },
    {
     "text": "三三相著如鼎形",
     "asterism": "库楼、柱",
     "kind": "星官句"
    },
    {
     "text": "其中四星别名衡",
     "asterism": "衡",
     "kind": "星官句"
    },
    {
     "text": "南门楼外两星横",
     "asterism": "南门",
     "kind": "星官句"
    }
   ]
  },
  {
   "section": "亢宿",
   "line_count": 9,
   "lines": [
    {
     "text": "四星恰似弯弓状",
     "asterism": "亢",
     "kind": "星官句"
    },
    {
     "text": "大角一星直上明",
     "asterism": "大角",
     "kind": "星官句"
    },
    {
     "text": "折威七子亢下横",
     "asterism": "折威",
     "kind": "星官句"
    },
    {
     "text": "大角左右摄提星",
     "asterism": "左摄提、右摄提",
     "kind": "星官句"
    },
    {
     "text": "三三相对如鼎形",
     "asterism": "左摄提、右摄提",
     "kind": "星官句"
    },
    {
     "text": "折威下左顿顽星",
     "asterism": "顿顽",
     "kind": "星官句"
    },
    {
     "text": "两个斜安黄色精",
     "asterism": "顿顽",
     "kind": "星官句"
    },
    {
     "text": "顽西二星号阳门",
     "asterism": "阳门",
     "kind": "星官句"
    },
    {
     "text": "色若顿顽直下存",
     "asterism": "阳门",
     "kind": "星官句"
    }
   ]
  },
  {
   "section": "氐宿",
   "line_count": 14,
   "lines": [
    {
     "text": "四星似斗侧量米",
     "asterism": "氐",
     "kind": "星官句"
    },
    {
     "text": "天乳氐上黑一星",
     "asterism": "天乳",
     "kind": "星官句"
    },
    {
     "text": "世上不识称无名",
     "asterism": "天乳",
     "kind": "星官句"
    },
    {
