{"sid": "s04", "voice": "male", "total_duration": 690.58, "segments": [{"para": 0, "start": 0.0, "duration": 2.43, "text": "太上玄灵北斗本命延生真经"}, {"para": 1, "start": 2.43, "duration": 1.23, "text": "开经玄蕴咒"}, {"para": 2, "start": 3.66, "duration": 2.85, "text": "寂寂至无宗。虚峙劫仞阿。"}, {"para": 3, "start": 6.5, "duration": 3.13, "text": "豁落洞玄文。谁测此幽遐。"}, {"para": 4, "start": 9.64, "duration": 2.9, "text": "一入大乘路。孰计年劫多。"}, {"para": 5, "start": 12.54, "duration": 2.85, "text": "不生亦不灭。欲生因莲花。"}, {"para": 6, "start": 15.39, "duration": 2.98, "text": "超凌三界途。慈心解世罗。"}, {"para": 7, "start": 18.36, "duration": 2.95, "text": "真人无上德。世世为仙家。"}, {"para": 8, "start": 21.32, "duration": 3.4, "text": "尔时太上老君以永寿元年正月七日。"}, {"para": 9, "start": 24.71, "duration": 4.23, "text": "在太清境上。太极宫中。观见众生亿劫漂沉。"}, {"para": 10, "start": 28.94, "duration": 6.11, "text": "周回生死。或居人道。生在中华。或生夷狄之中。或生蛮戎之内。"}, {"para": 11, "start": 35.06, "duration": 5.46, "text": "或富或贵。或贱或贫。暂假因缘。堕于地狱。为无定故。"}, {"para": 12, "start": 40.51, "duration": 4.94, "text": "罪业牵缠。魂系阴司。受苦满足。人道将违。"}, {"para": 13, "start": 45.45, "duration": 3.21, "text": "生居畜兽之中。或生禽虫之属。"}, {"para": 14, "start": 48.66, "duration": 5.88, "text": "转乖人道。难复人身。如此沉沦。不知自觉。"}, {"para": 15, "start": 54.54, "duration": 3.13, "text": "为先世迷真之故。受此轮回。"}, {"para": 16, "start": 57.68, "duration": 3.97, "text": "乃以哀悯之心。分身教化。化身下降。"}, {"para": 17, "start": 61.65, "duration": 4.81, "text": "至于蜀都。地神涌出。扶一玉局。而作高座。"}, {"para": 18, "start": 66.45, "duration": 3.92, "text": "于是老君升玉局坐。授与天师北斗本命经诀。"}, {"para": 19, "start": 70.37, "duration": 2.85, "text": "广宣要法。普济众生。"}, {"para": 20, "start": 73.22, "duration": 1.88, "text": "是时老君告天师曰。"}, {"para": 21, "start": 75.1, "duration": 4.81, "text": "人身难得。中土难生。假使得生。正法难遇。"}, {"para": 22, "start": 79.91, "duration": 5.9, "text": "多迷真道。多入邪宗。多种罪根。多肆巧诈。"}, {"para": 23, "start": 85.81, "duration": 4.47, "text": "多恣淫杀。多好群情。多纵贪嗔。多沉地狱。"}, {"para": 24, "start": 90.28, "duration": 1.96, "text": "多失人身。"}, {"para": 25, "start": 92.24, "duration": 4.21, "text": "如此等缘。众生不悟。不知正道。迷惑者多。"}, {"para": 26, "start": 96.44, "duration": 3.4, "text": "我今哀见此等众生。故垂法教。"}, {"para": 27, "start": 99.84, "duration": 4.15, "text": "为说良缘。令使知道。知身性命。皆凭道生。"}, {"para": 28, "start": 103.99, "duration": 4.75, "text": "了悟此因。长生人道。种子不绝。世世为人。"}, {"para": 29, "start": 108.75, "duration": 2.85, "text": "不生无道之乡。不断人之根本。"}, {"para": 30, "start": 111.59, "duration": 4.86, "text": "更能心修正道。渐入仙宗。永离轮回。超升成道。"}, {"para": 31, "start": 116.45, "duration": 5.36, "text": "我故示汝妙法。令度天民归真知命。可以本命之日修斋设醮。"}, {"para": 32, "start": 121.81, "duration": 5.22, "text": "启祝北斗。三官五帝。九府四司。荐福消灾。"}, {"para": 33, "start": 127.03, "duration": 4.86, "text": "奏章恳愿。虔诚献礼。种种香花。时新五果。"}, {"para": 34, "start": 131.89, "duration": 4.75, "text": "随世威仪。清净坛宇。法天象地。或于观宇。"}, {"para": 35, "start": 136.64, "duration": 4.75, "text": "或在家庭。随力建功。请行法事。功德深重。"}, {"para": 36, "start": 141.4, "duration": 1.28, "text": "不可具陈。"}, {"para": 37, "start": 142.68, "duration": 3.03, "text": "念此大圣北斗七元真君名号。"}, {"para": 38, "start": 145.71, "duration": 5.17, "text": "当得罪业消除。灾愆洗荡。福寿资命。善果臻身。"}, {"para": 39, "start": 150.88, "duration": 3.92, "text": "凡有急难。可以焚香诵经。克期安泰。"}, {"para": 40, "start": 154.8, "duration": 2.3, "text": "于是大圣北斗解厄应验曰。"}, {"para": 41, "start": 157.1, "duration": 2.9, "text": "大圣北斗七元君。能解三灾厄。"}, {"para": 42, "start": 160.0, "duration": 3.08, "text": "大圣北斗七元君。能解四杀厄。"}, {"para": 43, "start": 163.08, "duration": 3.63, "text": "大圣北斗七元君。能解五行厄。"}, {"para": 44, "start": 166.71, "duration": 3.21, "text": "大圣北斗七元君。能解六害厄。"}, {"para": 45, "start": 169.92, "duration": 3.13, "text": "大圣北斗七元君。能解七伤厄。"}, {"para": 46, "start": 173.06, "duration": 2.9, "text": "大圣北斗七元君。能解八难厄。"}, {"para": 47, "start": 175.96, "duration": 3.13, "text": "大圣北斗七元君。能解九星厄。"}, {"para": 48, "start": 179.09, "duration": 3.13, "text": "大圣北斗七元君。能解夫妻厄。"}, {"para": 49, "start": 182.23, "duration": 3.19, "text": "大圣北斗七元君。能解男女厄。"}, {"para": 50, "start": 185.41, "duration": 3.5, "text": "大圣北斗七元君。能解产生厄。"}, {"para": 51, "start": 188.91, "duration": 3.4, "text": "大圣北斗七元君。能解复连厄。"}, {"para": 52, "start": 192.31, "duration": 3.27, "text": "大圣北斗七元君。能解疫疠厄。"}, {"para": 53, "start": 195.57, "duration": 2.85, "text": "大圣北斗七元君。能解疾病厄。"}, {"para": 54, "start": 198.42, "duration": 3.03, "text": "大圣北斗七元君。能解精邪厄。"}, {"para": 55, "start": 201.45, "duration": 2.85, "text": "大圣北斗七元君。能解虎狼厄。"}, {"para": 56, "start": 204.3, "duration": 3.08, "text": "大圣北斗七元君。能解虫蛇厄。"}, {"para": 57, "start": 207.38, "duration": 3.55, "text": "大圣北斗七元君。能解劫贼厄。"}, {"para": 58, "start": 210.93, "duration": 3.13, "text": "大圣北斗七元君。能解枷棒厄。"}, {"para": 59, "start": 214.07, "duration": 3.08, "text": "大圣北斗七元君。能解横死厄。"}, {"para": 60, "start": 217.15, "duration": 2.95, "text": "大圣北斗七元君。能解咒誓厄。"}, {"para": 61, "start": 220.1, "duration": 2.95, "text": "大圣北斗七元君。能解天罗厄。"}, {"para": 62, "start": 223.05, "duration": 3.19, "text": "大圣北斗七元君。能解地网厄。"}, {"para": 63, "start": 226.24, "duration": 2.95, "text": "大圣北斗七元君。能解刀兵厄。"}, {"para": 64, "start": 229.19, "duration": 3.03, "text": "大圣北斗七元君。能解水火厄。"}, {"para": 65, "start": 232.22, "duration": 5.83, "text": "于是七元君。大圣善通灵。济度诸厄难。超出苦众生。"}, {"para": 66, "start": 238.05, "duration": 5.41, "text": "若有急告者。持诵保安平。尽凭生百幅。咸契于五行。"}, {"para": 67, "start": 243.46, "duration": 5.41, "text": "三魂得安健。邪魅不能停。五方降真气。万福自来骈。"}, {"para": 68, "start": 248.86, "duration": 5.17, "text": "长生超八难。皆由奉七星。生生身自在。世世保神清。"}, {"para": 69, "start": 254.03, "duration": 5.88, "text": "善似光中影。应如谷里声。三元神共护。万圣眼同明。"}, {"para": 70, "start": 259.91, "duration": 2.77, "text": "无灾亦无障。永保道心宁。"}, {"para": 71, "start": 262.68, "duration": 4.44, "text": "老君曰。北辰垂象。而众星拱之。"}, {"para": 72, "start": 267.12, "duration": 3.32, "text": "为造化之枢机。作人神之主宰。"}, {"para": 73, "start": 270.44, "duration": 3.6, "text": "宣威三界。统御万灵。"}, {"para": 74, "start": 274.04, "duration": 3.32, "text": "判人间善恶之期。司阴府是非之目。"}, {"para": 75, "start": 277.36, "duration": 2.53, "text": "五行共禀。七政同科。"}, {"para": 76, "start": 279.9, "duration": 3.5, "text": "有回死注生之功。有消灾度厄之力。"}, {"para": 77, "start": 283.4, "duration": 2.9, "text": "上至帝王。下及庶人。"}, {"para": 78, "start": 286.3, "duration": 3.13, "text": "尊卑虽则殊途。命分俱无差别。"}, {"para": 79, "start": 289.43, "duration": 4.75, "text": "凡夫在世迷谬者多。不知身属北斗。命由天府。"}, {"para": 80, "start": 294.18, "duration": 3.03, "text": "有灾有患。不知解谢之门。"}, {"para": 81, "start": 297.21, "duration": 2.79, "text": "祈福祈生。莫晓归依之路。"}, {"para": 82, "start": 300.01, "duration": 2.95, "text": "致使魂神被系。祸患来缠。"}, {"para": 83, "start": 302.96, "duration": 2.61, "text": "或重病不痊。或邪妖克害。"}, {"para": 84, "start": 305.57, "duration": 5.12, "text": "连年困笃。累岁迍邅。冢讼征呼。先亡复连。"}, {"para": 85, "start": 310.69, "duration": 5.12, "text": "或上天谴责。或下鬼诉诬。若以此危厄。如何救解。"}, {"para": 86, "start": 315.81, "duration": 5.3, "text": "须投告北斗。醮谢真君。及转真经。认本命真君。"}, {"para": 87, "start": 321.12, "duration": 4.34, "text": "方获安泰。已至康荣。更有深妙。不可尽述。"}, {"para": 88, "start": 325.45, "duration": 2.95, "text": "凡见北斗真形。顶礼恭敬。"}, {"para": 89, "start": 328.4, "duration": 4.21, "text": "北斗第一阳明贪狼太星君。"}, {"para": 90, "start": 332.61, "duration": 2.3, "text": "北斗第二阴精巨门元星君。"}, {"para": 91, "start": 334.91, "duration": 2.9, "text": "北斗第三真人禄存真星君。"}, {"para": 92, "start": 337.81, "duration": 3.19, "text": "北斗第四玄冥文曲纽星君。"}, {"para": 93, "start": 340.99, "duration": 3.27, "text": "北斗第五丹元帘贞网星君。"}, {"para": 94, "start": 344.26, "duration": 3.08, "text": "北斗第六北极武曲纪星君。"}, {"para": 95, "start": 347.34, "duration": 3.27, "text": "北斗第七天关破军关星君。"}, {"para": 96, "start": 350.61, "duration": 2.48, "text": "北斗第八洞明外辅星君。"}, {"para": 97, "start": 353.09, "duration": 2.72, "text": "北斗第九隐光内弼星君。"}, {"para": 98, "start": 355.81, "duration": 1.65, "text": "上台虚精开德真君。"}, {"para": 99, "start": 357.45, "duration": 1.88, "text": "中台六淳司空星君。"}, {"para": 100, "start": 359.33, "duration": 1.93, "text": "下台曲生司禄星君。"}, {"para": 101, "start": 361.26, "duration": 2.48, "text": "如是真君名号不可得闻。"}, {"para": 102, "start": 363.75, "duration": 5.12, "text": "凡有见闻。能持念者。皆道心深重。宿有善缘。"}, {"para": 103, "start": 368.87, "duration": 5.28, "text": "得闻持诵。其功德力莫可称量。若正信男女值此真经。"}, {"para": 104, "start": 374.14, "duration": 5.41, "text": "智慧性圆。道心开发。出群迷迳。入希夷门。"}, {"para": 105, "start": 379.55, "duration": 4.88, "text": "归奉真宗。达生荣界。于三元八节。本命生辰。"}, {"para": 106, "start": 384.43, "duration": 5.36, "text": "北斗下日。严置坛场。转经斋醮。依仪行道。"}, {"para": 107, "start": 389.79, "duration": 5.41, "text": "其福无边。世世生生。不违真性。不入邪见。"}, {"para": 108, "start": 395.2, "duration": 3.79, "text": "持经之人。常持诵七元真君所属尊号。"}, {"para": 109, "start": 398.98, "duration": 2.43, "text": "善功圆满。亦降吉祥。"}, {"para": 110, "start": 401.41, "duration": 2.12, "text": "即说北斗咒曰。"}, {"para": 111, "start": 403.53, "duration": 4.62, "text": "北斗九辰。中天大神。上朝金阙。下覆昆仑。"}, {"para": 112, "start": 408.15, "duration": 4.65, "text": "调理纲纪。统制乾坤。大魁贪狼。巨门禄存。"}, {"para": 113, "start": 412.8, "duration": 4.75, "text": "文曲廉贞。武曲破军。高上玉皇。紫微帝君。"}, {"para": 114, "start": 417.56, "duration": 5.46, "text": "大周天界。细入微尘。何灾不灭。何福不臻。"}, {"para": 115, "start": 423.02, "duration": 5.41, "text": "元皇正气。来合我身。天罡所指。昼夜常轮。"}, {"para": 116, "start": 428.42, "duration": 4.88, "text": "俗居小人。好道求灵。愿见尊仪。永保长生。"}, {"para": 117, "start": 433.31, "duration": 5.54, "text": "三台虚精。六淳曲生。生我养我。护我身形。"}, {"para": 118, "start": 438.85, "duration": 4.52, "text": "魁（秘）（秘）䰢魓（秘）魒尊帝。急急如律令。"}, {"para": 119, "start": 443.37, "duration": 1.23, "text": "老君曰。"}, {"para": 120, "start": 444.59, "duration": 4.21, "text": "凡人性命五体。悉属本命星官之所主掌。"}, {"para": 121, "start": 448.8, "duration": 4.21, "text": "本命神将。本宿星官。常垂荫佑。"}, {"para": 122, "start": 453.0, "duration": 4.52, "text": "主持人命。使保天年。凡俗无知。终身不悟。"}, {"para": 123, "start": 457.52, "duration": 5.04, "text": "夫本命真君。每岁六度降在人间。降日为本命限期，"}, {"para": 124, "start": 462.57, "duration": 3.6, "text": "有南陵使者三千人。北斗真君七千神将。"}, {"para": 125, "start": 466.17, "duration": 2.98, "text": "本命真官降驾。众真悉来拥护。"}, {"para": 126, "start": 469.15, "duration": 6.61, "text": "可以消灾忏罪。请福延生。随力章醮。福德增崇。"}, {"para": 127, "start": 475.76, "duration": 4.81, "text": "其有本命限期将至。自身不知。不设斋醮。不修香火。"}, {"para": 128, "start": 480.56, "duration": 1.51, "text": "此为轻生迷本。"}, {"para": 129, "start": 482.08, "duration": 4.94, "text": "不贵人身。天司夺禄减算除年。多致夭丧。迷误之者。"}, {"para": 130, "start": 487.02, "duration": 4.86, "text": "虽遇经诀。怀不信心。毁谤真文。如此之人。"}, {"para": 131, "start": 491.87, "duration": 4.7, "text": "身谢之后。沦没三涂。漂沉诸趣。永失人身。"}, {"para": 132, "start": 496.58, "duration": 5.3, "text": "深可悲哀。自致斯苦。若本命之日。能修斋醮。"}, {"para": 133, "start": 501.88, "duration": 4.81, "text": "善达天司。一时于本命限期间。开转真经。"}, {"para": 134, "start": 506.69, "duration": 5.07, "text": "广陈供养。使三生常为男子身。富贵聪明。"}, {"para": 135, "start": 511.75, "duration": 4.34, "text": "人中殊胜。其有生身果薄。虽在人中。"}, {"para": 136, "start": 516.09, "duration": 4.39, "text": "贫穷下贱。纵知本命无力修崇。能酌水献花。"}, {"para": 137, "start": 520.48, "duration": 4.75, "text": "冥心望北极。稽首礼拜。念本命星君名号者。"}, {"para": 138, "start": 525.23, "duration": 4.57, "text": "亦不虚过本命限期。皆得延生注福。系系人身。"}, {"para": 139, "start": 529.8, "duration": 4.21, "text": "灾厄蠲除。获福无量。天师欢喜。踊跃作礼。"}, {"para": 140, "start": 534.01, "duration": 2.9, "text": "赞叹难可得遇无上法桥。"}, {"para": 141, "start": 536.91, "duration": 4.47, "text": "老君重告天师曰。世人罪福善恶皆属天司。"}, {"para": 142, "start": 541.38, "duration": 5.96, "text": "忏罪消灾莫越修奉。遇本命生辰。告身中元辰驿马。"}, {"para": 143, "start": 547.33, "duration": 3.13, "text": "削落三灾九厄。保现今眷属安宁。"}, {"para": 144, "start": 550.47, "duration": 5.04, "text": "凡有上士于本命生辰。持此真文者。外伏魔精。"}, {"para": 145, "start": 555.51, "duration": 4.62, "text": "内安真性。功沾水陆。善及存亡。悔过虔恭。"}, {"para": 146, "start": 560.13, "duration": 4.75, "text": "渐登妙果。重立玄功。证虚无道。乃得圣智圆通。"}, {"para": 147, "start": 564.88, "duration": 4.75, "text": "隐显莫测。出有入无。逍遥云际。升入金门。"}, {"para": 148, "start": 569.64, "duration": 4.81, "text": "与圣合真。身超三界。永不轮转。寿量无穷。"}, {"para": 149, "start": 574.45, "duration": 5.22, "text": "快乐自在。凡有男女。于本命生辰。及诸斋日。"}, {"para": 150, "start": 579.67, "duration": 5.12, "text": "清静身心。焚香持此真文。自认北极本命所属星君。"}, {"para": 151, "start": 584.79, "duration": 4.62, "text": "随心祷祝。善无不应。灾罪消除。致感万圣千真。"}, {"para": 152, "start": 589.41, "duration": 5.41, "text": "俱来卫护。此文所在之处。千真敬礼。万圣护持。"}, {"para": 153, "start": 594.82, "duration": 5.3, "text": "魔鬼潜消。精灵伏匿。世有灾殃。悉皆消灭。"}, {"para": 154, "start": 600.12, "duration": 4.21, "text": "是名北斗本命延生经诀。乃修真之迳路。"}, {"para": 155, "start": 604.33, "duration": 4.15, "text": "得道逍遥皆因此经。证圣成真皆因此经。"}, {"para": 156, "start": 608.48, "duration": 3.68, "text": "出离生死皆因此经。保护男女皆因此经。"}, {"para": 157, "start": 612.17, "duration": 4.44, "text": "保命延生皆得自在。永为身宝。福寿可称。"}, {"para": 158, "start": 616.61, "duration": 2.77, "text": "保而敬之。非人勿示。"}, {"para": 159, "start": 619.38, "duration": 4.44, "text": "老君说经将毕。龙鹤天仙来迎。还于玉京。"}, {"para": 160, "start": 623.82, "duration": 4.1, "text": "是时天师受得妙法。而作是言。誓愿流行。"}, {"para": 161, "start": 627.92, "duration": 3.08, "text": "以传善士。若有男女受持读诵。"}, {"para": 162, "start": 631.0, "duration": 3.21, "text": "我当与十戒仙官所在拥护。于是再拜"}, {"para": 163, "start": 634.21, "duration": 2.19, "text": "老君而说赞曰。"}, {"para": 164, "start": 636.41, "duration": 3.27, "text": "家有北斗经。本命降真灵。"}, {"para": 165, "start": 639.67, "duration": 2.61, "text": "家有北斗经。宅舍得安宁。"}, {"para": 166, "start": 642.28, "duration": 2.66, "text": "家有北斗经。父母保长生。"}, {"para": 167, "start": 644.95, "duration": 2.98, "text": "家有北斗经。诸厌化为尘。"}, {"para": 168, "start": 647.93, "duration": 2.77, "text": "家有北斗经。万邪自归正。"}, {"para": 169, "start": 650.7, "duration": 3.19, "text": "家有北斗经。营业得称情。"}, {"para": 170, "start": 653.88, "duration": 3.03, "text": "家有北斗经。阖门自康健。"}, {"para": 171, "start": 656.91, "duration": 2.95, "text": "家有北斗经。子孙保荣盛。"}, {"para": 172, "start": 659.86, "duration": 2.9, "text": "家有北斗经。五路自通达。"}, {"para": 173, "start": 662.76, "duration": 2.72, "text": "家有北斗经。众恶永消灭。"}, {"para": 174, "start": 665.48, "duration": 2.53, "text": "家有北斗经。六畜保兴生。"}, {"para": 175, "start": 668.01, "duration": 3.08, "text": "家有北斗经。疾病得痊愈。"}, {"para": 176, "start": 671.1, "duration": 3.21, "text": "家有北斗经。财物不虚耗。"}, {"para": 177, "start": 674.31, "duration": 2.56, "text": "家有北斗经。横事永不起。"}, {"para": 178, "start": 676.87, "duration": 2.72, "text": "家有北斗经。长保亨利贞。"}, {"para": 179, "start": 679.59, "duration": 4.28, "text": "老君曰。善哉善哉。汝可宣扬正教。"}, {"para": 180, "start": 683.87, "duration": 3.32, "text": "福利无边。普及众生。永沾胜善。"}, {"para": 181, "start": 687.19, "duration": 3.4, "text": "天师稽首礼谢。信受奉行。"}]}