{
 "segments": [
  {
   "duration": 1.175,
   "para": 0,
   "start": 0.0,
   "text": "道德真经"
  },
  {
   "duration": 3.971,
   "para": 1,
   "start": 1.175,
   "text": "道可道，非常道，名可名，非常名；"
  },
  {
   "duration": 4.441,
   "para": 2,
   "start": 5.146,
   "text": "无名，天地之始，有名，万物之母。"
  },
  {
   "duration": 2.56,
   "para": 3,
   "start": 9.587,
   "text": "故常无欲，以观其妙，"
  },
  {
   "duration": 2.299,
   "para": 4,
   "start": 12.147,
   "text": "常有欲，以观其徼；"
  },
  {
   "duration": 6.322,
   "para": 5,
   "start": 14.446,
   "text": "此两者，同出而异名，同谓之玄。玄之又玄，众妙之门。"
  },
  {
   "duration": 11.389,
   "para": 6,
   "start": 20.768,
   "text": "天下皆知美之为美，斯恶已。皆知善之为善，斯不善已。故有无相生，难易相成，长短相较，高下相倾，音声相和，前后相随。"
  },
  {
   "duration": 1.881,
   "para": 7,
   "start": 32.157,
   "text": "是以圣人处无为之事，"
  },
  {
   "duration": 7.497,
   "para": 8,
   "start": 34.038,
   "text": "行不言之教；万物作焉而不辞，生而不有，为而不恃，"
  },
  {
   "duration": 1.593,
   "para": 9,
   "start": 41.535,
   "text": "功成而弗居。"
  },
  {
   "duration": 2.534,
   "para": 10,
   "start": 43.128,
   "text": "夫唯弗居，是以不去。"
  },
  {
   "duration": 6.661,
   "para": 11,
   "start": 45.662,
   "text": "不尚贤，使民不争；不贵难得之货，使民不为盗；不见可欲，使民心不乱。"
  },
  {
   "duration": 3.918,
   "para": 12,
   "start": 52.323,
   "text": "是以圣人之治，虚其心，实其腹，"
  },
  {
   "duration": 2.377,
   "para": 13,
   "start": 56.241,
   "text": "弱其志，强其骨。"
  },
  {
   "duration": 1.646,
   "para": 14,
   "start": 58.618,
   "text": "常使民无知无欲。"
  },
  {
   "duration": 1.959,
   "para": 15,
   "start": 60.264,
   "text": "使夫智者不敢为也。"
  },
  {
   "duration": 2.247,
   "para": 16,
   "start": 62.223,
   "text": "为无为，则无不治。"
  },
  {
   "duration": 8.385,
   "para": 17,
   "start": 64.47,
   "text": "道冲而用之或不盈，渊兮似万物之宗；挫其锐，解其纷，和其光，同其尘，湛兮似或存。吾不知谁之子，象帝之先。"
  },
  {
   "duration": 2.56,
   "para": 18,
   "start": 72.855,
   "text": "天地不仁，以万物为刍狗；"
  },
  {
   "duration": 2.534,
   "para": 19,
   "start": 75.415,
   "text": "圣人不仁，以百姓为刍狗。"
  },
  {
   "duration": 4.885,
   "para": 20,
   "start": 77.949,
   "text": "天地之间，其犹橐籥乎？虚而不屈，动而愈出。"
  },
  {
   "duration": 2.142,
   "para": 21,
   "start": 82.834,
   "text": "多言数穷，不如守中。"
  },
  {
   "duration": 6.661,
   "para": 22,
   "start": 84.976,
   "text": "-{谷}-神不死，是谓玄牝。玄牝之门，是谓天地根。緜緜若存，用之不勤。"
  },
  {
   "duration": 4.702,
   "para": 23,
   "start": 91.637,
   "text": "天长地久。天地所以能长且久者，以其不自生，"
  },
  {
   "duration": 7.785,
   "para": 24,
   "start": 96.339,
   "text": "故能长生。是以圣人后其身而身先；外其身而身存。非以其无私邪，故能成其私。"
  },
  {
   "duration": 4.389,
   "para": 25,
   "start": 104.124,
   "text": "上善若水。水善利万物而不争，处众人之所恶，"
  },
  {
   "duration": 1.306,
   "para": 26,
   "start": 108.513,
   "text": "故几于道。"
  },
  {
   "duration": 6.609,
   "para": 27,
   "start": 109.819,
   "text": "居善地，心善渊，与善仁，言善信，正善治，事善能，动善时。夫唯不争，故无尤。"
  },
  {
   "duration": 2.247,
   "para": 28,
   "start": 116.428,
   "text": "持而盈之，不如其已；"
  },
  {
   "duration": 2.717,
   "para": 29,
   "start": 118.675,
   "text": "揣而棁之，不可长保。"
  },
  {
   "duration": 1.829,
   "para": 30,
   "start": 121.392,
   "text": "金玉满堂，莫之能守；"
  },
  {
   "duration": 2.351,
   "para": 31,
   "start": 123.221,
   "text": "富贵而骄，自遗其咎。"
  },
  {
   "duration": 2.247,
   "para": 32,
   "start": 125.572,
   "text": "功遂身退，天之道。"
  },
  {
   "duration": 2.299,
   "para": 33,
   "start": 127.819,
   "text": "载营魄抱一，能无离乎？"
  },
  {
   "duration": 2.612,
   "para": 34,
   "start": 130.118,
   "text": "专气致柔，能婴儿乎？"
  },
  {
   "duration": 2.247,
   "para": 35,
   "start": 132.73,
   "text": "涤除玄览，能无疵乎？"
  },
  {
   "duration": 2.429,
   "para": 36,
   "start": 134.977,
   "text": "爱国治民，能无知乎？"
  },
  {
   "duration": 2.795,
   "para": 37,
   "start": 137.406,
   "text": "天门开阖，能为雌乎？"
  },
  {
   "duration": 3.318,
   "para": 38,
   "start": 140.201,
   "text": "明白四达，能无为乎？"
  },
  {
   "duration": 0.888,
   "para": 39,
   "start": 143.519,
   "text": "生之，"
  },
  {
   "duration": 0.993,
   "para": 40,
   "start": 144.407,
   "text": "畜之。"
  },
  {
   "duration": 4.519,
   "para": 41,
   "start": 145.4,
   "text": "生而不有，为而不恃，长而不宰，是谓玄德。"
  },
  {
   "duration": 3.187,
   "para": 42,
   "start": 149.919,
   "text": "三十辐共一毂，当其无，有车之用。"
  },
  {
   "duration": 6.949,
   "para": 43,
   "start": 153.106,
   "text": "埏埴以为器，当其无，有器之用。凿户牖以为室，当其无，有室之用。故有之以为利，无之以为用。"
  },
  {
   "duration": 6.113,
   "para": 44,
   "start": 160.055,
   "text": "五色令人目盲，五音令人耳聋，五味令人口爽，驰骋畋猎令人心发狂，"
  },
  {
   "duration": 1.646,
   "para": 45,
   "start": 166.168,
   "text": "难得之货令人行妨。"
  },
  {
   "duration": 3.213,
   "para": 46,
   "start": 167.814,
   "text": "是以圣人为腹不为目，故去彼取此。"
  },
  {
   "duration": 6.609,
   "para": 47,
   "start": 171.027,
   "text": "宠辱若惊，贵大患若身。何谓宠辱若惊？宠为下，得之若惊，失之若惊，是谓宠辱若惊。"
  },
  {
   "duration": 1.698,
   "para": 48,
   "start": 177.636,
   "text": "何谓贵大患若身？"
  },
  {
   "duration": 2.769,
   "para": 49,
   "start": 179.334,
   "text": "吾所以有大患者，为吾有身，"
  },
  {
   "duration": 1.411,
   "para": 50,
   "start": 182.103,
   "text": "及吾无身，"
  },
  {
   "duration": 4.519,
   "para": 51,
   "start": 183.514,
   "text": "吾有何患？故贵以身为天下，若可寄天下；"
  },
  {
   "duration": 2.9,
   "para": 52,
   "start": 188.033,
   "text": "爱以身为天下，若可托天下。"
  },
  {
   "duration": 7.131,
   "para": 53,
   "start": 190.933,
   "text": "视之不见名曰夷，听之不闻名曰希，搏之不得名曰微。此三者，不可致诘，故混而为一。"
  },
  {
   "duration": 6.008,
   "para": 54,
   "start": 198.064,
   "text": "其上不皦，其下不昧。绳绳不可名，复归于无物。是谓无状之状，无物之象，"
  },
  {
   "duration": 1.228,
   "para": 55,
   "start": 204.072,
   "text": "是谓惚恍。"
  },
  {
   "duration": 5.224,
   "para": 56,
   "start": 205.3,
   "text": "迎之不见其首，随之不见其后。执古之道，以御今之有。"
  },
  {
   "duration": 2.351,
   "para": 57,
   "start": 210.524,
   "text": "能知古始，是谓道纪。"
  },
  {
   "duration": 7.314,
   "para": 58,
   "start": 212.875,
   "text": "古之善为士者，微妙玄通，深不可识。夫唯不可识，故强为之容。豫焉若冬涉川，"
  },
  {
   "duration": 2.011,
   "para": 59,
   "start": 220.189,
   "text": "犹兮若畏四邻，"
  },
  {
   "duration": 6.557,
   "para": 60,
   "start": 222.2,
   "text": "俨兮其若容，涣兮若冰之将释，敦兮其若朴，旷兮其若谷，混兮其若浊。"
  },
  {
   "duration": 4.101,
   "para": 61,
   "start": 228.757,
   "text": "孰能浊以静之徐清？孰能安以久动之徐生？"
  },
  {
   "duration": 2.429,
   "para": 62,
   "start": 232.858,
   "text": "保此道者不欲盈，"
  },
  {
   "duration": 2.769,
   "para": 63,
   "start": 235.287,
   "text": "夫唯不盈，故能蔽不新成。"
  },
  {
   "duration": 1.933,
   "para": 64,
   "start": 238.056,
   "text": "致虚极，守静笃。"
  },
  {
   "duration": 2.194,
   "para": 65,
   "start": 239.989,
   "text": "万物并作，吾以观复。"
  },
  {
   "duration": 6.557,
   "para": 66,
   "start": 242.183,
   "text": "夫物芸芸，各复归其根。归根曰静，是谓复命。复命曰常，"
  },
  {
   "duration": 3.605,
   "para": 67,
   "start": 248.74,
   "text": "知常曰明。不知常，妄作凶。"
  },
  {
   "duration": 0.627,
   "para": 68,
   "start": 252.345,
   "text": "知常容，"
  },
  {
   "duration": 1.776,
   "para": 69,
   "start": 252.972,
   "text": "容乃公，"
  },
  {
   "duration": 1.123,
   "para": 70,
   "start": 254.748,
   "text": "公乃全，"
  },
  {
   "duration": 2.064,
   "para": 71,
   "start": 255.871,
   "text": "全乃天，"
  },
  {
   "duration": 1.358,
   "para": 72,
   "start": 257.935,
   "text": "天乃道，"
  },
  {
   "duration": 1.515,
   "para": 73,
   "start": 259.293,
   "text": "道乃久，"
  },
  {
   "duration": 1.28,
   "para": 74,
   "start": 260.808,
   "text": "没身不殆。"
  },
  {
   "duration": 1.959,
   "para": 75,
   "start": 262.088,
   "text": "太上，下知有之，"
  },
  {
   "duration": 1.933,
   "para": 76,
   "start": 264.047,
   "text": "其次，亲而誉之，"
  },
  {
   "duration": 2.142,
   "para": 77,
   "start": 265.98,
   "text": "其次，畏之，"
  },
  {
   "duration": 2.064,
   "para": 78,
   "start": 268.122,
   "text": "其次，侮之。"
  },
  {
   "duration": 2.247,
   "para": 79,
   "start": 270.186,
   "text": "信不足焉，有不信焉。"
  },
  {
   "duration": 4.284,
   "para": 80,
   "start": 272.433,
   "text": "悠兮其贵言，功成事遂，百姓皆谓：我自然。"
  },
  {
   "duration": 2.116,
   "para": 81,
   "start": 276.717,
   "text": "大道废，有仁义；"
  },
  {
   "duration": 2.116,
   "para": 82,
   "start": 278.833,
   "text": "智慧出，有大伪；"
  },
  {
   "duration": 4.101,
   "para": 83,
   "start": 280.949,
   "text": "六亲不和，有孝慈；国家昏乱，有忠臣。"
  },
  {
   "duration": 10.553,
   "para": 84,
   "start": 285.05,
   "text": "绝圣弃智，民利百倍；绝仁弃义，民复孝慈；绝巧弃利，盗贼无有。此三者以为文不足，故令有所属﹕见素抱朴，少私寡欲。"
  },
  {
   "duration": 6.975,
   "para": 85,
   "start": 295.603,
   "text": "绝学无忧，唯之与阿，相去几何？善之与恶，相去若何？人之所畏，不可不畏。"
  },
  {
   "duration": 4.023,
   "para": 86,
   "start": 302.578,
   "text": "荒兮其未央哉﹗"
  },
  {
   "duration": 3.814,
   "para": 87,
   "start": 306.601,
   "text": "众人熙熙，如享太牢，如春登台。"
  },
  {
   "duration": 2.978,
   "para": 88,
   "start": 310.415,
   "text": "我独泊兮其未兆，如婴儿之未孩；"
  },
  {
   "duration": 2.534,
   "para": 89,
   "start": 313.393,
   "text": "儽儽兮若无所归。"
  },
  {
   "duration": 2.534,
   "para": 90,
   "start": 315.927,
   "text": "众人皆有余，而我独若遗。"
  },
  {
   "duration": 2.194,
   "para": 91,
   "start": 318.461,
   "text": "我愚人之心也哉﹗"
  },
  {
   "duration": 1.933,
   "para": 92,
   "start": 320.655,
   "text": "沌沌兮，"
  },
  {
   "duration": 1.123,
   "para": 93,
   "start": 322.588,
   "text": "俗人昭昭，"
  },
  {
   "duration": 2.717,
   "para": 94,
   "start": 323.711,
   "text": "我独昏昏。俗人察察，"
  },
  {
   "duration": 2.769,
   "para": 95,
   "start": 326.428,
   "text": "我独闷闷。澹兮其若海，"
  },
  {
   "duration": 1.28,
   "para": 96,
   "start": 329.197,
   "text": "飂兮若无止。"
  },
  {
   "duration": 1.28,
   "para": 97,
   "start": 330.477,
   "text": "众人皆有以，"
  },
  {
   "duration": 1.463,
   "para": 98,
   "start": 331.757,
   "text": "而我独顽似鄙。"
  },
  {
   "duration": 3.03,
   "para": 99,
   "start": 333.22,
   "text": "我独异于人，而贵食母。"
  },
  {
   "duration": 2.717,
   "para": 100,
   "start": 336.25,
   "text": "孔德之容，惟道是从。"
  },
  {
   "duration": 2.429,
   "para": 101,
   "start": 338.967,
   "text": "道之为物，惟恍惟惚。"
  },
  {
   "duration": 4.624,
   "para": 102,
   "start": 341.396,
   "text": "惚兮恍兮，其中有象；恍兮惚兮，其中有物。"
  },
  {
   "duration": 2.299,
   "para": 103,
   "start": 346.02,
   "text": "窈兮冥兮，其中有精；"
  },
  {
   "duration": 2.769,
   "para": 104,
   "start": 348.319,
   "text": "其精甚真，其中有信。"
  },
  {
   "duration": 2.377,
   "para": 105,
   "start": 351.088,
   "text": "自今及古，其名不去，"
  },
  {
   "duration": 1.515,
   "para": 106,
   "start": 353.465,
   "text": "以阅众甫。"
  },
  {
   "duration": 2.847,
   "para": 107,
   "start": 354.98,
   "text": "吾何以知众甫之状哉？以此。"
  },
  {
   "duration": 2.299,
   "para": 108,
   "start": 357.827,
   "text": "曲则全，"
  },
  {
   "duration": 1.724,
   "para": 109,
   "start": 360.126,
   "text": "枉则直，"
  },
  {
   "duration": 1.515,
   "para": 110,
   "start": 361.85,
   "text": "洼则盈，"
  },
  {
   "duration": 1.698,
   "para": 111,
   "start": 363.365,
   "text": "敝则新，"
  },
  {
   "duration": 1.646,
   "para": 112,
   "start": 365.063,
   "text": "少则得，多则惑。"
  },
  {
   "duration": 2.064,
   "para": 113,
   "start": 366.709,
   "text": "是以圣人抱一为天下式。"
  },
  {
   "duration": 11.389,
   "para": 114,
   "start": 368.773,
   "text": "不自见故明，不自是故彰，不自伐故有功，不自矜故长。夫唯不争，故天下莫能与之争。古之所谓曲则全者，岂虚言哉！诚全而归之。"
  },
  {
   "duration": 1.698,
   "para": 115,
   "start": 380.162,
   "text": "希言自然。"
  },
  {
   "duration": 7.732,
   "para": 116,
   "start": 381.86,
   "text": "故飘风不终朝，骤雨不终日。孰为此者？天地。天地尚不能久，而况于人乎？"
  },
  {
   "duration": 3.03,
   "para": 117,
   "start": 389.592,
   "text": "故从事于道者，道者同于道，"
  },
  {
   "duration": 2.56,
   "para": 118,
   "start": 392.622,
   "text": "德者同于德，"
  },
  {
   "duration": 1.411,
   "para": 119,
   "start": 395.182,
   "text": "失者同于失。"
  },
  {
   "duration": 7.21,
   "para": 120,
   "start": 396.593,
   "text": "同于道者，道亦乐得之；同于德者，德亦乐得之；同于失者，失亦乐得之。"
  },
  {
   "duration": 2.351,
   "para": 121,
   "start": 403.803,
   "text": "信不足焉，有不信焉。"
  },
  {
   "duration": 1.541,
   "para": 122,
   "start": 406.154,
   "text": "企者不立，"
  },
  {
   "duration": 8.647,
   "para": 123,
   "start": 407.695,
   "text": "跨者不行，自见者不明，自是者不彰，自伐者无功，自矜者不长。其在道也，曰余食赘行。"
  },
  {
   "duration": 3.605,
   "para": 124,
   "start": 416.342,
   "text": "物或恶之，故有道者不处。"
  },
  {
   "duration": 2.482,
   "para": 125,
   "start": 419.947,
   "text": "有物混成，先天地生。"
  },
  {
   "duration": 2.534,
   "para": 126,
   "start": 422.429,
   "text": "寂兮寥兮，独立而不改，"
  },
  {
   "duration": 2.534,
   "para": 127,
   "start": 424.963,
   "text": "周行而不殆，可以为天下母。"
  },
  {
   "duration": 1.593,
   "para": 128,
   "start": 427.497,
   "text": "吾不知其名，"
  },
  {
   "duration": 1.175,
   "para": 129,
   "start": 429.09,
   "text": "字之曰道，"
  },
  {
   "duration": 1.515,
   "para": 130,
   "start": 430.265,
   "text": "强为之名曰大。"
  },
  {
   "duration": 3.213,
   "para": 131,
   "start": 431.78,
   "text": "大曰逝，"
  },
  {
   "duration": 1.959,
   "para": 132,
   "start": 434.993,
   "text": "逝曰远，远曰反。"
  },
  {
   "duration": 3.971,
   "para": 133,
   "start": 436.952,
   "text": "故道大，天大，地大，王亦大。"
  },
  {
   "duration": 1.28,
   "para": 134,
   "start": 440.923,
   "text": "域中有四大，"
  },
  {
   "duration": 1.829,
   "para": 135,
   "start": 442.203,
   "text": "而王居其一焉。"
  },
  {
   "duration": 3.788,
   "para": 136,
   "start": 444.032,
   "text": "人法地，地法天，天法道，道法自然。"
  },
  {
   "duration": 2.482,
   "para": 137,
   "start": 447.82,
   "text": "重为轻根，静为躁君。"
  },
  {
   "duration": 2.116,
   "para": 138,
   "start": 450.302,
   "text": "是以圣人终日行不离辎重。"
  },
  {
   "duration": 2.56,
   "para": 139,
   "start": 452.418,
   "text": "虽有荣观，燕处超然。"
  },
  {
   "duration": 5.721,
   "para": 140,
   "start": 454.978,
   "text": "奈何万乘之主，而以身轻天下？轻则失本，躁则失君。"
  },
  {
   "duration": 1.933,
   "para": 141,
   "start": 460.699,
   "text": "善行无辙迹，"
  },
  {
   "duration": 1.593,
   "para": 142,
   "start": 462.632,
   "text": "善言无瑕讁；"
  },
  {
   "duration": 1.463,
   "para": 143,
   "start": 464.225,
   "text": "善数不用筹策；"
  },
  {
   "duration": 4.336,
   "para": 144,
   "start": 465.688,
   "text": "善闭无关楗而不可开，善结无绳约而不可解。"
  },
  {
   "duration": 3.265,
   "para": 145,
   "start": 470.024,
   "text": "是以圣人常善救人，故无弃人；"
  },
  {
   "duration": 4.859,
   "para": 146,
   "start": 473.289,
   "text": "常善救物，故无弃物，是谓袭明。故善人者，不善人之师；"
  },
  {
   "duration": 2.482,
   "para": 147,
   "start": 478.148,
   "text": "不善人者，善人之资。"
  },
  {
   "duration": 3.736,
   "para": 148,
   "start": 480.63,
   "text": "不贵其师，不爱其资，虽智大迷，"
  },
  {
   "duration": 1.28,
   "para": 149,
   "start": 484.366,
   "text": "是谓要妙。"
  },
  {
   "duration": 5.59,
   "para": 150,
   "start": 485.646,
   "text": "知其雄，守其雌，为天下谿。为天下谿，常德不离，复归于婴儿。"
  },
  {
   "duration": 3.5,
   "para": 151,
   "start": 491.236,
   "text": "知其白，守其黑，为天下式。"
  },
  {
   "duration": 2.299,
   "para": 152,
   "start": 494.736,
   "text": "为天下式，常德不忒，"
  },
  {
   "duration": 1.358,
   "para": 153,
   "start": 497.035,
   "text": "复归于无极。"
  },
  {
   "duration": 5.407,
   "para": 154,
   "start": 498.393,
   "text": "知其荣，守其辱，为天下谷，常德乃足，复归于朴。"
  },
  {
   "duration": 4.023,
   "para": 155,
   "start": 503.8,
   "text": "朴散则为器，圣人用之，则为官长，"
  },
  {
   "duration": 1.28,
   "para": 156,
   "start": 507.823,
   "text": "故大制不割。"
  },
  {
   "duration": 5.538,
   "para": 157,
   "start": 509.103,
   "text": "将欲取天下而为之，吾见其不得已。天下神器，"
  },
  {
   "duration": 3.631,
   "para": 158,
   "start": 514.641,
   "text": "不可为也，为者败之，执者失之。"
  },
  {
   "duration": 7.732,
   "para": 159,
   "start": 518.272,
   "text": "故物或行或随，或歔或吹。或强或羸，或挫或隳。是以圣人去甚，去奢，去泰。"
  },
  {
   "duration": 3.213,
   "para": 160,
   "start": 526.004,
   "text": "以道佐人主者，不以兵强天下。"
  },
  {
   "duration": 1.176,
   "para": 161,
   "start": 529.217,
   "text": "其事好还。"
  },
  {
   "duration": 4.232,
   "para": 162,
   "start": 530.393,
   "text": "师之所处，荆棘生焉。大军之后，必有凶年。"
  },
  {
   "duration": 3.553,
   "para": 163,
   "start": 534.625,
   "text": "善有果而已，不敢以取强。"
  },
  {
   "duration": 3.553,
   "para": 164,
   "start": 538.178,
   "text": "果而勿矜，果而勿伐，果而勿骄。"
  },
  {
   "duration": 2.429,
   "para": 165,
   "start": 541.731,
   "text": "果而不得已，果而勿强。"
  },
  {
   "duration": 3.5,
   "para": 166,
   "start": 544.16,
   "text": "物壮则老，是谓不道，不道早已。"
  },
  {
   "duration": 22.361,
   "para": 167,
   "start": 547.66,
   "text": "夫佳兵者，不祥之器，物或恶之，故有道者不处。君子居则贵左，用兵则贵右。兵者不祥之器，非君子之器，不得已而用之，恬淡为上。胜而不美，而美之者，是乐杀人。夫乐杀人者，则不可以得志于天下矣。吉事尚左，凶事尚右。偏将军居左，上将军居右，言以丧礼处之。杀人之众，以哀悲泣之，战胜，以丧礼处之。"
  },
  {
   "duration": 5.642,
   "para": 168,
   "start": 570.021,
   "text": "道常无名，朴虽小，天下莫能臣也。侯王若能守之，万物将自宾。"
  },
  {
   "duration": 4.232,
   "para": 169,
   "start": 575.663,
   "text": "天地相合，以降甘露，民莫之令而自均。"
  },
  {
   "duration": 4.807,
   "para": 170,
   "start": 579.895,
   "text": "始制有名，名亦既有，夫亦将知止，知止所以不殆。"
  },
  {
   "duration": 3.265,
   "para": 171,
   "start": 584.702,
   "text": "譬道之在天下，犹川谷之于江海。"
  },
  {
   "duration": 2.952,
   "para": 172,
   "start": 587.967,
   "text": "知人者智，自知者明。"
  },
  {
   "duration": 2.377,
   "para": 173,
   "start": 590.919,
   "text": "胜人者有力，自胜者强。"
  },
  {
   "duration": 1.28,
   "para": 174,
   "start": 593.296,
   "text": "知足者富。"
  },
  {
   "duration": 1.358,
   "para": 175,
   "start": 594.576,
   "text": "强行者有志。"
  },
  {
   "duration": 1.515,
   "para": 176,
   "start": 595.934,
   "text": "不失其所者久。"
  },
  {
   "duration": 1.933,
   "para": 177,
   "start": 597.449,
   "text": "死而不亡者寿。"
  },
  {
   "duration": 2.247,
   "para": 178,
   "start": 599.382,
   "text": "大道泛兮，其可左右。"
  },
  {
   "duration": 6.792,
   "para": 179,
   "start": 601.629,
   "text": "万物恃之而生而不辞，功成不名有。衣养万物而不为主，常无欲，可名于小；"
  },
  {
   "duration": 2.847,
   "para": 180,
   "start": 608.421,
   "text": "万物归焉而不为主，可名为大。"
  },
  {
   "duration": 2.9,
   "para": 181,
   "start": 611.268,
   "text": "以其终不自为大，故能成其大。"
  },
  {
   "duration": 2.247,
   "para": 182,
   "start": 614.168,
   "text": "执大象，天下往。"
  },
  {
   "duration": 2.664,
   "para": 183,
   "start": 616.415,
   "text": "往而不害，安平太。"
  },
  {
   "duration": 6.609,
   "para": 184,
   "start": 619.079,
   "text": "乐与饵，过客止。道之出口，淡乎其无味，视之不足见，听之不足闻，用之不足既。"
  },
  {
   "duration": 8.986,
   "para": 185,
   "start": 625.688,
   "text": "将欲歙之，必固张之；将欲弱之，必固强之；将欲废之，必固兴之；将欲夺之，必固与之。是谓微明。"
  },
  {
   "duration": 5.355,
   "para": 186,
   "start": 634.674,
   "text": "柔弱胜刚强。鱼不可脱于渊，国之利器不可以示人。"
  },
  {
   "duration": 1.306,
   "para": 187,
   "start": 640.029,
   "text": "道常无为"
  },
  {
   "duration": 3.135,
   "para": 188,
   "start": 641.335,
   "text": "而无不为。"
  },
  {
   "duration": 5.773,
   "para": 189,
   "start": 644.47,
   "text": "侯王若能守之，万物将自化。化而欲作，吾将镇之以无名之朴。"
  },
  {
   "duration": 2.952,
   "para": 190,
   "start": 650.243,
   "text": "无名之朴，夫亦将无欲。"
  },
  {
   "duration": 2.612,
   "para": 191,
   "start": 653.195,
   "text": "不欲以静，天下将自定。"
  },
  {
   "duration": 23.667,
   "para": 192,
   "start": 655.807,
   "text": "上德不德，是以有德；下德不失德，是以无德。上德无为而无以为，下德为之而有以为。上仁为之而无以为，上义为之而有以为。上礼为之而莫之应， 则攘臂而扔之。故失道而后德，失德而后仁，失仁而后义，失义而后礼。夫礼者，忠信之薄，而乱之首。前识者，道之华，而愚之始。是以大丈夫处其厚，不居其薄；处其实，不居其华。故去彼取此。"
  },
  {
   "duration": 1.306,
   "para": 193,
   "start": 679.474,
   "text": "昔之得一者，"
  },
  {
   "duration": 8.516,
   "para": 194,
   "start": 680.78,
   "text": "天得一以清，地得一以宁，神得一以灵，谷得一以盈，万物得一以生，侯王得一以为天下贞。其致之，"
  },
  {
   "duration": 2.299,
   "para": 195,
   "start": 689.296,
   "text": "天无以清将恐裂，"
  },
  {
   "duration": 19.435,
   "para": 196,
   "start": 691.595,
   "text": "地无以宁将恐发，神无以灵将恐歇，谷无以盈将恐竭，万物无以生将恐灭，侯王无以贵高将恐蹶。故贵以贱为本，高以下为基。是以侯王自称孤﹑寡﹑不谷。此非以贱为本邪？非乎？故致数舆无舆，不欲琭琭如玉，珞珞如石。"
  },
  {
   "duration": 1.881,
   "para": 197,
   "start": 711.03,
   "text": "反者道之动，"
  },
  {
   "duration": 1.306,
   "para": 198,
   "start": 712.911,
   "text": "弱者道之用。"
  },
  {
   "duration": 3.082,
   "para": 199,
   "start": 714.217,
   "text": "天下万物生于有，有生于无。"
  },
  {
   "duration": 3.187,
   "para": 200,
   "start": 717.299,
   "text": "上士闻道，勤而行之；"
  },
  {
   "duration": 7.158,
   "para": 201,
   "start": 720.486,
   "text": "中士闻道，若存若亡；下士闻道，大笑之。不笑不足以为道。故建言有之﹕"
  },
  {
   "duration": 2.847,
   "para": 202,
   "start": 727.644,
   "text": "明道若昧，"
  },
  {
   "duration": 2.064,
   "para": 203,
   "start": 730.491,
   "text": "进道若退，"
  },
  {
   "duration": 1.175,
   "para": 204,
   "start": 732.555,
   "text": "夷道若颣，"
  },
  {
   "duration": 1.28,
   "para": 205,
   "start": 733.73,
   "text": "上德若谷，"
  },
  {
   "duration": 1.228,
   "para": 206,
   "start": 735.01,
   "text": "大白若辱，"
  },
  {
   "duration": 1.358,
   "para": 207,
   "start": 736.238,
   "text": "广德若不足，"
  },
  {
   "duration": 1.228,
   "para": 208,
   "start": 737.596,
   "text": "建德若偷，"
  },
  {
   "duration": 1.881,
   "para": 209,
   "start": 738.824,
   "text": "质真若渝，"
  },
  {
   "duration": 1.724,
   "para": 210,
   "start": 740.705,
   "text": "大方无隅，"
  },
  {
   "duration": 1.045,
   "para": 211,
   "start": 742.429,
   "text": "大器晚成，"
  },
  {
   "duration": 1.933,
   "para": 212,
   "start": 743.474,
   "text": "大音希声，"
  },
  {
   "duration": 1.28,
   "para": 213,
   "start": 745.407,
   "text": "大象无形，"
  },
  {
   "duration": 3.553,
   "para": 214,
   "start": 746.687,
   "text": "道隐无名。夫唯道，善贷且成。"
  },
  {
   "duration": 13.218,
   "para": 215,
   "start": 750.24,
   "text": "道生一，一生二，二生三，三生万物。万物负阴而抱阳，冲气以为和。人之所恶，唯孤﹑寡﹑不谷，而王公以为称。故物或损之而益，或益之而损。"
  },
  {
   "duration": 3.082,
   "para": 216,
   "start": 763.458,
   "text": "人之所教，我亦教之。"
  },
  {
   "duration": 3.082,
   "para": 217,
   "start": 766.54,
   "text": "强梁者不得其死，吾将以为教父。"
  },
  {
   "duration": 2.9,
   "para": 218,
   "start": 769.622,
   "text": "天下之至柔，驰骋天下之至坚。"
  },
  {
   "duration": 3.396,
   "para": 219,
   "start": 772.522,
   "text": "无有入无间，吾是以知无为之有益。"
  },
  {
   "duration": 3.736,
   "para": 220,
   "start": 775.918,
   "text": "不言之教，无为之益，天下希及之。"
  },
  {
   "duration": 1.463,
   "para": 221,
   "start": 779.654,
   "text": "名与身孰亲？"
  },
  {
   "duration": 1.646,
   "para": 222,
   "start": 781.117,
   "text": "身与货孰多？"
  },
  {
   "duration": 1.175,
   "para": 223,
   "start": 782.763,
   "text": "得与亡孰病？"
  },
  {
   "duration": 3.082,
   "para": 224,
   "start": 783.938,
   "text": "是故甚爱必大费，多藏必厚亡，"
  },
  {
   "duration": 3.736,
   "para": 225,
   "start": 787.02,
   "text": "知足不辱，知止不殆，可以长久。"
  },
  {
   "duration": 2.56,
   "para": 226,
   "start": 790.756,
   "text": "大成若缺，其用不弊。"
  },
  {
   "duration": 2.194,
   "para": 227,
   "start": 793.316,
   "text": "大盈若冲，其用不穷。"
  },
  {
   "duration": 2.299,
   "para": 228,
   "start": 795.51,
   "text": "大直若屈，其用不居。"
  },
  {
   "duration": 2.116,
   "para": 229,
   "start": 797.809,
   "text": "大巧若拙，其用不辍。"
  },
  {
   "duration": 2.769,
   "para": 230,
   "start": 799.925,
   "text": "大辩若讷，其用不差。"
  },
  {
   "duration": 3.788,
   "para": 231,
   "start": 802.694,
   "text": "躁胜寒，静胜热。清静为天下正。"
  },
  {
   "duration": 2.482,
   "para": 232,
   "start": 806.482,
   "text": "天下有道，却走马以粪。"
  },
  {
   "duration": 2.56,
   "para": 233,
   "start": 808.964,
   "text": "天下无道，戎马生于郊。"
  },
  {
   "duration": 5.59,
   "para": 234,
   "start": 811.524,
   "text": "祸莫大于不知足；咎莫大于欲得。故知足之足，常足矣。"
  },
  {
   "duration": 3.396,
   "para": 235,
   "start": 817.114,
   "text": "不出户，知天下；不闚牖，见天道。"
  },
  {
   "duration": 3.318,
   "para": 236,
   "start": 820.51,
   "text": "其出弥远，其知弥少。"
  },
  {
   "duration": 3.187,
   "para": 237,
   "start": 823.828,
   "text": "是以圣人不行而知，不见而名，"
  },
  {
   "duration": 1.228,
   "para": 238,
   "start": 827.015,
   "text": "不为而成。"
  },
  {
   "duration": 1.698,
   "para": 239,
   "start": 828.243,
   "text": "为学日益，"
  },
  {
   "duration": 1.306,
   "para": 240,
   "start": 829.941,
   "text": "为道日损。"
  },
  {
   "duration": 3.631,
   "para": 241,
   "start": 831.247,
   "text": "损之又损，以至于无为。无为而无不为。"
  },
  {
   "duration": 2.194,
   "para": 242,
   "start": 834.878,
   "text": "取天下常以无事，"
  },
  {
   "duration": 1.646,
   "para": 243,
   "start": 837.072,
   "text": "及其有事，"
  },
  {
   "duration": 2.612,
   "para": 244,
   "start": 838.718,
   "text": "不足以取天下。"
  },
  {
   "duration": 3.082,
   "para": 245,
   "start": 841.33,
   "text": "圣人无常心，以百姓心为心。"
  },
  {
   "duration": 4.571,
   "para": 246,
   "start": 844.412,
   "text": "善者，吾善之；不善者，吾亦善之，"
  },
  {
   "duration": 0.94,
   "para": 247,
   "start": 848.983,
   "text": "德善。"
  },
  {
   "duration": 7.158,
   "para": 248,
   "start": 849.923,
   "text": "信者，吾信之；不信者，吾亦信之，德信。圣人在天下歙歙，为天下浑其心，"
  },
  {
   "duration": 2.142,
   "para": 249,
   "start": 857.081,
   "text": "百姓皆注其耳目,"
  },
  {
   "duration": 1.463,
   "para": 250,
   "start": 859.223,
   "text": "圣人皆孩之。"
  },
  {
   "duration": 1.175,
   "para": 251,
   "start": 860.686,
   "text": "出生入死。"
  },
  {
   "duration": 15.308,
   "para": 252,
   "start": 861.861,
   "text": "生之徒，十有三；死之徒，十有三；人之生，动之死地，亦十有三。夫何故？以其生生之厚。盖闻善摄生者，陆行不遇兕虎，入军不被甲兵；兕无所投其角，虎无所措其爪，兵无所容其刃。夫何故？以其无死地。"
  },
  {
   "duration": 4.754,
   "para": 253,
   "start": 877.169,
   "text": "道生之，德畜之，物形之，势成之。"
  },
  {
   "duration": 2.116,
   "para": 254,
   "start": 881.923,
   "text": "是以万物莫不尊道而贵德。"
  },
  {
   "duration": 3.265,
   "para": 255,
   "start": 884.039,
   "text": "道之尊，德之贵，夫莫之命而常自然。"
  },
  {
   "duration": 5.642,
   "para": 256,
   "start": 887.304,
   "text": "故道生之，德畜之。长之育之，亭之毒之，盖之覆之。"
  },
  {
   "duration": 2.351,
   "para": 257,
   "start": 892.946,
   "text": "生而不有，为而不恃，"
  },
  {
   "duration": 2.847,
   "para": 258,
   "start": 895.297,
   "text": "长而不宰。是谓玄德。"
  },
  {
   "duration": 2.534,
   "para": 259,
   "start": 898.144,
   "text": "天下有始，以为天下母。"
  },
  {
   "duration": 4.754,
   "para": 260,
   "start": 900.678,
   "text": "既得其母，以知其子，既知其子，复守其母，没身不殆。"
  },
  {
   "duration": 2.116,
   "para": 261,
   "start": 905.432,
   "text": "塞其兑，闭其门，"
  },
  {
   "duration": 1.358,
   "para": 262,
   "start": 907.548,
   "text": "终身不勤。"
  },
  {
   "duration": 3.318,
   "para": 263,
   "start": 908.906,
   "text": "开其兑，济其事，终身不救。"
  },
  {
   "duration": 2.534,
   "para": 264,
   "start": 912.224,
   "text": "见小曰明，守柔曰强。"
  },
  {
   "duration": 1.228,
   "para": 265,
   "start": 914.758,
   "text": "用其光，"
  },
  {
   "duration": 1.646,
   "para": 266,
   "start": 915.986,
   "text": "复归其明，"
  },
  {
   "duration": 2.247,
   "para": 267,
   "start": 917.632,
   "text": "无遗身殃，是为习常。"
  },
  {
   "duration": 3.814,
   "para": 268,
   "start": 919.879,
   "text": "使我介然有知，行于大道，唯施是畏。"
  },
  {
   "duration": 2.482,
   "para": 269,
   "start": 923.693,
   "text": "大道甚夷，而民好径。"
  },
  {
   "duration": 1.881,
   "para": 270,
   "start": 926.175,
   "text": "朝甚除，"
  },
  {
   "duration": 2.247,
   "para": 271,
   "start": 928.056,
   "text": "田甚芜，仓甚虚；"
  },
  {
   "duration": 5.407,
   "para": 272,
   "start": 930.303,
   "text": "服文彩，带利剑，厌饮食，财货有余；是为盗夸。非道也哉！"
  },
  {
   "duration": 1.646,
   "para": 273,
   "start": 935.71,
   "text": "善建者不拔，"
  },
  {
   "duration": 1.411,
   "para": 274,
   "start": 937.356,
   "text": "善抱者不脱，"
  },
  {
   "duration": 1.593,
   "para": 275,
   "start": 938.767,
   "text": "子孙以祭祀不辍。"
  },
  {
   "duration": 4.049,
   "para": 276,
   "start": 940.36,
   "text": "修之于身，其德乃真；修之于家，其德乃余；"
  },
  {
   "duration": 9.665,
   "para": 277,
   "start": 944.409,
   "text": "修之于乡，其德乃长；修之于国，其德乃丰；修之于天下，其德乃普。故以身观身，以家观家，以乡观乡，以国观国，"
  },
  {
   "duration": 1.646,
   "para": 278,
   "start": 954.074,
   "text": "以天下观天下。"
  },
  {
   "duration": 2.482,
   "para": 279,
   "start": 955.72,
   "text": "吾何以知天下然哉？以此。"
  },
  {
   "duration": 6.191,
   "para": 280,
   "start": 958.202,
   "text": "含德之厚，比于赤子。蜂虿虺蛇不螫，猛兽不据，攫鸟不搏。"
  },
  {
   "duration": 2.011,
   "para": 281,
   "start": 964.393,
   "text": "骨弱筋柔而握固。"
  },
  {
   "duration": 1.933,
   "para": 282,
   "start": 966.404,
   "text": "未知牝牡之合而全作，"
  },
  {
   "duration": 2.9,
   "para": 283,
   "start": 968.337,
   "text": "精之至也。终日号而不嗄，"
  },
  {
   "duration": 2.482,
   "para": 284,
   "start": 971.237,
   "text": "和之至也。知和曰常，"
  },
  {
   "duration": 1.411,
   "para": 285,
   "start": 973.719,
   "text": "知常曰明。"
  },
  {
   "duration": 1.228,
   "para": 286,
   "start": 975.13,
   "text": "益生曰祥。"
  },
  {
   "duration": 1.411,
   "para": 287,
   "start": 976.358,
   "text": "心使气曰强。"
  },
  {
   "duration": 3.866,
   "para": 288,
   "start": 977.769,
   "text": "物壮则老，谓之不道，不道早已。"
  },
  {
   "duration": 1.28,
   "para": 289,
   "start": 981.635,
   "text": "知者不言，"
  },
  {
   "duration": 1.175,
   "para": 290,
   "start": 982.915,
   "text": "言者不知。"
  },
  {
   "duration": 3.605,
   "para": 291,
   "start": 984.09,
   "text": "塞其兑，闭其门，挫其锐，"
  },
  {
   "duration": 1.881,
   "para": 292,
   "start": 987.695,
   "text": "解其分，"
  },
  {
   "duration": 1.593,
   "para": 293,
   "start": 989.576,
   "text": "和其光，"
  },
  {
   "duration": 1.646,
   "para": 294,
   "start": 991.169,
   "text": "同其尘，"
  },
  {
   "duration": 4.206,
   "para": 295,
   "start": 992.815,
   "text": "是谓玄同。故不可得而亲，不可得而疏；"
  },
  {
   "duration": 2.978,
   "para": 296,
   "start": 997.021,
   "text": "不可得而利，不可得而害；"
  },
  {
   "duration": 2.795,
   "para": 297,
   "start": 999.999,
   "text": "不可得而贵，不可得而贱。"
  },
  {
   "duration": 1.306,
   "para": 298,
   "start": 1002.794,
   "text": "故为天下贵。"
  },
  {
   "duration": 4.206,
   "para": 299,
   "start": 1004.1,
   "text": "以正治国，以奇用兵，以无事取天下。"
  },
  {
   "duration": 7.21,
   "para": 300,
   "start": 1008.306,
   "text": "吾何以知其然哉？以此。天下多忌讳，而民弥贫；民多利器，国家滋昬；"
  },
  {
   "duration": 2.247,
   "para": 301,
   "start": 1015.516,
   "text": "人多伎巧，奇物滋起；"
  },
  {
   "duration": 2.064,
   "para": 302,
   "start": 1017.763,
   "text": "法令滋彰，盗贼多有。"
  },
  {
   "duration": 7.158,
   "para": 303,
   "start": 1019.827,
   "text": "故圣人云﹕「我无为而民自化，我好静而民自正，我无事而民自富，我无欲而民自朴。」"
  },
  {
   "duration": 1.933,
   "para": 304,
   "start": 1026.985,
   "text": "其政闷闷，其民淳淳；"
  },
  {
   "duration": 2.429,
   "para": 305,
   "start": 1028.918,
   "text": "其政察察，其民缺缺。"
  },
  {
   "duration": 4.754,
   "para": 306,
   "start": 1031.347,
   "text": "祸兮福之所倚，福兮祸之所伏。孰知其极？其无正。"
  },
  {
   "duration": 1.829,
   "para": 307,
   "start": 1036.101,
   "text": "正复为奇，"
  },
  {
   "duration": 1.176,
   "para": 308,
   "start": 1037.93,
   "text": "善复为妖。"
  },
  {
   "duration": 2.482,
   "para": 309,
   "start": 1039.106,
   "text": "人之迷，其日固久。"
  },
  {
   "duration": 1.698,
   "para": 310,
   "start": 1041.588,
   "text": "是以圣人方而不割，"
  },
  {
   "duration": 1.593,
   "para": 311,
   "start": 1043.286,
   "text": "廉而不刿，"
  },
  {
   "duration": 1.463,
   "para": 312,
   "start": 1044.879,
   "text": "直而不肆，"
  },
  {
   "duration": 1.306,
   "para": 313,
   "start": 1046.342,
   "text": "光而不燿。"
  },
  {
   "duration": 1.881,
   "para": 314,
   "start": 1047.648,
   "text": "治人事天，莫若啬。"
  },
  {
   "duration": 2.247,
   "para": 315,
   "start": 1049.529,
   "text": "夫唯啬，是谓早服；"
  },
  {
   "duration": 1.829,
   "para": 316,
   "start": 1051.776,
   "text": "早服谓之重积德；"
  },
  {
   "duration": 3.396,
   "para": 317,
   "start": 1053.605,
   "text": "重积德则无不克，无不克则莫知其极；"
  },
  {
   "duration": 2.429,
   "para": 318,
   "start": 1057.001,
   "text": "莫知其极，可以有国；"
  },
  {
   "duration": 2.011,
   "para": 319,
   "start": 1059.43,
   "text": "有国之母，可以长久；"
  },
  {
   "duration": 3.318,
   "para": 320,
   "start": 1061.441,
   "text": "是谓深根固柢，长生久视之道。"
  },
  {
   "duration": 2.351,
   "para": 321,
   "start": 1064.759,
   "text": "治大国，若烹小鲜。"
  },
  {
   "duration": 2.377,
   "para": 322,
   "start": 1067.11,
   "text": "以道莅天下，其鬼不神；"
  },
  {
   "duration": 2.847,
   "para": 323,
   "start": 1069.487,
   "text": "非其鬼不神，其神不伤人；"
  },
  {
   "duration": 2.952,
   "para": 324,
   "start": 1072.334,
   "text": "非其神不伤人，圣人亦不伤人。"
  },
  {
   "duration": 2.482,
   "para": 325,
   "start": 1075.286,
   "text": "夫两不相伤，故德交归焉。"
  },
  {
   "duration": 1.515,
   "para": 326,
   "start": 1077.768,
   "text": "大国者下流，"
  },
  {
   "duration": 1.123,
   "para": 327,
   "start": 1079.283,
   "text": "天下之交。"
  },
  {
   "duration": 2.116,
   "para": 328,
   "start": 1080.406,
   "text": "天下之牝，"
  },
  {
   "duration": 2.769,
   "para": 329,
   "start": 1082.522,
   "text": "牝常以静胜牡，以静为下。"
  },
  {
   "duration": 1.776,
   "para": 330,
   "start": 1085.291,
   "text": "故大国以下小国，"
  },
  {
   "duration": 1.306,
   "para": 331,
   "start": 1087.067,
   "text": "则取小国；"
  },
  {
   "duration": 2.534,
   "para": 332,
   "start": 1088.373,
   "text": "小国以下大国，则取大国。"
  },
  {
   "duration": 3.213,
   "para": 333,
   "start": 1090.907,
   "text": "故或下以取，或下而取。"
  },
  {
   "duration": 6.792,
   "para": 334,
   "start": 1094.12,
   "text": "大国不过欲兼畜人，小国不过欲入事人。夫两者各得其所欲，大者宜为下。"
  },
  {
   "duration": 1.515,
   "para": 335,
   "start": 1100.912,
   "text": "道者万物之奥。"
  },
  {
   "duration": 1.123,
   "para": 336,
   "start": 1102.427,
   "text": "善人之宝，"
  },
  {
   "duration": 1.463,
   "para": 337,
   "start": 1103.55,
   "text": "不善人之所保。"
  },
  {
   "duration": 2.9,
   "para": 338,
   "start": 1105.013,
   "text": "美言可以市，尊行可以加人。"
  },
  {
   "duration": 2.482,
   "para": 339,
   "start": 1107.913,
   "text": "人之不善，何弃之有？"
  },
  {
   "duration": 2.011,
   "para": 340,
   "start": 1110.395,
   "text": "故立天子，置三公，"
  },
  {
   "duration": 3.318,
   "para": 341,
   "start": 1112.406,
   "text": "虽有拱璧以先驷马，不如坐进此道。"
  },
  {
   "duration": 5.773,
   "para": 342,
   "start": 1115.724,
   "text": "古之所以贵此道者何？不曰以求得，有罪以免邪？故为天下贵。"
  },
  {
   "duration": 3.135,
   "para": 343,
   "start": 1121.497,
   "text": "为无为，事无事，味无味。"
  },
  {
   "duration": 2.377,
   "para": 344,
   "start": 1124.632,
   "text": "大小多少，报怨以德。"
  },
  {
   "duration": 11.207,
   "para": 345,
   "start": 1127.009,
   "text": "图难于其易，为大于其细；天下难事必作于易，天下大事必作于细。是以圣人终不为大，故能成其大。夫轻诺必寡信，多易必多难。是以圣人犹难之，"
  },
  {
   "duration": 1.228,
   "para": 346,
   "start": 1138.216,
   "text": "故终无难矣"
  },
  {
   "duration": 3.448,
   "para": 347,
   "start": 1139.444,
   "text": "其安易持，其未兆易谋。"
  },
  {
   "duration": 2.429,
   "para": 348,
   "start": 1142.892,
   "text": "其脆易泮，其微易散。"
  },
  {
   "duration": 2.064,
   "para": 349,
   "start": 1145.321,
   "text": "为之于未有，"
  },
  {
   "duration": 1.306,
   "para": 350,
   "start": 1147.385,
   "text": "治之于未乱。"
  },
  {
   "duration": 7.262,
   "para": 351,
   "start": 1148.691,
   "text": "合抱之木，生于毫末；九层之台，起于累土；千里之行，始于足下。为者败之，执者失之。"
  },
  {
   "duration": 5.956,
   "para": 352,
   "start": 1155.953,
   "text": "是以圣人无为故无败，无执故无失。民之从事，常于几成而败之。"
  },
  {
   "duration": 5.59,
   "para": 353,
   "start": 1161.909,
   "text": "慎终如始，则无败事。是以圣人欲不欲，不贵难得之货；"
  },
  {
   "duration": 2.482,
   "para": 354,
   "start": 1167.499,
   "text": "学不学，复众人之所过。"
  },
  {
   "duration": 2.9,
   "para": 355,
   "start": 1169.981,
   "text": "以辅万物之自然，而不敢为。"
  },
  {
   "duration": 3.814,
   "para": 356,
   "start": 1172.881,
   "text": "古之善为道者，非以明民，将以愚之。"
  },
  {
   "duration": 2.351,
   "para": 357,
   "start": 1176.695,
   "text": "民之难治，以其智多。"
  },
  {
   "duration": 3.5,
   "para": 358,
   "start": 1179.046,
   "text": "故以智治国，国之贼，"
  },
  {
   "duration": 7.158,
   "para": 359,
   "start": 1182.546,
   "text": "不以智治国，国之福。知此两者亦稽式。常知稽式，是谓玄德。玄德深矣，远矣，"
  },
  {
   "duration": 1.515,
   "para": 360,
   "start": 1189.704,
   "text": "与物反矣，"
  },
  {
   "duration": 1.411,
   "para": 361,
   "start": 1191.219,
   "text": "然后乃至大顺。"
  },
  {
   "duration": 16.823,
   "para": 362,
   "start": 1192.63,
   "text": "江海所以能为百-{谷}-王者，以其善下之，故能为百-{谷}-王。是以欲上民，必以言下之。欲先民，必以身后之。是以圣人处上而民不重，处前而民不害。是以天下乐推而不厌，以其不争，故天下莫能与之争。"
  },
  {
   "duration": 6.844,
   "para": 363,
   "start": 1209.453,
   "text": "天下皆谓我道大，似不肖。夫唯大，故似不肖。若肖，久矣其细也夫！"
  },
  {
   "duration": 6.113,
   "para": 364,
   "start": 1216.297,
   "text": "我有三宝，持而保之。一曰慈，二曰俭，三曰不敢为天下先。"
  },
  {
   "duration": 1.646,
   "para": 365,
   "start": 1222.41,
   "text": "慈故能勇，"
  },
  {
   "duration": 2.482,
   "para": 366,
   "start": 1224.056,
   "text": "俭故能广，"
  },
  {
   "duration": 3.03,
   "para": 367,
   "start": 1226.538,
   "text": "不敢为天下先，故能成器长。"
  },
  {
   "duration": 2.064,
   "para": 368,
   "start": 1229.568,
   "text": "今舍慈且勇，"
  },
  {
   "duration": 3.082,
   "para": 369,
   "start": 1231.632,
   "text": "舍俭且广，舍后且先，死矣！"
  },
  {
   "duration": 1.698,
   "para": 370,
   "start": 1234.714,
   "text": "夫慈以战则胜，"
  },
  {
   "duration": 3.605,
   "para": 371,
   "start": 1236.412,
   "text": "以守则固。天将救之，以慈卫之。"
  },
  {
   "duration": 1.463,
   "para": 372,
   "start": 1240.017,
   "text": "善为士者不武，"
  },
  {
   "duration": 1.698,
   "para": 373,
   "start": 1241.48,
   "text": "善战者不怒，"
  },
  {
   "duration": 2.247,
   "para": 374,
   "start": 1243.178,
   "text": "善胜敌者不与，"
  },
  {
   "duration": 3.971,
   "para": 375,
   "start": 1245.425,
   "text": "善用人者为之下，是谓不争之德，是谓用人之力，"
  },
  {
   "duration": 2.769,
   "para": 376,
   "start": 1249.396,
   "text": "是谓配天古之极。"
  },
  {
   "duration": 5.904,
   "para": 377,
   "start": 1252.165,
   "text": "用兵有言﹕「吾不敢为主而为客，不敢进寸而退尺。」是谓行无行，"
  },
  {
   "duration": 2.612,
   "para": 378,
   "start": 1258.069,
   "text": "攘无臂，扔无敌，"
  },
  {
   "duration": 1.045,
   "para": 379,
   "start": 1260.681,
   "text": "执无兵。"
  },
  {
   "duration": 3.03,
   "para": 380,
   "start": 1261.726,
   "text": "祸莫大于轻敌，轻敌几丧吾宝。"
  },
  {
   "duration": 2.534,
   "para": 381,
   "start": 1264.756,
   "text": "故抗兵相加，哀者胜矣。"
  },
  {
   "duration": 4.519,
   "para": 382,
   "start": 1267.29,
   "text": "吾言甚易知，甚易行。天下莫能知，莫能行。"
  },
  {
   "duration": 2.377,
   "para": 383,
   "start": 1271.809,
   "text": "言有宗，事有君。"
  },
  {
   "duration": 2.612,
   "para": 384,
   "start": 1274.186,
   "text": "夫唯无知，是以不我知。"
  },
  {
   "duration": 2.534,
   "para": 385,
   "start": 1276.798,
   "text": "知我者希，则我者贵。"
  },
  {
   "duration": 1.724,
   "para": 386,
   "start": 1279.332,
   "text": "是以圣人被褐怀玉。"
  },
  {
   "duration": 2.064,
   "para": 387,
   "start": 1281.056,
   "text": "知不知上，不知知病。"
  },
  {
   "duration": 5.825,
   "para": 388,
   "start": 1283.12,
   "text": "夫唯病病，是以不病。圣人不病，以其病病，是以不病。"
  },
  {
   "duration": 4.232,
   "para": 389,
   "start": 1288.945,
   "text": "民不畏威，则大威至。无狎其所居，无厌其所生。"
  },
  {
   "duration": 1.724,
   "para": 390,
   "start": 1293.177,
   "text": "夫唯不厌，"
  },
  {
   "duration": 1.097,
   "para": 391,
   "start": 1294.901,
   "text": "是以不厌。"
  },
  {
   "duration": 2.664,
   "para": 392,
   "start": 1295.998,
   "text": "是以圣人自知不自见，"
  },
  {
   "duration": 1.698,
   "para": 393,
   "start": 1298.662,
   "text": "自爱不自贵；"
  },
  {
   "duration": 1.463,
   "para": 394,
   "start": 1300.36,
   "text": "故去彼取此。"
  },
  {
   "duration": 1.698,
   "para": 395,
   "start": 1301.823,
   "text": "勇于敢则杀，"
  },
  {
   "duration": 1.411,
   "para": 396,
   "start": 1303.521,
   "text": "勇于不敢则活。"
  },
  {
   "duration": 2.351,
   "para": 397,
   "start": 1304.932,
   "text": "此两者，或利或害。"
  },
  {
   "duration": 4.389,
   "para": 398,
   "start": 1307.283,
   "text": "天之所恶，孰知其故？是以圣人犹难之。"
  },
  {
   "duration": 3.03,
   "para": 399,
   "start": 1311.672,
   "text": "天之道，不争而善胜，"
  },
  {
   "duration": 2.064,
   "para": 400,
   "start": 1314.702,
   "text": "不言而善应，"
  },
  {
   "duration": 1.646,
   "para": 401,
   "start": 1316.766,
   "text": "不召而自来，"
  },
  {
   "duration": 1.28,
   "para": 402,
   "start": 1318.412,
   "text": "坦然而善谋。"
  },
  {
   "duration": 1.776,
   "para": 403,
   "start": 1319.692,
   "text": "天网恢恢，疏而不失。"
  },
  {
   "duration": 8.046,
   "para": 404,
   "start": 1321.468,
   "text": "民不畏死，奈何以死惧之？若使民常畏死，而为奇者，吾得执而杀之，孰敢？"
  },
  {
   "duration": 4.441,
   "para": 405,
   "start": 1329.514,
   "text": "常有司杀者杀，夫代司杀者杀，是谓代大匠斲。"
  },
  {
   "duration": 3.135,
   "para": 406,
   "start": 1333.955,
   "text": "夫代大匠斲者，希有不伤其手矣。"
  },
  {
   "duration": 12.513,
   "para": 407,
   "start": 1337.09,
   "text": "民之饥，以其上食税之多，是以饥。民之难治，以其上之有为，是以难治。民之轻死，以其上求生之厚，是以轻死。夫唯无以生为者，是贤于贵生。"
  },
  {
   "duration": 3.082,
   "para": 408,
   "start": 1349.603,
   "text": "人之生也柔弱，其死也坚强。"
  },
  {
   "duration": 3.37,
   "para": 409,
   "start": 1352.685,
   "text": "万物草木之生也柔脆，其死也枯槁。"
  },
  {
   "duration": 3.318,
   "para": 410,
   "start": 1356.055,
   "text": "故坚强者死之徒，柔弱者生之徒。"
  },
  {
   "duration": 2.429,
   "para": 411,
   "start": 1359.373,
   "text": "是以兵强则不胜，"
  },
  {
   "duration": 1.411,
   "para": 412,
   "start": 1361.802,
   "text": "木强则兵。"
  },
  {
   "duration": 0.758,
   "para": 413,
   "start": 1363.213,
   "text": "强大处下，"
  },
  {
   "duration": 1.228,
   "para": 414,
   "start": 1363.971,
   "text": "柔弱处上。"
  },
  {
   "duration": 9.456,
   "para": 415,
   "start": 1365.199,
   "text": "天之道，其犹张弓与？高者抑之，下者举之；有余者损之，不足者补之。天之道，损有余而补不足。"
  },
  {
   "duration": 1.306,
   "para": 416,
   "start": 1374.655,
   "text": "人之道则不然，"
  },
  {
   "duration": 2.116,
   "para": 417,
   "start": 1375.961,
   "text": "损不足以奉有余。"
  },
  {
   "duration": 3.135,
   "para": 418,
   "start": 1378.077,
   "text": "孰能有余以奉天下？唯有道者。"
  },
  {
   "duration": 4.519,
   "para": 419,
   "start": 1381.212,
   "text": "是以圣人为而不恃，功成而不处，其不欲见贤。"
  },
  {
   "duration": 4.807,
   "para": 420,
   "start": 1385.731,
   "text": "天下莫柔弱于水，而攻坚强者，莫之能胜，其无以易之。"
  },
  {
   "duration": 9.77,
   "para": 421,
   "start": 1390.538,
   "text": "弱之胜强，柔之胜刚，天下莫不知莫能行。是以圣人云﹕「受国之垢，是谓社稷主；受国不祥，是为天下王。」正言若反。"
  },
  {
   "duration": 3.265,
   "para": 422,
   "start": 1400.308,
   "text": "和大怨，必有余怨，"
  },
  {
   "duration": 3.03,
   "para": 423,
   "start": 1403.573,
   "text": "安可以为善？是以圣人执左契，"
  },
  {
   "duration": 2.952,
   "para": 424,
   "start": 1406.603,
   "text": "而不责于人。有德司契，"
  },
  {
   "duration": 1.306,
   "para": 425,
   "start": 1409.555,
   "text": "无德司彻。"
  },
  {
   "duration": 1.829,
   "para": 426,
   "start": 1410.861,
   "text": "天道无亲，常与善人。"
  },
  {
   "duration": 1.175,
   "para": 427,
   "start": 1412.69,
   "text": "小国寡民，"
  },
  {
   "duration": 2.194,
   "para": 428,
   "start": 1413.865,
   "text": "使有什伯之器而不用，"
  },
  {
   "duration": 1.829,
   "para": 429,
   "start": 1416.059,
   "text": "使民重死而不远徙。"
  },
  {
   "duration": 4.154,
   "para": 430,
   "start": 1417.888,
   "text": "虽有舟舆，无所乘之；虽有甲兵，无所陈之。"
  },
  {
   "duration": 8.15,
   "para": 431,
   "start": 1422.042,
   "text": "使人复结绳而用之，甘其食，美其服，安其居，乐其俗。邻国相望，鸡犬之声相闻，民至老死，不相往来。"
  },
  {
   "duration": 1.829,
   "para": 432,
   "start": 1430.192,
   "text": "信言不美，"
  },
  {
   "duration": 1.411,
   "para": 433,
   "start": 1432.021,
   "text": "美言不信。"
  },
  {
   "duration": 2.377,
   "para": 434,
   "start": 1433.432,
   "text": "善者不辩，辩者不善。"
  },
  {
   "duration": 1.776,
   "para": 435,
   "start": 1435.809,
   "text": "知者不博，"
  },
  {
   "duration": 1.28,
   "para": 436,
   "start": 1437.585,
   "text": "博者不知。"
  },
  {
   "duration": 1.228,
   "para": 437,
   "start": 1438.865,
   "text": "圣人不积，"
  },
  {
   "duration": 1.306,
   "para": 438,
   "start": 1440.093,
   "text": "既以为人己愈有，"
  },
  {
   "duration": 1.933,
   "para": 439,
   "start": 1441.399,
   "text": "既以与人己愈多。"
  },
  {
   "duration": 2.116,
   "para": 440,
   "start": 1443.332,
   "text": "天之道，利而不害；"
  },
  {
   "duration": 2.064,
   "para": 441,
   "start": 1445.448,
   "text": "圣人之道，为而不争。"
  }
 ],
 "sid": "s07",
 "total_duration": 1447.512,
 "voice": "male"
}
