{"sid": "s26", "voice": "female", "total_duration": 185.59, "segments": [{"para": 0, "start": 0.0, "duration": 2.38, "text": "太上老君说常清静经"}, {"para": 1, "start": 2.38, "duration": 1.51, "text": "老君曰："}, {"para": 2, "start": 3.89, "duration": 2.38, "text": "大道无形，生育天地；"}, {"para": 3, "start": 6.27, "duration": 2.56, "text": "大道无情，运行日月；"}, {"para": 4, "start": 8.83, "duration": 1.83, "text": "大道无名，长养万物；"}, {"para": 5, "start": 10.66, "duration": 2.9, "text": "吾不知其名，强名曰道。"}, {"para": 6, "start": 13.56, "duration": 0.94, "text": "夫道者："}, {"para": 7, "start": 14.5, "duration": 1.96, "text": "有清有浊，有动有静；"}, {"para": 8, "start": 16.46, "duration": 2.43, "text": "天清地浊，天动地静；"}, {"para": 9, "start": 18.89, "duration": 2.43, "text": "男清女浊，男动女静；"}, {"para": 10, "start": 21.32, "duration": 2.12, "text": "降本流末，而生万物。"}, {"para": 11, "start": 23.43, "duration": 1.93, "text": "清者，浊之源，"}, {"para": 12, "start": 25.36, "duration": 2.43, "text": "动者，静之基；"}, {"para": 13, "start": 27.79, "duration": 4.15, "text": "人能常清静，天地悉皆归。"}, {"para": 14, "start": 31.95, "duration": 2.61, "text": "夫人神好清，而心扰之；"}, {"para": 15, "start": 34.56, "duration": 2.3, "text": "人心好静，而欲牵之。"}, {"para": 16, "start": 36.86, "duration": 2.61, "text": "常能遣其欲，而心自静；"}, {"para": 17, "start": 39.47, "duration": 3.55, "text": "澄其心，而神自清；自然六欲不生，"}, {"para": 18, "start": 43.02, "duration": 3.27, "text": "三毒消灭。所以不能者，爲心未澄，"}, {"para": 19, "start": 46.29, "duration": 2.85, "text": "欲未遣也；能遣之者："}, {"para": 20, "start": 49.13, "duration": 2.98, "text": "内观其心，心无其心；"}, {"para": 21, "start": 52.11, "duration": 2.85, "text": "外观其形，形无其形；"}, {"para": 22, "start": 54.96, "duration": 1.96, "text": "远观其物，物无其物；"}, {"para": 23, "start": 56.92, "duration": 2.53, "text": "三者既悟，唯见于空。"}, {"para": 24, "start": 59.45, "duration": 2.9, "text": "观空亦空，空无所空；"}, {"para": 25, "start": 62.35, "duration": 2.35, "text": "所空既无，无无亦无；"}, {"para": 26, "start": 64.7, "duration": 3.21, "text": "无无既无，湛然常寂。"}, {"para": 27, "start": 67.92, "duration": 2.43, "text": "寂无所寂，欲岂能生；"}, {"para": 28, "start": 70.35, "duration": 2.19, "text": "欲既不生，即是真静。"}, {"para": 29, "start": 72.54, "duration": 2.12, "text": "真常应物，真常得性；"}, {"para": 30, "start": 74.66, "duration": 2.98, "text": "常应常静，常清静矣。"}, {"para": 31, "start": 77.63, "duration": 2.35, "text": "如此清静，渐入真道；"}, {"para": 32, "start": 79.98, "duration": 2.48, "text": "既入真道，名爲得道；"}, {"para": 33, "start": 82.47, "duration": 2.95, "text": "虽名得道，实无所得；"}, {"para": 34, "start": 85.42, "duration": 2.77, "text": "爲化众生，名爲得道；"}, {"para": 35, "start": 88.19, "duration": 2.56, "text": "能悟之者，可传圣道。"}, {"para": 36, "start": 90.75, "duration": 1.1, "text": "老君曰："}, {"para": 37, "start": 91.84, "duration": 1.96, "text": "上士无争，下士好争；"}, {"para": 38, "start": 93.8, "duration": 2.12, "text": "上德不德，下德执德；"}, {"para": 39, "start": 95.92, "duration": 2.12, "text": "执著之者，不名道德。"}, {"para": 40, "start": 98.03, "duration": 2.35, "text": "众生所以不得真道者，"}, {"para": 41, "start": 100.39, "duration": 2.61, "text": "爲有妄心；既有妄心，"}, {"para": 42, "start": 103.0, "duration": 3.27, "text": "即惊其神；既惊其神，"}, {"para": 43, "start": 106.26, "duration": 1.83, "text": "即著万物；既著万物，"}, {"para": 44, "start": 108.09, "duration": 2.53, "text": "即生贪求；既生贪求，"}, {"para": 45, "start": 110.62, "duration": 2.77, "text": "即是烦恼；烦恼妄想，"}, {"para": 46, "start": 113.39, "duration": 2.66, "text": "忧苦身心；便遭浊辱，"}, {"para": 47, "start": 116.06, "duration": 2.98, "text": "流浪生死；常沉苦海，"}, {"para": 48, "start": 119.04, "duration": 3.03, "text": "永失真道。真常之道，"}, {"para": 49, "start": 122.07, "duration": 2.85, "text": "悟者自得；得悟道者，"}, {"para": 50, "start": 124.91, "duration": 1.36, "text": "常清静矣！"}, {"para": 51, "start": 126.27, "duration": 1.41, "text": "仙人葛翁曰："}, {"para": 52, "start": 127.68, "duration": 3.5, "text": "吾得真道，曾诵此经万遍。"}, {"para": 53, "start": 131.18, "duration": 2.85, "text": "此经是天人所习，不传下士。"}, {"para": 54, "start": 134.03, "duration": 5.3, "text": "吾昔受之于东华帝君，东华帝君受之于金阙帝君，"}, {"para": 55, "start": 139.33, "duration": 4.65, "text": "金阙帝君受之于西王母。西王母皆口口相传，"}, {"para": 56, "start": 143.98, "duration": 4.39, "text": "不记文字。吾今于世，书而录之。"}, {"para": 57, "start": 148.37, "duration": 4.34, "text": "上士悟之，升爲天仙；中士修之，南宫列仙；"}, {"para": 58, "start": 152.71, "duration": 5.59, "text": "下士得之，在世长年。游行三界，升入金门。"}, {"para": 59, "start": 158.3, "duration": 1.65, "text": "左玄真人曰："}, {"para": 60, "start": 159.94, "duration": 4.21, "text": "学道之士，持诵此经者，即得十天善神，擁护其身。"}, {"para": 61, "start": 164.15, "duration": 4.47, "text": "然后玉符保神，金液炼形。形神俱妙，与道合真。"}, {"para": 62, "start": 168.61, "duration": 1.36, "text": "正一真人曰："}, {"para": 63, "start": 169.97, "duration": 1.31, "text": "人家有此经，"}, {"para": 64, "start": 171.28, "duration": 2.43, "text": "悟解之者，灾障不干，"}, {"para": 65, "start": 173.71, "duration": 3.21, "text": "众圣护门。神升上界，"}, {"para": 66, "start": 176.92, "duration": 2.53, "text": "朝拜高真。功满德就，"}, {"para": 67, "start": 179.46, "duration": 1.96, "text": "相感帝君。诵持不退，"}, {"para": 68, "start": 181.41, "duration": 1.46, "text": "身腾紫云。"}, {"para": 69, "start": 182.88, "duration": 2.72, "text": "太上老君说常清静经卷终"}]}