{
 "segments": [
  {
   "duration": 2.377,
   "para": 0,
   "start": 0.0,
   "text": "太上老君说常清静经"
  },
  {
   "duration": 1.515,
   "para": 1,
   "start": 2.377,
   "text": "老君曰："
  },
  {
   "duration": 2.377,
   "para": 2,
   "start": 3.892,
   "text": "大道无形，生育天地；"
  },
  {
   "duration": 2.56,
   "para": 3,
   "start": 6.269,
   "text": "大道无情，运行日月；"
  },
  {
   "duration": 1.829,
   "para": 4,
   "start": 8.829,
   "text": "大道无名，长养万物；"
  },
  {
   "duration": 2.9,
   "para": 5,
   "start": 10.658,
   "text": "吾不知其名，强名曰道。"
  },
  {
   "duration": 0.94,
   "para": 6,
   "start": 13.558,
   "text": "夫道者："
  },
  {
   "duration": 1.959,
   "para": 7,
   "start": 14.498,
   "text": "有清有浊，有动有静；"
  },
  {
   "duration": 2.429,
   "para": 8,
   "start": 16.457,
   "text": "天清地浊，天动地静；"
  },
  {
   "duration": 2.429,
   "para": 9,
   "start": 18.886,
   "text": "男清女浊，男动女静；"
  },
  {
   "duration": 2.116,
   "para": 10,
   "start": 21.315,
   "text": "降本流末，而生万物。"
  },
  {
   "duration": 1.933,
   "para": 11,
   "start": 23.431,
   "text": "清者，浊之源，"
  },
  {
   "duration": 2.429,
   "para": 12,
   "start": 25.364,
   "text": "动者，静之基；"
  },
  {
   "duration": 4.154,
   "para": 13,
   "start": 27.793,
   "text": "人能常清静，天地悉皆归。"
  },
  {
   "duration": 2.612,
   "para": 14,
   "start": 31.947,
   "text": "夫人神好清，而心扰之；"
  },
  {
   "duration": 2.299,
   "para": 15,
   "start": 34.559,
   "text": "人心好静，而欲牵之。"
  },
  {
   "duration": 2.612,
   "para": 16,
   "start": 36.858,
   "text": "常能遣其欲，而心自静；"
  },
  {
   "duration": 3.553,
   "para": 17,
   "start": 39.47,
   "text": "澄其心，而神自清；自然六欲不生，"
  },
  {
   "duration": 3.265,
   "para": 18,
   "start": 43.023,
   "text": "三毒消灭。所以不能者，爲心未澄，"
  },
  {
   "duration": 2.847,
   "para": 19,
   "start": 46.288,
   "text": "欲未遣也；能遣之者："
  },
  {
   "duration": 2.978,
   "para": 20,
   "start": 49.135,
   "text": "内观其心，心无其心；"
  },
  {
   "duration": 2.847,
   "para": 21,
   "start": 52.113,
   "text": "外观其形，形无其形；"
  },
  {
   "duration": 1.959,
   "para": 22,
   "start": 54.96,
   "text": "远观其物，物无其物；"
  },
  {
   "duration": 2.534,
   "para": 23,
   "start": 56.919,
   "text": "三者既悟，唯见于空。"
  },
  {
   "duration": 2.9,
   "para": 24,
   "start": 59.453,
   "text": "观空亦空，空无所空；"
  },
  {
   "duration": 2.351,
   "para": 25,
   "start": 62.353,
   "text": "所空既无，无无亦无；"
  },
  {
   "duration": 3.213,
   "para": 26,
   "start": 64.704,
   "text": "无无既无，湛然常寂。"
  },
  {
   "duration": 2.429,
   "para": 27,
   "start": 67.917,
   "text": "寂无所寂，欲岂能生；"
  },
  {
   "duration": 2.194,
   "para": 28,
   "start": 70.346,
   "text": "欲既不生，即是真静。"
  },
  {
   "duration": 2.482,
   "para": 29,
   "start": 72.54,
   "text": "真常应物，真常得性；"
  },
  {
   "duration": 2.482,
   "para": 30,
   "start": 75.022,
   "text": "常应常静，常清静矣。"
  },
  {
   "duration": 2.351,
   "para": 31,
   "start": 77.504,
   "text": "如此清静，渐入真道；"
  },
  {
   "duration": 2.482,
   "para": 32,
   "start": 79.855,
   "text": "既入真道，名爲得道；"
  },
  {
   "duration": 2.952,
   "para": 33,
   "start": 82.337,
   "text": "虽名得道，实无所得；"
  },
  {
   "duration": 2.769,
   "para": 34,
   "start": 85.289,
   "text": "爲化众生，名爲得道；"
  },
  {
   "duration": 2.56,
   "para": 35,
   "start": 88.058,
   "text": "能悟之者，可传圣道。"
  },
  {
   "duration": 1.097,
   "para": 36,
   "start": 90.618,
   "text": "老君曰："
  },
  {
   "duration": 1.959,
   "para": 37,
   "start": 91.715,
   "text": "上士无争，下士好争；"
  },
  {
   "duration": 2.116,
   "para": 38,
   "start": 93.674,
   "text": "上德不德，下德执德；"
  },
  {
   "duration": 2.116,
   "para": 39,
   "start": 95.79,
   "text": "执著之者，不名道德。"
  },
  {
   "duration": 2.351,
   "para": 40,
   "start": 97.906,
   "text": "众生所以不得真道者，"
  },
  {
   "duration": 2.612,
   "para": 41,
   "start": 100.257,
   "text": "爲有妄心；既有妄心，"
  },
  {
   "duration": 3.265,
   "para": 42,
   "start": 102.869,
   "text": "即惊其神；既惊其神，"
  },
  {
   "duration": 1.829,
   "para": 43,
   "start": 106.134,
   "text": "即著万物；既著万物，"
  },
  {
   "duration": 2.534,
   "para": 44,
   "start": 107.963,
   "text": "即生贪求；既生贪求，"
  },
  {
   "duration": 2.769,
   "para": 45,
   "start": 110.497,
   "text": "即是烦恼；烦恼妄想，"
  },
  {
   "duration": 2.664,
   "para": 46,
   "start": 113.266,
   "text": "忧苦身心；便遭浊辱，"
  },
  {
   "duration": 2.978,
   "para": 47,
   "start": 115.93,
   "text": "流浪生死；常沉苦海，"
  },
  {
   "duration": 3.03,
   "para": 48,
   "start": 118.908,
   "text": "永失真道。真常之道，"
  },
  {
   "duration": 2.847,
   "para": 49,
   "start": 121.938,
   "text": "悟者自得；得悟道者，"
  },
  {
   "duration": 1.358,
   "para": 50,
   "start": 124.785,
   "text": "常清静矣！"
  },
  {
   "duration": 1.411,
   "para": 51,
   "start": 126.143,
   "text": "仙人葛翁曰："
  },
  {
   "duration": 3.5,
   "para": 52,
   "start": 127.554,
   "text": "吾得真道，曾诵此经万遍。"
  },
  {
   "duration": 2.847,
   "para": 53,
   "start": 131.054,
   "text": "此经是天人所习，不传下士。"
  },
  {
   "duration": 5.303,
   "para": 54,
   "start": 133.901,
   "text": "吾昔受之于东华帝君，东华帝君受之于金阙帝君，"
  },
  {
   "duration": 4.65,
   "para": 55,
   "start": 139.204,
   "text": "金阙帝君受之于西王母。西王母皆口口相传，"
  },
  {
   "duration": 4.389,
   "para": 56,
   "start": 143.854,
   "text": "不记文字。吾今于世，书而录之。"
  },
  {
   "duration": 4.336,
   "para": 57,
   "start": 148.243,
   "text": "上士悟之，升爲天仙；中士修之，南宫列仙；"
  },
  {
   "duration": 5.59,
   "para": 58,
   "start": 152.579,
   "text": "下士得之，在世长年。游行三界，升入金门。"
  },
  {
   "duration": 1.646,
   "para": 59,
   "start": 158.169,
   "text": "左玄真人曰："
  },
  {
   "duration": 4.206,
   "para": 60,
   "start": 159.815,
   "text": "学道之士，持诵此经者，即得十天善神，擁护其身。"
  },
  {
   "duration": 4.467,
   "para": 61,
   "start": 164.021,
   "text": "然后玉符保神，金液炼形。形神俱妙，与道合真。"
  },
  {
   "duration": 1.358,
   "para": 62,
   "start": 168.488,
   "text": "正一真人曰："
  },
  {
   "duration": 1.306,
   "para": 63,
   "start": 169.846,
   "text": "人家有此经，"
  },
  {
   "duration": 2.429,
   "para": 64,
   "start": 171.152,
   "text": "悟解之者，灾障不干，"
  },
  {
   "duration": 3.213,
   "para": 65,
   "start": 173.581,
   "text": "众圣护门。神升上界，"
  },
  {
   "duration": 2.534,
   "para": 66,
   "start": 176.794,
   "text": "朝拜高真。功满德就，"
  },
  {
   "duration": 1.959,
   "para": 67,
   "start": 179.328,
   "text": "相感帝君。诵持不退，"
  },
  {
   "duration": 1.463,
   "para": 68,
   "start": 181.287,
   "text": "身腾紫云。"
  },
  {
   "duration": 2.717,
   "para": 69,
   "start": 182.75,
   "text": "太上老君说常清静经卷终"
  }
 ],
 "sid": "s26",
 "total_duration": 185.467,
 "voice": "female"
}
