{
 "segments": [
  {
   "duration": 1.463,
   "para": 0,
   "start": 0.0,
   "text": "临水夫人宝诰"
  },
  {
   "duration": 1.306,
   "para": 1,
   "start": 1.463,
   "text": "志心皈命礼。"
  },
  {
   "duration": 2.482,
   "para": 2,
   "start": 2.769,
   "text": "八閩毓秀，大士化身。"
  },
  {
   "duration": 2.9,
   "para": 3,
   "start": 5.251,
   "text": "少悟玄极，顶礼慈航宝相；"
  },
  {
   "duration": 2.664,
   "para": 4,
   "start": 8.151,
   "text": "长成道果，拜参法主朱门。"
  },
  {
   "duration": 2.769,
   "para": 5,
   "start": 10.815,
   "text": "龙角轻吹，声彻九天响应；"
  },
  {
   "duration": 2.534,
   "para": 6,
   "start": 13.584,
   "text": "风旗高展，威传十地安宁。"
  },
  {
   "duration": 2.978,
   "para": 7,
   "start": 16.118,
   "text": "锁蛇怪于坛中，群妖扫荡；"
  },
  {
   "duration": 2.847,
   "para": 8,
   "start": 19.096,
   "text": "保童婴于闈中，众妇蒙恩。"
  },
  {
   "duration": 4.206,
   "para": 9,
   "start": 21.943,
   "text": "法转玄功，炼度三十六宫毓麟婆者；"
  },
  {
   "duration": 3.631,
   "para": 10,
   "start": 26.149,
   "text": "丹生白骨，超拔七十二苑解疫女神。"
  },
  {
   "duration": 2.664,
   "para": 11,
   "start": 29.78,
   "text": "合三奶以同心，功存社稷；"
  },
  {
   "duration": 2.534,
   "para": 12,
   "start": 32.444,
   "text": "会九淑而崇道，泽注尘环。"
  },
  {
   "duration": 2.612,
   "para": 13,
   "start": 34.978,
   "text": "护法随传，召遣王杨太保；"
  },
  {
   "duration": 2.612,
   "para": 14,
   "start": 37.59,
   "text": "灵心默化，度收大圣丹霞。"
  },
  {
   "duration": 2.978,
   "para": 15,
   "start": 40.202,
   "text": "救世拯民，祈甘露于左海；"
  },
  {
   "duration": 2.847,
   "para": 16,
   "start": 43.18,
   "text": "勤王护国，除巨恶于三山。"
  },
  {
   "duration": 2.664,
   "para": 17,
   "start": 46.027,
   "text": "懿德高超，玉诏荣封圣母；"
  },
  {
   "duration": 3.03,
   "para": 18,
   "start": 48.691,
   "text": "慈云广覆，金炉拜参元君。"
  },
  {
   "duration": 2.56,
   "para": 19,
   "start": 51.721,
   "text": "大悲大愿，大圣大慈。"
  },
  {
   "duration": 5.956,
   "para": 20,
   "start": 54.281,
   "text": "顺天圣母，临水清宁，普化碧霞太后，保童注生，昭惠崇福救世元君。"
  }
 ],
 "sid": "s28",
 "total_duration": 60.237,
 "voice": "male"
}
