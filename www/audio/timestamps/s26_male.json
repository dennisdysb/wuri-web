{
 "sid": "s26",
 "voice": "male",
 "total_duration": 202.0,
 "segments": [
  {
   "para": 0,
   "start": 0.0,
   "duration": 4.93,
   "text": "太上老君說常清靜經"
  },
  {
   "para": 1,
   "start": 4.93,
   "duration": 2.04,
   "text": "老君曰："
  },
  {
   "para": 2,
   "start": 6.97,
   "duration": 2.86,
   "text": "大道無形，生育天地；"
  },
  {
   "para": 3,
   "start": 9.83,
   "duration": 3.06,
   "text": "大道無情，運行日月；"
  },
  {
   "para": 4,
   "start": 12.89,
   "duration": 2.83,
   "text": "大道無名，長養萬物；"
  },
  {
   "para": 5,
   "start": 15.72,
   "duration": 3.08,
   "text": "吾不知其名，強名曰道。"
  },
  {
   "para": 6,
   "start": 18.8,
   "duration": 1.66,
   "text": "夫道者："
  },
  {
   "para": 7,
   "start": 20.46,
   "duration": 2.79,
   "text": "有清有濁，有動有靜；"
  },
  {
   "para": 8,
   "start": 23.25,
   "duration": 2.86,
   "text": "天清地濁，天動地靜；"
  },
  {
   "para": 9,
   "start": 26.11,
   "duration": 2.39,
   "text": "男清女濁，男動女靜；"
  },
  {
   "para": 10,
   "start": 28.5,
   "duration": 2.93,
   "text": "降本流末，而生萬物。"
  },
  {
   "para": 11,
   "start": 31.43,
   "duration": 1.73,
   "text": "清者，濁之源，"
  },
  {
   "para": 12,
   "start": 33.16,
   "duration": 1.82,
   "text": "動者，靜之基；"
  },
  {
   "para": 13,
   "start": 34.98,
   "duration": 3.89,
   "text": "人能常清靜，天地悉皆歸。"
  },
  {
   "para": 14,
   "start": 38.87,
   "duration": 3.0,
   "text": "夫人神好清，而心擾之；"
  },
  {
   "para": 15,
   "start": 41.87,
   "duration": 3.02,
   "text": "人心好靜，而欲牽之。"
  },
  {
   "para": 16,
   "start": 44.89,
   "duration": 2.73,
   "text": "常能遣其欲，而心自靜；"
  },
  {
   "para": 17,
   "start": 47.62,
   "duration": 4.64,
   "text": "澄其心，而神自清；自然六慾不生，"
  },
  {
   "para": 18,
   "start": 52.26,
   "duration": 3.71,
   "text": "三毒消滅。所以不能者，爲心未澄，"
  },
  {
   "para": 19,
   "start": 55.97,
   "duration": 2.73,
   "text": "欲未遣也；能遣之者："
  },
  {
   "para": 20,
   "start": 58.7,
   "duration": 2.47,
   "text": "內觀其心，心無其心；"
  },
  {
   "para": 21,
   "start": 61.17,
   "duration": 3.07,
   "text": "外觀其形，形無其形；"
  },
  {
   "para": 22,
   "start": 64.24,
   "duration": 2.17,
   "text": "遠觀其物，物無其物；"
  },
  {
   "para": 23,
   "start": 66.41,
   "duration": 2.78,
   "text": "三者既悟，唯見於空。"
  },
  {
   "para": 24,
   "start": 69.19,
   "duration": 2.46,
   "text": "觀空亦空，空無所空；"
  },
  {
   "para": 25,
   "start": 71.65,
   "duration": 2.3,
   "text": "所空既無，無無亦無；"
  },
  {
   "para": 26,
   "start": 73.95,
   "duration": 2.6,
   "text": "無無既無，湛然常寂。"
  },
  {
   "para": 27,
   "start": 76.55,
   "duration": 2.82,
   "text": "寂無所寂，欲豈能生；"
  },
  {
   "para": 28,
   "start": 79.37,
   "duration": 2.28,
   "text": "欲既不生，即是真靜。"
  },
  {
   "para": 29,
   "start": 81.65,
   "duration": 2.58,
   "text": "真常應物，真常得性；"
  },
  {
   "para": 30,
   "start": 84.23,
   "duration": 2.78,
   "text": "常應常靜，常清靜矣。"
  },
  {
   "para": 31,
   "start": 87.01,
   "duration": 2.76,
   "text": "如此清靜，漸入真道；"
  },
  {
   "para": 32,
   "start": 89.77,
   "duration": 2.33,
   "text": "既入真道，名爲得道；"
  },
  {
   "para": 33,
   "start": 92.1,
   "duration": 2.42,
   "text": "雖名得道，實無所得；"
  },
  {
   "para": 34,
   "start": 94.52,
   "duration": 2.69,
   "text": "爲化衆生，名爲得道；"
  },
  {
   "para": 35,
   "start": 97.21,
   "duration": 2.88,
   "text": "能悟之者，可傳聖道。"
  },
  {
   "para": 36,
   "start": 100.09,
   "duration": 1.98,
   "text": "老君曰："
  },
  {
   "para": 37,
   "start": 102.07,
   "duration": 2.3,
   "text": "上士無爭，下士好爭；"
  },
  {
   "para": 38,
   "start": 104.37,
   "duration": 2.88,
   "text": "上德不德，下德執德；"
  },
  {
   "para": 39,
   "start": 107.25,
   "duration": 2.05,
   "text": "執著之者，不名道德。"
  },
  {
   "para": 40,
   "start": 109.3,
   "duration": 1.96,
   "text": "衆生所以不得真道者，"
  },
  {
   "para": 41,
   "start": 111.26,
   "duration": 2.86,
   "text": "爲有妄心；既有妄心，"
  },
  {
   "para": 42,
   "start": 114.12,
   "duration": 2.36,
   "text": "即驚其神；既驚其神，"
  },
  {
   "para": 43,
   "start": 116.48,
   "duration": 2.56,
   "text": "即著萬物；既著萬物，"
  },
  {
   "para": 44,
   "start": 119.04,
   "duration": 2.28,
   "text": "即生貪求；既生貪求，"
  },
  {
   "para": 45,
   "start": 121.32,
   "duration": 2.4,
   "text": "即是煩惱；煩惱妄想，"
  },
  {
   "para": 46,
   "start": 123.72,
   "duration": 2.43,
   "text": "憂苦身心；便遭濁辱，"
  },
  {
   "para": 47,
   "start": 126.15,
   "duration": 2.3,
   "text": "流浪生死；常沉苦海，"
  },
  {
   "para": 48,
   "start": 128.45,
   "duration": 2.64,
   "text": "永失真道。真常之道，"
  },
  {
   "para": 49,
   "start": 131.09,
   "duration": 2.1,
   "text": "悟者自得；得悟道者，"
  },
  {
   "para": 50,
   "start": 133.19,
   "duration": 2.43,
   "text": "常清靜矣！"
  },
  {
   "para": 51,
   "start": 135.62,
   "duration": 2.58,
   "text": "仙人葛翁曰："
  },
  {
   "para": 52,
   "start": 138.2,
   "duration": 2.7,
   "text": "吾得真道，曾誦此經萬遍。"
  },
  {
   "para": 53,
   "start": 140.9,
   "duration": 3.38,
   "text": "此經是天人所習，不傳下士。"
  },
  {
   "para": 54,
   "start": 144.28,
   "duration": 6.28,
   "text": "吾昔受之於東華帝君，東華帝君受之於金闕帝君，"
  },
  {
   "para": 55,
   "start": 150.56,
   "duration": 5.68,
   "text": "金闕帝君受之於西王母。西王母皆口口相傳，"
  },
  {
   "para": 56,
   "start": 156.24,
   "duration": 3.18,
   "text": "不記文字。吾今於世，書而錄之。"
  },
  {
   "para": 57,
   "start": 159.42,
   "duration": 4.26,
   "text": "上士悟之，升爲天仙；中士修之，南宮列仙；"
  },
  {
   "para": 58,
   "start": 163.68,
   "duration": 5.15,
   "text": "下士得之，在世長年。遊行三界，升入金門。"
  },
  {
   "para": 59,
   "start": 168.83,
   "duration": 2.06,
   "text": "左玄真人曰："
  },
  {
   "para": 60,
   "start": 170.89,
   "duration": 5.81,
   "text": "學道之士，持誦此經者，即得十天善神，擁護其身。"
  },
  {
   "para": 61,
   "start": 176.7,
   "duration": 5.78,
   "text": "然後玉符保神，金液鍊形。形神俱妙，與道合真。"
  },
  {
   "para": 62,
   "start": 182.48,
   "duration": 2.08,
   "text": "正一真人曰："
  },
  {
   "para": 63,
   "start": 184.56,
   "duration": 1.64,
   "text": "人家有此經，"
  },
  {
   "para": 64,
   "start": 186.2,
   "duration": 2.31,
   "text": "悟解之者，災障不幹，"
  },
  {
   "para": 65,
   "start": 188.51,
   "duration": 2.59,
   "text": "衆聖護門。神升上界，"
  },
  {
   "para": 66,
   "start": 191.1,
   "duration": 2.3,
   "text": "朝拜高真。功滿德就，"
  },
  {
   "para": 67,
   "start": 193.4,
   "duration": 2.18,
   "text": "相感帝君。誦持不退，"
  },
  {
   "para": 68,
   "start": 195.58,
   "duration": 1.58,
   "text": "身騰紫雲。"
  },
  {
   "para": 69,
   "start": 197.16,
   "duration": 4.84,
   "text": "太上老君說常清靜經卷終"
  }
 ]
}