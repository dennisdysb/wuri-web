{
 "sid": "s27",
 "voice": "male",
 "total_duration": 74.6,
 "segments": [
  {
   "para": 0,
   "start": 0.0,
   "duration": 3.96,
   "text": "高上玉皇心印妙經"
  },
  {
   "para": 1,
   "start": 3.96,
   "duration": 2.76,
   "text": "上藥三品，神與氣精。"
  },
  {
   "para": 2,
   "start": 6.72,
   "duration": 2.98,
   "text": "恍恍惚惚，杳杳冥冥。"
  },
  {
   "para": 3,
   "start": 9.7,
   "duration": 2.58,
   "text": "存無守有，頃刻而成。"
  },
  {
   "para": 4,
   "start": 12.28,
   "duration": 3.34,
   "text": "迴風混合，百日功靈。"
  },
  {
   "para": 5,
   "start": 15.62,
   "duration": 2.58,
   "text": "默朝上帝，一紀飛昇。"
  },
  {
   "para": 6,
   "start": 18.2,
   "duration": 2.86,
   "text": "知者易悟，昧者難行。"
  },
  {
   "para": 7,
   "start": 21.06,
   "duration": 2.36,
   "text": "履踐天光，呼吸育清。"
  },
  {
   "para": 8,
   "start": 23.42,
   "duration": 3.06,
   "text": "出玄入牝，若亡若存。"
  },
  {
   "para": 9,
   "start": 26.48,
   "duration": 2.26,
   "text": "綿綿不絕，固蒂根深。"
  },
  {
   "para": 10,
   "start": 28.74,
   "duration": 2.78,
   "text": "人各有精，精合其神。"
  },
  {
   "para": 11,
   "start": 31.52,
   "duration": 2.52,
   "text": "神合其氣，氣合其真。"
  },
  {
   "para": 12,
   "start": 34.04,
   "duration": 2.72,
   "text": "不得其真，皆是強名。"
  },
  {
   "para": 13,
   "start": 36.76,
   "duration": 2.42,
   "text": "神能入石，神能飛形。"
  },
  {
   "para": 14,
   "start": 39.18,
   "duration": 2.78,
   "text": "入水不溺，入火不焚。"
  },
  {
   "para": 15,
   "start": 41.96,
   "duration": 2.56,
   "text": "神依形生，精依氣盈。"
  },
  {
   "para": 16,
   "start": 44.52,
   "duration": 2.68,
   "text": "不凋不殘，松柏青青。"
  },
  {
   "para": 17,
   "start": 47.2,
   "duration": 2.24,
   "text": "三品一理，妙不可聽。"
  },
  {
   "para": 18,
   "start": 49.44,
   "duration": 2.86,
   "text": "其聚則有，其散則零。"
  },
  {
   "para": 19,
   "start": 52.3,
   "duration": 2.34,
   "text": "七竅相通，竅竅光明。"
  },
  {
   "para": 20,
   "start": 54.64,
   "duration": 2.66,
   "text": "聖日聖月，照耀金庭。"
  },
  {
   "para": 21,
   "start": 57.3,
   "duration": 2.32,
   "text": "一得永得，自然身輕。"
  },
  {
   "para": 22,
   "start": 59.62,
   "duration": 2.4,
   "text": "太和充溢，骨散寒瓊。"
  },
  {
   "para": 23,
   "start": 62.02,
   "duration": 2.62,
   "text": "得丹則靈，不得則傾。"
  },
  {
   "para": 24,
   "start": 64.64,
   "duration": 2.56,
   "text": "丹在心中，非白非青。"
  },
  {
   "para": 25,
   "start": 67.2,
   "duration": 3.26,
   "text": "誦之萬遍，妙理自明。"
  },
  {
   "para": 26,
   "start": 70.46,
   "duration": 4.14,
   "text": "高上玉皇心印妙經卷終"
  }
 ]
}