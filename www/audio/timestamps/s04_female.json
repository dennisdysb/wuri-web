{
 "segments": [
  {
   "duration": 2.612,
   "para": 0,
   "start": 0.0,
   "text": "太上玄灵北斗本命延生真经"
  },
  {
   "duration": 1.776,
   "para": 1,
   "start": 2.612,
   "text": "开经玄蕴咒"
  },
  {
   "duration": 2.351,
   "para": 2,
   "start": 4.388,
   "text": "寂寂至无宗。虚峙劫仞阿。"
  },
  {
   "duration": 4.519,
   "para": 3,
   "start": 6.739,
   "text": "豁落洞玄文。谁测此幽遐。"
  },
  {
   "duration": 2.664,
   "para": 4,
   "start": 11.258,
   "text": "一入大乘路。孰计年劫多。"
  },
  {
   "duration": 2.847,
   "para": 5,
   "start": 13.922,
   "text": "不生亦不灭。欲生因莲花。"
  },
  {
   "duration": 3.03,
   "para": 6,
   "start": 16.769,
   "text": "超凌三界途。慈心解世罗。"
  },
  {
   "duration": 3.03,
   "para": 7,
   "start": 19.799,
   "text": "真人无上德。世世为仙家。"
  },
  {
   "duration": 4.206,
   "para": 8,
   "start": 22.829,
   "text": "尔时太上老君以永寿元年正月七日。"
  },
  {
   "duration": 5.068,
   "para": 9,
   "start": 27.035,
   "text": "在太清境上。太极宫中。观见众生亿劫漂沉。"
  },
  {
   "duration": 5.59,
   "para": 10,
   "start": 32.103,
   "text": "周回生死。或居人道。生在中华。或生夷狄之中。或生蛮戎之内。"
  },
  {
   "duration": 6.295,
   "para": 11,
   "start": 37.693,
   "text": "或富或贵。或贱或贫。暂假因缘。堕于地狱。为无定故。"
  },
  {
   "duration": 6.661,
   "para": 12,
   "start": 43.988,
   "text": "罪业牵缠。魂系阴司。受苦满足。人道将违。"
  },
  {
   "duration": 3.187,
   "para": 13,
   "start": 50.649,
   "text": "生居畜兽之中。或生禽虫之属。"
  },
  {
   "duration": 5.407,
   "para": 14,
   "start": 53.836,
   "text": "转乖人道。难复人身。如此沉沦。不知自觉。"
  },
  {
   "duration": 2.952,
   "para": 15,
   "start": 59.243,
   "text": "为先世迷真之故。受此轮回。"
  },
  {
   "duration": 3.918,
   "para": 16,
   "start": 62.195,
   "text": "乃以哀悯之心。分身教化。化身下降。"
  },
  {
   "duration": 4.807,
   "para": 17,
   "start": 66.113,
   "text": "至于蜀都。地神涌出。扶一玉局。而作高座。"
  },
  {
   "duration": 3.918,
   "para": 18,
   "start": 70.92,
   "text": "于是老君升玉局坐。授与天师北斗本命经诀。"
  },
  {
   "duration": 2.247,
   "para": 19,
   "start": 74.838,
   "text": "广宣要法。普济众生。"
  },
  {
   "duration": 1.881,
   "para": 20,
   "start": 77.085,
   "text": "是时老君告天师曰。"
  },
  {
   "duration": 5.355,
   "para": 21,
   "start": 78.966,
   "text": "人身难得。中土难生。假使得生。正法难遇。"
  },
  {
   "duration": 5.277,
   "para": 22,
   "start": 84.321,
   "text": "多迷真道。多入邪宗。多种罪根。多肆巧诈。"
  },
  {
   "duration": 4.859,
   "para": 23,
   "start": 89.598,
   "text": "多恣淫杀。多好群情。多纵贪嗔。多沉地狱。"
  },
  {
   "duration": 1.411,
   "para": 24,
   "start": 94.457,
   "text": "多失人身。"
  },
  {
   "duration": 4.624,
   "para": 25,
   "start": 95.868,
   "text": "如此等缘。众生不悟。不知正道。迷惑者多。"
  },
  {
   "duration": 3.788,
   "para": 26,
   "start": 100.492,
   "text": "我今哀见此等众生。故垂法教。"
  },
  {
   "duration": 4.65,
   "para": 27,
   "start": 104.28,
   "text": "为说良缘。令使知道。知身性命。皆凭道生。"
  },
  {
   "duration": 4.624,
   "para": 28,
   "start": 108.93,
   "text": "了悟此因。长生人道。种子不绝。世世为人。"
  },
  {
   "duration": 2.9,
   "para": 29,
   "start": 113.554,
   "text": "不生无道之乡。不断人之根本。"
  },
  {
   "duration": 4.154,
   "para": 30,
   "start": 116.454,
   "text": "更能心修正道。渐入仙宗。永离轮回。超升成道。"
  },
  {
   "duration": 7.262,
   "para": 31,
   "start": 120.608,
   "text": "我故示汝妙法。令度天民归真知命。可以本命之日修斋设醮。"
  },
  {
   "duration": 5.303,
   "para": 32,
   "start": 127.87,
   "text": "启祝北斗。三官五帝。九府四司。荐福消灾。"
  },
  {
   "duration": 5.277,
   "para": 33,
   "start": 133.173,
   "text": "奏章恳愿。虔诚献礼。种种香花。时新五果。"
  },
  {
   "duration": 4.519,
   "para": 34,
   "start": 138.45,
   "text": "随世威仪。清净坛宇。法天象地。或于观宇。"
  },
  {
   "duration": 4.65,
   "para": 35,
   "start": 142.969,
   "text": "或在家庭。随力建功。请行法事。功德深重。"
  },
  {
   "duration": 1.097,
   "para": 36,
   "start": 147.619,
   "text": "不可具陈。"
  },
  {
   "duration": 2.952,
   "para": 37,
   "start": 148.716,
   "text": "念此大圣北斗七元真君名号。"
  },
  {
   "duration": 5.224,
   "para": 38,
   "start": 151.668,
   "text": "当得罪业消除。灾愆洗荡。福寿资命。善果臻身。"
  },
  {
   "duration": 4.101,
   "para": 39,
   "start": 156.892,
   "text": "凡有急难。可以焚香诵经。克期安泰。"
  },
  {
   "duration": 2.612,
   "para": 40,
   "start": 160.993,
   "text": "于是大圣北斗解厄应验曰。"
  },
  {
   "duration": 4.206,
   "para": 41,
   "start": 163.605,
   "text": "大圣北斗七元君。能解三灾厄。"
  },
  {
   "duration": 3.736,
   "para": 42,
   "start": 167.811,
   "text": "大圣北斗七元君。能解四杀厄。"
  },
  {
   "duration": 3.814,
   "para": 43,
   "start": 171.547,
   "text": "大圣北斗七元君。能解五行厄。"
  },
  {
   "duration": 3.971,
   "para": 44,
   "start": 175.361,
   "text": "大圣北斗七元君。能解六害厄。"
  },
  {
   "duration": 3.265,
   "para": 45,
   "start": 179.332,
   "text": "大圣北斗七元君。能解七伤厄。"
  },
  {
   "duration": 3.683,
   "para": 46,
   "start": 182.597,
   "text": "大圣北斗七元君。能解八难厄。"
  },
  {
   "duration": 3.318,
   "para": 47,
   "start": 186.28,
   "text": "大圣北斗七元君。能解九星厄。"
  },
  {
   "duration": 3.866,
   "para": 48,
   "start": 189.598,
   "text": "大圣北斗七元君。能解夫妻厄。"
  },
  {
   "duration": 4.101,
   "para": 49,
   "start": 193.464,
   "text": "大圣北斗七元君。能解男女厄。"
  },
  {
   "duration": 3.631,
   "para": 50,
   "start": 197.565,
   "text": "大圣北斗七元君。能解产生厄。"
  },
  {
   "duration": 3.318,
   "para": 51,
   "start": 201.196,
   "text": "大圣北斗七元君。能解复连厄。"
  },
  {
   "duration": 3.318,
   "para": 52,
   "start": 204.514,
   "text": "大圣北斗七元君。能解疫疠厄。"
  },
  {
   "duration": 3.318,
   "para": 53,
   "start": 207.832,
   "text": "大圣北斗七元君。能解疾病厄。"
  },
  {
   "duration": 3.631,
   "para": 54,
   "start": 211.15,
   "text": "大圣北斗七元君。能解精邪厄。"
  },
  {
   "duration": 3.631,
   "para": 55,
   "start": 214.781,
   "text": "大圣北斗七元君。能解虎狼厄。"
  },
  {
   "duration": 4.336,
   "para": 56,
   "start": 218.412,
   "text": "大圣北斗七元君。能解虫蛇厄。"
  },
  {
   "duration": 3.318,
   "para": 57,
   "start": 222.748,
   "text": "大圣北斗七元君。能解劫贼厄。"
  },
  {
   "duration": 3.814,
   "para": 58,
   "start": 226.066,
   "text": "大圣北斗七元君。能解枷棒厄。"
  },
  {
   "duration": 3.553,
   "para": 59,
   "start": 229.88,
   "text": "大圣北斗七元君。能解横死厄。"
  },
  {
   "duration": 4.206,
   "para": 60,
   "start": 233.433,
   "text": "大圣北斗七元君。能解咒誓厄。"
  },
  {
   "duration": 4.154,
   "para": 61,
   "start": 237.639,
   "text": "大圣北斗七元君。能解天罗厄。"
  },
  {
   "duration": 3.5,
   "para": 62,
   "start": 241.793,
   "text": "大圣北斗七元君。能解地网厄。"
  },
  {
   "duration": 2.847,
   "para": 63,
   "start": 245.293,
   "text": "大圣北斗七元君。能解刀兵厄。"
  },
  {
   "duration": 3.605,
   "para": 64,
   "start": 248.14,
   "text": "大圣北斗七元君。能解水火厄。"
  },
  {
   "duration": 5.303,
   "para": 65,
   "start": 251.745,
   "text": "于是七元君。大圣善通灵。济度诸厄难。超出苦众生。"
  },
  {
   "duration": 5.773,
   "para": 66,
   "start": 257.048,
   "text": "若有急告者。持诵保安平。尽凭生百幅。咸契于五行。"
  },
  {
   "duration": 5.642,
   "para": 67,
   "start": 262.821,
   "text": "三魂得安健。邪魅不能停。五方降真气。万福自来骈。"
  },
  {
   "duration": 5.59,
   "para": 68,
   "start": 268.463,
   "text": "长生超八难。皆由奉七星。生生身自在。世世保神清。"
  },
  {
   "duration": 5.303,
   "para": 69,
   "start": 274.053,
   "text": "善似光中影。应如谷里声。三元神共护。万圣眼同明。"
  },
  {
   "duration": 3.553,
   "para": 70,
   "start": 279.356,
   "text": "无灾亦无障。永保道心宁。"
  },
  {
   "duration": 3.605,
   "para": 71,
   "start": 282.909,
   "text": "老君曰。北辰垂象。而众星拱之。"
  },
  {
   "duration": 4.232,
   "para": 72,
   "start": 286.514,
   "text": "为造化之枢机。作人神之主宰。"
  },
  {
   "duration": 2.482,
   "para": 73,
   "start": 290.746,
   "text": "宣威三界。统御万灵。"
  },
  {
   "duration": 3.135,
   "para": 74,
   "start": 293.228,
   "text": "判人间善恶之期。司阴府是非之目。"
  },
  {
   "duration": 3.213,
   "para": 75,
   "start": 296.363,
   "text": "五行共禀。七政同科。"
  },
  {
   "duration": 3.918,
   "para": 76,
   "start": 299.576,
   "text": "有回死注生之功。有消灾度厄之力。"
  },
  {
   "duration": 2.612,
   "para": 77,
   "start": 303.494,
   "text": "上至帝王。下及庶人。"
  },
  {
   "duration": 3.814,
   "para": 78,
   "start": 306.106,
   "text": "尊卑虽则殊途。命分俱无差别。"
  },
  {
   "duration": 5.904,
   "para": 79,
   "start": 309.92,
   "text": "凡夫在世迷谬者多。不知身属北斗。命由天府。"
  },
  {
   "duration": 2.9,
   "para": 80,
   "start": 315.824,
   "text": "有灾有患。不知解谢之门。"
  },
  {
   "duration": 2.9,
   "para": 81,
   "start": 318.724,
   "text": "祈福祈生。莫晓归依之路。"
  },
  {
   "duration": 2.952,
   "para": 82,
   "start": 321.624,
   "text": "致使魂神被系。祸患来缠。"
  },
  {
   "duration": 3.03,
   "para": 83,
   "start": 324.576,
   "text": "或重病不痊。或邪妖克害。"
  },
  {
   "duration": 5.355,
   "para": 84,
   "start": 327.606,
   "text": "连年困笃。累岁迍邅。冢讼征呼。先亡复连。"
  },
  {
   "duration": 4.754,
   "para": 85,
   "start": 332.961,
   "text": "或上天谴责。或下鬼诉诬。若以此危厄。如何救解。"
  },
  {
   "duration": 5.355,
   "para": 86,
   "start": 337.715,
   "text": "须投告北斗。醮谢真君。及转真经。认本命真君。"
  },
  {
   "duration": 4.937,
   "para": 87,
   "start": 343.07,
   "text": "方获安泰。已至康荣。更有深妙。不可尽述。"
  },
  {
   "duration": 3.37,
   "para": 88,
   "start": 348.007,
   "text": "凡见北斗真形。顶礼恭敬。"
  },
  {
   "duration": 2.847,
   "para": 89,
   "start": 351.377,
   "text": "北斗第一阳明贪狼太星君。"
  },
  {
   "duration": 2.717,
   "para": 90,
   "start": 354.224,
   "text": "北斗第二阴精巨门元星君。"
  },
  {
   "duration": 3.187,
   "para": 91,
   "start": 356.941,
   "text": "北斗第三真人禄存真星君。"
  },
  {
   "duration": 3.213,
   "para": 92,
   "start": 360.128,
   "text": "北斗第四玄冥文曲纽星君。"
  },
  {
   "duration": 3.03,
   "para": 93,
   "start": 363.341,
   "text": "北斗第五丹元帘贞网星君。"
  },
  {
   "duration": 2.56,
   "para": 94,
   "start": 366.371,
   "text": "北斗第六北极武曲纪星君。"
  },
  {
   "duration": 3.135,
   "para": 95,
   "start": 368.931,
   "text": "北斗第七天关破军关星君。"
  },
  {
   "duration": 2.847,
   "para": 96,
   "start": 372.066,
   "text": "北斗第八洞明外辅星君。"
  },
  {
   "duration": 2.717,
   "para": 97,
   "start": 374.913,
   "text": "北斗第九隐光内弼星君。"
  },
  {
   "duration": 2.116,
   "para": 98,
   "start": 377.63,
   "text": "上台虚精开德真君。"
  },
  {
   "duration": 2.612,
   "para": 99,
   "start": 379.746,
   "text": "中台六淳司空星君。"
  },
  {
   "duration": 2.064,
   "para": 100,
   "start": 382.358,
   "text": "下台曲生司禄星君。"
  },
  {
   "duration": 2.56,
   "para": 101,
   "start": 384.422,
   "text": "如是真君名号不可得闻。"
  },
  {
   "duration": 6.008,
   "para": 102,
   "start": 386.982,
   "text": "凡有见闻。能持念者。皆道心深重。宿有善缘。"
  },
  {
   "duration": 6.113,
   "para": 103,
   "start": 392.99,
   "text": "得闻持诵。其功德力莫可称量。若正信男女值此真经。"
  },
  {
   "duration": 4.284,
   "para": 104,
   "start": 399.103,
   "text": "智慧性圆。道心开发。出群迷迳。入希夷门。"
  },
  {
   "duration": 4.65,
   "para": 105,
   "start": 403.387,
   "text": "归奉真宗。达生荣界。于三元八节。本命生辰。"
  },
  {
   "duration": 5.407,
   "para": 106,
   "start": 408.037,
   "text": "北斗下日。严置坛场。转经斋醮。依仪行道。"
  },
  {
   "duration": 4.937,
   "para": 107,
   "start": 413.444,
   "text": "其福无边。世世生生。不违真性。不入邪见。"
  },
  {
   "duration": 3.135,
   "para": 108,
   "start": 418.381,
   "text": "持经之人。常持诵七元真君所属尊号。"
  },
  {
   "duration": 2.717,
   "para": 109,
   "start": 421.516,
   "text": "善功圆满。亦降吉祥。"
  },
  {
   "duration": 1.776,
   "para": 110,
   "start": 424.233,
   "text": "即说北斗咒曰。"
  },
  {
   "duration": 6.06,
   "para": 111,
   "start": 426.009,
   "text": "北斗九辰。中天大神。上朝金阙。下覆昆仑。"
  },
  {
   "duration": 5.407,
   "para": 112,
   "start": 432.069,
   "text": "调理纲纪。统制乾坤。大魁贪狼。巨门禄存。"
  },
  {
   "duration": 5.407,
   "para": 113,
   "start": 437.476,
   "text": "文曲廉贞。武曲破军。高上玉皇。紫微帝君。"
  },
  {
   "duration": 5.172,
   "para": 114,
   "start": 442.883,
   "text": "大周天界。细入微尘。何灾不灭。何福不臻。"
  },
  {
   "duration": 5.068,
   "para": 115,
   "start": 448.055,
   "text": "元皇正气。来合我身。天罡所指。昼夜常轮。"
  },
  {
   "duration": 5.956,
   "para": 116,
   "start": 453.123,
   "text": "俗居小人。好道求灵。愿见尊仪。永保长生。"
  },
  {
   "duration": 5.172,
   "para": 117,
   "start": 459.079,
   "text": "三台虚精。六淳曲生。生我养我。护我身形。"
  },
  {
   "duration": 4.807,
   "para": 118,
   "start": 464.251,
   "text": "魁（秘）（秘）䰢魓（秘）魒尊帝。急急如律令。"
  },
  {
   "duration": 1.28,
   "para": 119,
   "start": 469.058,
   "text": "老君曰。"
  },
  {
   "duration": 4.232,
   "para": 120,
   "start": 470.338,
   "text": "凡人性命五体。悉属本命星官之所主掌。"
  },
  {
   "duration": 3.971,
   "para": 121,
   "start": 474.57,
   "text": "本命神将。本宿星官。常垂荫佑。"
  },
  {
   "duration": 4.441,
   "para": 122,
   "start": 478.541,
   "text": "主持人命。使保天年。凡俗无知。终身不悟。"
  },
  {
   "duration": 6.06,
   "para": 123,
   "start": 482.982,
   "text": "夫本命真君。每岁六度降在人间。降日为本命限期，"
  },
  {
   "duration": 4.284,
   "para": 124,
   "start": 489.042,
   "text": "有南陵使者三千人。北斗真君七千神将。"
  },
  {
   "duration": 4.206,
   "para": 125,
   "start": 493.326,
   "text": "本命真官降驾。众真悉来拥护。"
  },
  {
   "duration": 5.277,
   "para": 126,
   "start": 497.532,
   "text": "可以消灾忏罪。请福延生。随力章醮。福德增崇。"
  },
  {
   "duration": 4.702,
   "para": 127,
   "start": 502.809,
   "text": "其有本命限期将至。自身不知。不设斋醮。不修香火。"
  },
  {
   "duration": 1.776,
   "para": 128,
   "start": 507.511,
   "text": "此为轻生迷本。"
  },
  {
   "duration": 6.295,
   "para": 129,
   "start": 509.287,
   "text": "不贵人身。天司夺禄减算除年。多致夭丧。迷误之者。"
  },
  {
   "duration": 5.042,
   "para": 130,
   "start": 515.582,
   "text": "虽遇经诀。怀不信心。毁谤真文。如此之人。"
  },
  {
   "duration": 5.642,
   "para": 131,
   "start": 520.624,
   "text": "身谢之后。沦没三涂。漂沉诸趣。永失人身。"
  },
  {
   "duration": 4.336,
   "para": 132,
   "start": 526.266,
   "text": "深可悲哀。自致斯苦。若本命之日。能修斋醮。"
  },
  {
   "duration": 5.538,
   "para": 133,
   "start": 530.602,
   "text": "善达天司。一时于本命限期间。开转真经。"
  },
  {
   "duration": 4.389,
   "para": 134,
   "start": 536.14,
   "text": "广陈供养。使三生常为男子身。富贵聪明。"
  },
  {
   "duration": 4.519,
   "para": 135,
   "start": 540.529,
   "text": "人中殊胜。其有生身果薄。虽在人中。"
  },
  {
   "duration": 5.224,
   "para": 136,
   "start": 545.048,
   "text": "贫穷下贱。纵知本命无力修崇。能酌水献花。"
  },
  {
   "duration": 4.702,
   "para": 137,
   "start": 550.272,
   "text": "冥心望北极。稽首礼拜。念本命星君名号者。"
  },
  {
   "duration": 5.042,
   "para": 138,
   "start": 554.974,
   "text": "亦不虚过本命限期。皆得延生注福。系系人身。"
  },
  {
   "duration": 5.59,
   "para": 139,
   "start": 560.016,
   "text": "灾厄蠲除。获福无量。天师欢喜。踊跃作礼。"
  },
  {
   "duration": 2.952,
   "para": 140,
   "start": 565.606,
   "text": "赞叹难可得遇无上法桥。"
  },
  {
   "duration": 5.277,
   "para": 141,
   "start": 568.558,
   "text": "老君重告天师曰。世人罪福善恶皆属天司。"
  },
  {
   "duration": 5.042,
   "para": 142,
   "start": 573.835,
   "text": "忏罪消灾莫越修奉。遇本命生辰。告身中元辰驿马。"
  },
  {
   "duration": 3.553,
   "para": 143,
   "start": 578.877,
   "text": "削落三灾九厄。保现今眷属安宁。"
  },
  {
   "duration": 4.519,
   "para": 144,
   "start": 582.43,
   "text": "凡有上士于本命生辰。持此真文者。外伏魔精。"
  },
  {
   "duration": 5.59,
   "para": 145,
   "start": 586.949,
   "text": "内安真性。功沾水陆。善及存亡。悔过虔恭。"
  },
  {
   "duration": 5.59,
   "para": 146,
   "start": 592.539,
   "text": "渐登妙果。重立玄功。证虚无道。乃得圣智圆通。"
  },
  {
   "duration": 5.721,
   "para": 147,
   "start": 598.129,
   "text": "隐显莫测。出有入无。逍遥云际。升入金门。"
  },
  {
   "duration": 5.277,
   "para": 148,
   "start": 603.85,
   "text": "与圣合真。身超三界。永不轮转。寿量无穷。"
  },
  {
   "duration": 4.571,
   "para": 149,
   "start": 609.127,
   "text": "快乐自在。凡有男女。于本命生辰。及诸斋日。"
  },
  {
   "duration": 4.702,
   "para": 150,
   "start": 613.698,
   "text": "清静身心。焚香持此真文。自认北极本命所属星君。"
  },
  {
   "duration": 5.878,
   "para": 151,
   "start": 618.4,
   "text": "随心祷祝。善无不应。灾罪消除。致感万圣千真。"
  },
  {
   "duration": 5.773,
   "para": 152,
   "start": 624.278,
   "text": "俱来卫护。此文所在之处。千真敬礼。万圣护持。"
  },
  {
   "duration": 6.008,
   "para": 153,
   "start": 630.051,
   "text": "魔鬼潜消。精灵伏匿。世有灾殃。悉皆消灭。"
  },
  {
   "duration": 3.553,
   "para": 154,
   "start": 636.059,
   "text": "是名北斗本命延生经诀。乃修真之迳路。"
  },
  {
   "duration": 4.519,
   "para": 155,
   "start": 639.612,
   "text": "得道逍遥皆因此经。证圣成真皆因此经。"
  },
  {
   "duration": 4.101,
   "para": 156,
   "start": 644.131,
   "text": "出离生死皆因此经。保护男女皆因此经。"
  },
  {
   "duration": 4.754,
   "para": 157,
   "start": 648.232,
   "text": "保命延生皆得自在。永为身宝。福寿可称。"
  },
  {
   "duration": 2.664,
   "para": 158,
   "start": 652.986,
   "text": "保而敬之。非人勿示。"
  },
  {
   "duration": 4.807,
   "para": 159,
   "start": 655.65,
   "text": "老君说经将毕。龙鹤天仙来迎。还于玉京。"
  },
  {
   "duration": 4.989,
   "para": 160,
   "start": 660.457,
   "text": "是时天师受得妙法。而作是言。誓愿流行。"
  },
  {
   "duration": 3.318,
   "para": 161,
   "start": 665.446,
   "text": "以传善士。若有男女受持读诵。"
  },
  {
   "duration": 3.448,
   "para": 162,
   "start": 668.764,
   "text": "我当与十戒仙官所在拥护。于是再拜"
  },
  {
   "duration": 1.724,
   "para": 163,
   "start": 672.212,
   "text": "老君而说赞曰。"
  },
  {
   "duration": 3.082,
   "para": 164,
   "start": 673.936,
   "text": "家有北斗经。本命降真灵。"
  },
  {
   "duration": 2.9,
   "para": 165,
   "start": 677.018,
   "text": "家有北斗经。宅舍得安宁。"
  },
  {
   "duration": 3.5,
   "para": 166,
   "start": 679.918,
   "text": "家有北斗经。父母保长生。"
  },
  {
   "duration": 2.769,
   "para": 167,
   "start": 683.418,
   "text": "家有北斗经。诸厌化为尘。"
  },
  {
   "duration": 3.553,
   "para": 168,
   "start": 686.187,
   "text": "家有北斗经。万邪自归正。"
  },
  {
   "duration": 3.082,
   "para": 169,
   "start": 689.74,
   "text": "家有北斗经。营业得称情。"
  },
  {
   "duration": 3.788,
   "para": 170,
   "start": 692.822,
   "text": "家有北斗经。阖门自康健。"
  },
  {
   "duration": 3.396,
   "para": 171,
   "start": 696.61,
   "text": "家有北斗经。子孙保荣盛。"
  },
  {
   "duration": 2.612,
   "para": 172,
   "start": 700.006,
   "text": "家有北斗经。五路自通达。"
  },
  {
   "duration": 4.336,
   "para": 173,
   "start": 702.618,
   "text": "家有北斗经。众恶永消灭。"
  },
  {
   "duration": 3.605,
   "para": 174,
   "start": 706.954,
   "text": "家有北斗经。六畜保兴生。"
  },
  {
   "duration": 2.482,
   "para": 175,
   "start": 710.559,
   "text": "家有北斗经。疾病得痊愈。"
  },
  {
   "duration": 3.37,
   "para": 176,
   "start": 713.041,
   "text": "家有北斗经。财物不虚耗。"
  },
  {
   "duration": 2.534,
   "para": 177,
   "start": 716.411,
   "text": "家有北斗经。横事永不起。"
  },
  {
   "duration": 3.631,
   "para": 178,
   "start": 718.945,
   "text": "家有北斗经。长保亨利贞。"
  },
  {
   "duration": 3.971,
   "para": 179,
   "start": 722.576,
   "text": "老君曰。善哉善哉。汝可宣扬正教。"
  },
  {
   "duration": 3.213,
   "para": 180,
   "start": 726.547,
   "text": "福利无边。普及众生。永沾胜善。"
  },
  {
   "duration": 3.631,
   "para": 181,
   "start": 729.76,
   "text": "天师稽首礼谢。信受奉行。"
  }
 ],
 "sid": "s04",
 "total_duration": 733.391,
 "voice": "female"
}
