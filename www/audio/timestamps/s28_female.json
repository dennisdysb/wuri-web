{
 "segments": [
  {
   "duration": 1.776,
   "para": 0,
   "start": 0.0,
   "text": "临水夫人宝诰"
  },
  {
   "duration": 1.724,
   "para": 1,
   "start": 1.776,
   "text": "志心皈命礼。"
  },
  {
   "duration": 2.377,
   "para": 2,
   "start": 3.5,
   "text": "八閩毓秀，大士化身。"
  },
  {
   "duration": 3.03,
   "para": 3,
   "start": 5.877,
   "text": "少悟玄极，顶礼慈航宝相；"
  },
  {
   "duration": 3.396,
   "para": 4,
   "start": 8.907,
   "text": "长成道果，拜参法主朱门。"
  },
  {
   "duration": 3.187,
   "para": 5,
   "start": 12.303,
   "text": "龙角轻吹，声彻九天响应；"
  },
  {
   "duration": 2.612,
   "para": 6,
   "start": 15.49,
   "text": "风旗高展，威传十地安宁。"
  },
  {
   "duration": 3.082,
   "para": 7,
   "start": 18.102,
   "text": "锁蛇怪于坛中，群妖扫荡；"
  },
  {
   "duration": 3.605,
   "para": 8,
   "start": 21.184,
   "text": "保童婴于闈中，众妇蒙恩。"
  },
  {
   "duration": 3.605,
   "para": 9,
   "start": 24.789,
   "text": "法转玄功，炼度三十六宫毓麟婆者；"
  },
  {
   "duration": 3.5,
   "para": 10,
   "start": 28.394,
   "text": "丹生白骨，超拔七十二苑解疫女神。"
  },
  {
   "duration": 2.429,
   "para": 11,
   "start": 31.894,
   "text": "合三奶以同心，功存社稷；"
  },
  {
   "duration": 2.9,
   "para": 12,
   "start": 34.323,
   "text": "会九淑而崇道，泽注尘环。"
  },
  {
   "duration": 2.717,
   "para": 13,
   "start": 37.223,
   "text": "护法随传，召遣王杨太保；"
  },
  {
   "duration": 4.389,
   "para": 14,
   "start": 39.94,
   "text": "灵心默化，度收大圣丹霞。"
  },
  {
   "duration": 2.299,
   "para": 15,
   "start": 44.329,
   "text": "救世拯民，祈甘露于左海；"
  },
  {
   "duration": 2.847,
   "para": 16,
   "start": 46.628,
   "text": "勤王护国，除巨恶于三山。"
  },
  {
   "duration": 2.9,
   "para": 17,
   "start": 49.475,
   "text": "懿德高超，玉诏荣封圣母；"
  },
  {
   "duration": 3.135,
   "para": 18,
   "start": 52.375,
   "text": "慈云广覆，金炉拜参元君。"
  },
  {
   "duration": 2.612,
   "para": 19,
   "start": 55.51,
   "text": "大悲大愿，大圣大慈。"
  },
  {
   "duration": 6.949,
   "para": 20,
   "start": 58.122,
   "text": "顺天圣母，临水清宁，普化碧霞太后，保童注生，昭惠崇福救世元君。"
  }
 ],
 "sid": "s28",
